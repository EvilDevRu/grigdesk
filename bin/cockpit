#!/usr/bin/env bash
# Запуск кокпита локально (host-native, без systemd).
#
#   bin/cockpit            собрать web и запустить сервер (прод-режим, один origin)
#   bin/cockpit dev        dev-режим: vite (:5180) + сервер с автоперезапуском
#   bin/cockpit build      собрать web и встроенный DeepSeek
#   bin/cockpit deps       подготовить зависимости и встроенный DeepSeek
#
# Переменные окружения (опционально): COCKPIT_PORT, COCKPIT_MEDIA_PYTHON и т.д. (см. server/src/config.js).
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CMD="${1:-run}"

# node обязателен и должен быть в PATH (в «голом» шелле nvm-node может быть не подхвачен).
if ! command -v node >/dev/null 2>&1; then
  echo "✗ node не найден в PATH. Загрузи nvm (напр. 'nvm use') или укажи node вручную." >&2
  exit 1
fi

# Корневой .env читаем штатным парсером Node, не исполняя его как shell-код.
# Экспортированное окружение имеет приоритет. Те же аргументы передаём серверу.
source "$DIR/bin/lib/runtime-env.sh"
cockpit_add_cli_paths
cockpit_load_runtime_env "$DIR"
PORT="$COCKPIT_EFFECTIVE_PORT"
ENV_ARG=("${COCKPIT_NODE_ENV_ARGS[@]}")

# Занят ли порт (сервер уже запущен другим процессом/вкладкой).
port_busy() { command -v ss >/dev/null 2>&1 && ss -ltn 2>/dev/null | grep -q "[:.]${PORT}[[:space:]]"; }

# Встроенный DeepSeek — один из исполнителей: сбой его подготовки (нет сети, компилятора,
# прерванная сборка) не мешает запуску Cockpit; карточка DeepSeek покажет недоступность.
prepare_deepseek() {
  ( cd "$DIR/server" && npm run --silent deepseek:prepare ) || {
    echo "⚠ DeepSeek не подготовлен; Cockpit работает без него. Повтор: bin/cockpit deps" >&2
  }
}

ensure_deps() {
  [ -d "$DIR/server/node_modules" ] || ( echo "→ npm i (server)"; cd "$DIR/server" && npm install --no-audit --no-fund )
  [ -d "$DIR/web/node_modules" ]    || ( echo "→ npm i (web)";    cd "$DIR/web"    && npm install --no-audit --no-fund )
  prepare_deepseek
}

build_web() { echo "→ Сборка web…"; ( cd "$DIR/web" && npm run build ); }

case "$CMD" in
  deps)
    cd "$DIR/server" && npm install --no-audit --no-fund
    cd "$DIR/web"    && npm install --no-audit --no-fund
    prepare_deepseek
    ;;
  build)
    ensure_deps; build_web
    ;;
  dev)
    ensure_deps
    echo "→ Dev: vite :5180 + сервер (--watch) :$PORT"
    ( cd "$DIR/web" && npm run dev ) &
    VITE_PID=$!
    trap 'kill "$VITE_PID" 2>/dev/null || true' EXIT INT TERM
    cd "$DIR/server" && NODE_ENV=development node "${ENV_ARG[@]}" --watch src/app.ts
    ;;
  run|"")
    if port_busy; then
      echo "→ Кокпит уже слушает :$PORT — открой http://localhost:$PORT"
      echo "  (чтобы перезапустить — сначала останови процесс на этом порту)"
      exit 0
    fi
    ensure_deps; build_web
    echo "→ Сервер поднят: http://localhost:$PORT (только с этой машины)"
    cd "$DIR/server" && exec node "${ENV_ARG[@]}" src/app.ts
    ;;
  *)
    echo "Неизвестная команда: $CMD"; echo "Смотри: bin/cockpit (без аргументов) / dev / build / deps"; exit 1
    ;;
esac
