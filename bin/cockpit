#!/usr/bin/env bash
# Запуск кокпита локально (host-native, без systemd).
#
#   bin/cockpit            собрать web и запустить сервер (прод-режим, один origin :8140)
#   bin/cockpit dev        dev-режим: vite (:5180) + сервер с автоперезапуском
#   bin/cockpit build      только собрать web
#   bin/cockpit deps       установить зависимости server + web
#
# Переменные окружения (опционально): COCKPIT_PORT, COCKPIT_MEDIA_PYTHON и т.д. (см. server/src/config.js).
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CMD="${1:-run}"
PORT="${COCKPIT_PORT:-8140}"

# Корневой .env (если есть) грузим в сервер через нативный --env-file Node (≥20.6).
ENV_ARG=()
[ -f "$DIR/.env" ] && ENV_ARG=(--env-file "$DIR/.env")

# node обязателен и должен быть в PATH (в «голом» шелле nvm-node может быть не подхвачен).
if ! command -v node >/dev/null 2>&1; then
  echo "✗ node не найден в PATH. Загрузи nvm (напр. 'nvm use') или укажи node вручную." >&2
  exit 1
fi

# Занят ли порт (сервер уже запущен другим процессом/вкладкой).
port_busy() { command -v ss >/dev/null 2>&1 && ss -ltn 2>/dev/null | grep -q "[:.]${PORT}[[:space:]]"; }

ensure_deps() {
  [ -d "$DIR/server/node_modules" ] || ( echo "→ npm i (server)"; cd "$DIR/server" && npm install --no-audit --no-fund )
  [ -d "$DIR/web/node_modules" ]    || ( echo "→ npm i (web)";    cd "$DIR/web"    && npm install --no-audit --no-fund )
}

build_web() { echo "→ Сборка web…"; ( cd "$DIR/web" && npm run build ); }

case "$CMD" in
  deps)
    cd "$DIR/server" && npm install --no-audit --no-fund
    cd "$DIR/web"    && npm install --no-audit --no-fund
    ;;
  build)
    ensure_deps; build_web
    ;;
  dev)
    ensure_deps
    echo "→ Dev: vite :5180 + сервер (--watch) :8140"
    ( cd "$DIR/web" && npm run dev ) &
    VITE_PID=$!
    trap 'kill "$VITE_PID" 2>/dev/null || true' EXIT INT TERM
    cd "$DIR/server" && NODE_ENV=development node "${ENV_ARG[@]}" --watch src/app.js
    ;;
  run|"")
    if port_busy; then
      echo "→ Кокпит уже слушает :$PORT — открой http://localhost:$PORT"
      echo "  (чтобы перезапустить — сначала останови процесс на этом порту)"
      exit 0
    fi
    ensure_deps; build_web
    # С планшета — по https: без него нет PWA (secure context), а http из сети сам уводит
    # редиректом на защищённый порт. Сертификат — «Настройки → Доступ → Локальный HTTPS».
    echo "→ Сервер поднят: http://localhost:$PORT  (с планшета — https://<адрес мозга>:${COCKPIT_TLS_PORT:-8143})"
    cd "$DIR/server" && exec node "${ENV_ARG[@]}" src/app.js
    ;;
  *)
    echo "Неизвестная команда: $CMD"; echo "Смотри: bin/cockpit (без аргументов) / dev / build / deps"; exit 1
    ;;
esac
