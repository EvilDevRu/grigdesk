#!/usr/bin/env bash
# Офлайн-поиск по локальной базе знаний: без сети и без запущенного Cockpit.
set -uo pipefail

_self="$(readlink -f "$0")"
_root="$(cd "$(dirname "$_self")/.." && pwd)"
source "$_root/bin/lib/runtime-env.sh"
cockpit_load_runtime_env "$_root" || exit 2
exec node "${COCKPIT_NODE_ENV_ARGS[@]}" "${COCKPIT_NODE_TS_ARGS[@]}" \
  "$_root/server/src/lib/search/cli.ts" "$@"
