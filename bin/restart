#!/usr/bin/env bash
# Перезапуск сервера кокпита без конфликтов порта (EADDRINUSE):
# гасим все процессы на портах, ЖДЁМ освобождения, только потом стартуем новый.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LOG="${COCKPIT_LOG:-$ROOT/server/.state/cockpit-server.log}"

# node нужен и серверу, и безопасному чтению корневого .env.
if ! command -v node >/dev/null 2>&1; then
  echo "node не найден в PATH" >&2
  exit 1
fi

# Машинные настройки — из корневого .env, как у bin/cockpit и systemd-юнита. Раньше путь к
# venv распознавания был прописан прямо здесь, и работа диктовки зависела от способа запуска:
# поднятый этим скриптом кокпит распознавал, поднятый systemd падал со spawn ... ENOENT.
source "$ROOT/bin/lib/runtime-env.sh"
cockpit_add_cli_paths
cockpit_load_runtime_env "$ROOT"
PORT="$COCKPIT_EFFECTIVE_PORT"
# Второй сокет (локальный HTTPS). Ждать его тоже обязательно: сокеты закрываются не
# одновременно, и новый процесс может стартовать, пока старый ещё держит этот порт.
TLS_PORT="$COCKPIT_EFFECTIVE_TLS_PORT"
ENV_ARG=("${COCKPIT_NODE_ENV_ARGS[@]}")

# Отказ probe не является поводом гасить Cockpit: в такой среде degraded
# будет только knowledge search. DatabaseSync остаётся в этом коротком subprocess.
node --disable-warning=ExperimentalWarning \
  "$ROOT/server/scripts/knowledge-search-preflight.mjs" || true

listening() { ss -tln 2>/dev/null | grep -q ":$1 "; }
busy() { listening "$PORT" || listening "$TLS_PORT"; }

# Все PID'ы, слушающие наши порты (может быть и зомби от прошлых конфликтов)
pids=$(ss -tlnp 2>/dev/null | grep -E ":($PORT|$TLS_PORT) " | grep -oP 'pid=\K[0-9]+' | sort -u || true)
if [ -n "$pids" ]; then
  echo "гашу: $pids"
  kill $pids 2>/dev/null || true
  for _ in $(seq 1 50); do busy || break; sleep 0.2; done
  if busy; then
    echo "порт не освободился — kill -9"
    kill -9 $pids 2>/dev/null || true
    for _ in $(seq 1 25); do busy || break; sleep 0.2; done
  fi
fi
if busy; then
  listening "$PORT" && echo "порт :$PORT всё ещё занят — не стартую" >&2
  listening "$TLS_PORT" && echo "порт :$TLS_PORT всё ещё занят — не стартую" >&2
  exit 1
fi

mkdir -p "$(dirname "$LOG")"
cd "$ROOT"
setsid nohup node "${ENV_ARG[@]}" server/src/app.js </dev/null >>"$LOG" 2>&1 &
disown

# Живость проверяем по /api/auth/state: он публичный (нужен экрану входа), а /api/health
# закрыт гардом авторизации — по нему скрипт всегда решал бы, что сервер не поднялся.
for _ in $(seq 1 50); do
  if curl -sf "http://localhost:$PORT/api/auth/state" >/dev/null 2>&1; then
    echo "кокпит поднят на :$PORT · лог: $LOG"
    exit 0
  fi
  sleep 0.2
done
echo "сервер не поднялся за 10с — смотри $LOG" >&2
exit 1
