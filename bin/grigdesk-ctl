#!/usr/bin/env bash
# Единая команда GrigDesk: окно, статус и управление компонентами.
# Прежние команды разработки выполняются своим кодом без обращения к новому CLI.
set -euo pipefail

SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
DIR="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
CMD="${1:-help}"

# Справка и ошибки bundle обрабатываются до Node и подготовки установленного ELF.
# Сборщик работает только с исходниками и не использует ветвь build с установкой.
if [[ "$CMD" == bundle ]]; then
  for argument in "${@:2}"; do
    if [[ "$argument" == --help || "$argument" == -h ]]; then
      echo 'grigdesk-ctl bundle — собрать переносимую папку release/ и release.tar.gz из исходников'
      exit 0
    fi
  done

  if (( $# > 1 )); then
    echo 'Справка: grigdesk-ctl bundle [--help]' >&2
    exit 2
  fi

  if [[ -f "$DIR/release.json" || ! -f "$DIR/server/src/app.ts" \
    || ! -f "$DIR/web/package.json" || ! -f "$DIR/desktop/package.json" ]]; then
    echo 'Команда bundle доступна только в папке исходников.' >&2
    exit 1
  fi

  exec node "$DIR/tools/bundle.mts"
fi

# Явные команды разработки распознают checkout независимо от установленного ELF.
# release.json сохраняет приоритет готовой поставки даже при случайных исходниках рядом.
SOURCE_COMMAND=0
if [[ ! -f "$DIR/release.json" && -f "$DIR/server/src/app.ts" \
  && -f "$DIR/web/package.json" && -f "$DIR/desktop/package.json" ]]; then
  case "$CMD" in
    dev|build|deps|mobile|release) SOURCE_COMMAND=1 ;;
  esac
fi

# Пустой человеческий TTY использует source CLI лишь при пригодном Node.
# Без него установленный ELF показывает справку своим автономным Node.
if (( $# == 0 )) && [[ -t 0 && -t 1 && ! -f "$DIR/release.json" \
  && ! -f "$DIR/bin/bundle.json" && -f "$DIR/server/src/app.ts" \
  && -f "$DIR/web/package.json" && -f "$DIR/desktop/package.json" ]]; then
  if (
    source "$DIR/deploy/lib/runtime-env.sh"
    grigdesk_require_node source
  ) >/dev/null 2>&1; then
    exec node "$DIR/cli/main.ts"
  fi

  export GRIGDESK_CTL_SOURCE_FALLBACK=1
fi

# Без терминала или пригодного source Node пустой вызов явно просит справку.
# Это исключает открытие окна даже через helper ранее установленного ELF.
if (( $# == 0 )) && [[ ! -t 0 || ! -t 1 || "${GRIGDESK_CTL_SOURCE_FALLBACK:-}" == 1 ]]; then
  set -- --help
fi

# Внешний ELF сам читает раннее окружение и запускает сервер своим Node.
# Для CLI удерживаем preparation до завершения собранного helper-а, затем освобождаем.
if [[ "$SOURCE_COMMAND" == 0 && ( -e "$DIR/bin/grigdesk-server" || -L "$DIR/bin/grigdesk-server" ) ]]; then
  PORTABLE=0
  if [[ -f "$DIR/bin/bundle.json" ]]; then
    PORTABLE=1
    source "$DIR/bin/lib/runtime-env.sh"
  else
    source "$DIR/deploy/lib/runtime-env.sh"
  fi
  grigdesk_select_server_binary "$DIR"
  trap 'grigdesk_release_binary_preparation' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  case "$CMD" in
    run)
      cd "$DIR"
      exec "$_grigdesk_server_binary" "${@:2}"
      ;;
    b24)
      [[ -f "$DIR/bin/b24" && -x "$DIR/bin/b24" ]] || {
        echo 'Установите отдельный ELF b24 в bin этой установки.' >&2
        exit 1
      }
      exec "$DIR/bin/b24" "${@:2}"
      ;;
    desktop)
      if [[ "$PORTABLE" == 1 ]]; then
        if [[ "${2:-}" != use-server || $# != 3 ]]; then
          echo 'Переносимый комплект: desktop use-server <ELF>. Установка окна требует исходников.' >&2
          exit 2
        fi

        grigdesk_require_node
        grigdesk_node "$_grigdesk_binary_root/server/runtime/helpers/select-sea-server.mjs" \
          --portable "$3"
        exit $?
      fi

      exec "$DIR/deploy/desktop.sh" "${@:2}"
      ;;
    dev|build|deps|mobile|release)
      help=0
      for argument in "${@:2}"; do
        [[ "$argument" != --help && "$argument" != -h ]] || help=1
      done
      if [[ "$help" == 0 ]]; then
        echo "Команда $CMD доступна в установке из исходников." >&2
        exit 1
      fi
      set -- --help
      ;;
  esac

  grigdesk_require_node
  grigdesk_node "$_grigdesk_binary_root/server/runtime/helpers/grigdesk-cli.mjs" "$@"
  exit $?
fi

# Готовая поставка запускает собранный CLI своим Node и не ищет исходники.
# Явные команды разработки требуют checkout, готовые b24/окно сохраняют свои входы.
if [[ -f "$DIR/release.json" ]]; then
  source "$DIR/deploy/lib/runtime-env.sh"
  grigdesk_require_node

  case "$CMD" in
    b24)
      shift

      if [[ ! -x "$DIR/bin/b24" ]]; then
        echo "Повреждён комплект: нет bin/b24" >&2
        exit 1
      fi

      exec "$DIR/bin/b24" "$@"
      ;;
    desktop)
      shift
      exec "$DIR/deploy/desktop.sh" "$@"
      ;;
    run)
      exec "$DIR/runtime/node/bin/node" \
        "$DIR/server/runtime/helpers/launch-sea-server.mjs" "${@:2}"
      ;;
    dev|build|deps|mobile|release)
      for argument in "${@:2}"; do
        if [[ "$argument" == --help || "$argument" == -h ]]; then
          exec "$DIR/runtime/node/bin/node" "$DIR/server/runtime/helpers/grigdesk-cli.mjs" --help
        fi
      done

      echo "Команда $CMD доступна в установке из исходников." >&2
      exit 1
      ;;
    *)
      exec "$DIR/runtime/node/bin/node" "$DIR/server/runtime/helpers/grigdesk-cli.mjs" "$@"
      ;;
  esac
fi

# Сохраняет прежний запуск разработчика, включая подготовку зависимостей и сборку.
# Этот путь вызывается только явными dev/build/deps/run и не участвует в обычном открытии.
developer_command() {
  local build_target=${1-all}

  if [[ "$CMD" == build ]]; then
    if (( $# > 1 )) || [[ "$build_target" != all && "$build_target" != server \
      && "$build_target" != web && "$build_target" != window ]]; then
      echo 'Справка: grigdesk-ctl build [all|server|web|window]' >&2
      return 2
    fi
  fi

  # node обязателен и должен быть в PATH (в «голом» шелле nvm-node может быть не подхвачен).
  if ! command -v node >/dev/null 2>&1; then
    echo "✗ node не найден в PATH. Загрузи nvm (напр. 'nvm use') или укажи node вручную." >&2
    exit 1
  fi

  # Файл .env папки данных читаем штатным парсером Node, не исполняя его как shell-код.
  # Экспортированное окружение имеет приоритет. Те же аргументы передаём серверу.
  source "$DIR/deploy/lib/runtime-env.sh"
  grigdesk_add_cli_paths
  grigdesk_require_node source
  if [[ "$CMD" == dev || "$CMD" == run ]]; then
    grigdesk_require_migrated "$DIR" source
    grigdesk_load_runtime_env "$DIR" source
    PORT="$GRIGDESK_EFFECTIVE_PORT"
    ENV_ARG=("${GRIGDESK_NODE_ENV_ARGS[@]}")
  fi

  # Проверяет, занят ли порт прежнего ручного запуска сервера.
  # Отсутствие ss трактуется как отсутствие слушателя, как и до переноса ветки.
  port_busy() {
    command -v ss >/dev/null 2>&1 && ss -ltn 2>/dev/null | grep -q "[:.]${PORT}[[:space:]]"
  }

  # Независимый DeepSeek проверяется без сборки, установки и изменения его homes.
  # Отказ optional исполнителя не мешает запуску GrigDesk; карточка покажет причину.
  prepare_deepseek() {
    ( cd "$DIR/server" && npm run --silent deepseek:prepare ) || {
      echo "⚠ DeepSeek недоступен; GrigDesk работает без него. Установите совместимый ELF через install:binary" >&2
    }
  }

  # Зависимости подготавливаются только для явного запуска разработчика.
  # Отказ встроенного исполнителя сохраняет прежнее предупреждение и не мешает серверу.
  ensure_deps() {
    [ -d "$DIR/server/node_modules" ] || (
      echo "→ npm i (server)"
      cd "$DIR/server"
      npm install --no-audit --no-fund
    ) || return $?
    [ -d "$DIR/web/node_modules" ] || (
      echo "→ npm i (web)"
      cd "$DIR/web"
      npm install --no-audit --no-fund
    ) || return $?

    prepare_deepseek
  }

  # Прежняя сборка выполняется в отдельной рабочей папке web.
  # Вход open/status эту функцию не вызывает.
  build_web() {
    echo "→ Сборка web…"
    (
      cd "$DIR/web"
      npm run build
    )
  }

  # Сборщик публикует кандидата в кэше; штатный установщик проверяет его и сохраняет резерв.
  # Папка данных вычисляется общим контрактом, descriptor окна здесь не меняется.
  build_server() {
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}/grigdesk/server-binary"
    local data
    local -a executor_args=()

    if [[ -n "${GRIGDESK_DEEPSEEK_BIN:-}" ]]; then
      executor_args=(--deepseek-binary "$GRIGDESK_DEEPSEEK_BIN")
    fi

    data=$(grigdesk_data_home) || return $?
    observed_step server.node node "$DIR/server/scripts/ctlBuild.mts" \
      prepare-runtime "$cache/cache" || return $?
    observed_step server.build npm --prefix "$DIR/server" run build:binary -- \
      --out-dir "$cache/out" --cache-dir "$cache/cache" || return $?
    observed_step server.install npm --prefix "$DIR/server" run install:binary -- \
      --binary "$cache/out/grigdesk-server" --target "$DIR/bin/grigdesk-server" \
      --releases-dir "$data/runtimes/server/releases" "${executor_args[@]}" || return $?

    if [[ "$build_target" != all ]] \
      && ! node "$DIR/server/scripts/ctlBuild.mts" check-desktop "$DIR/bin/grigdesk-server"; then
      desktop_requires_selection=1
      build_event hint select-server
      printf 'Для выбора этого сервера окном: grigdesk-ctl desktop use-server %q\n' \
        "$DIR/bin/grigdesk-server"
    fi
  }

  # Упаковка берёт уже собранный web/dist, поэтому вызывающая цепочка готовит веб первой.
  # Установка заменяет файл окна, не запуская приложение и не меняя выбор сервера.
  build_window() {
    observed_step window.package npm --prefix "$DIR/desktop" run dist || return $?

    if [[ "$build_target" == all ]]; then
      observed_step window.install "$DIR/deploy/desktop.sh" install --keep-runtime || return $?
    else
      observed_step window.install "$DIR/deploy/desktop.sh" install || return $?
    fi
  }

  # События идут отдельным каналом только по запросу родительского контроллера.
  # Закрытый fd не должен менять старые коды или засорять stderr оболочки.
  build_event() {
    if [[ "${GRIGDESK_CTL_BUILD_OBSERVED:-}" == 1 ]] && { true >&3; } 2>/dev/null; then
      {
        printf '%s\t%s' "$1" "$2"

        if (( $# >= 3 )); then
          printf '\t%s' "$3"
        fi

        printf '\n'
      } >&3
    fi
    return 0
  }

  # Наблюдатель обрамляет прежний вызов, явно сохраняя его код.
  # Он не добавляет стадий и не меняет обработку optional зависимостей.
  observed_step() {
    local id=$1
    local code=0
    shift

    build_event start "$id"
    "$@" || code=$?
    build_event end "$id" "$code"
    return "$code"
  }

  # Каждая обязательная стадия сохраняет свой код и останавливает общую цепочку.
  # Вложенные функции явно передают ошибки: условный вызов отключает bash errexit внутри них.
  build_step() {
    local step=$1
    shift

    "$@" || {
      local code=$?

      echo "не удалось: $step" >&2
      return "$code"
    }
  }

  case "$CMD" in
    deps)
      cd "$DIR/server" && npm install --no-audit --no-fund
      cd "$DIR/web"    && npm install --no-audit --no-fund
      prepare_deepseek
      ;;
    build)
      desktop_requires_selection=0

      if [[ "$build_target" == all || "$build_target" == server ]]; then
        build_step server build_server
      fi

      if [[ "$build_target" == all || "$build_target" == web || "$build_target" == window ]]; then
        build_step web observed_step web.dependencies ensure_deps
        build_step web observed_step web.build build_web
      fi

      if [[ "$build_target" == all || "$build_target" == window ]]; then
        build_step window build_window
      fi

      # Полная установка связывает окно с её ELF только после успеха всех компонентов.
      # Живой сервер продолжает работу: общий selector применит намерение при новом запуске.
      if [[ "$build_target" == all ]]; then
        desktop_build_selection=$(build_step window node "$DIR/server/scripts/ctlBuild.mts" \
          queue-desktop "$DIR/bin/grigdesk-server") || return $?

        case "$desktop_build_selection" in
          queued)
            build_event hint queued-server
            echo 'При следующем запуске окно выберет сервер этой сборки.'
            ;;
          foreign)
            desktop_requires_selection=1
            build_event hint select-server
            printf 'Для выбора этого сервера окном: grigdesk-ctl desktop use-server %q\n' \
              "$DIR/bin/grigdesk-server"
            ;;
          current) ;;
          *)
            echo 'Не удалось определить привязку окна после полной установки.' >&2
            return 1
            ;;
        esac
      fi

      case "$build_target" in
        all) echo 'Поставлены сервер, веб и окно.' ;;
        server) echo "Поставлен сервер: $DIR/bin/grigdesk-server" ;;
        web) echo "Собран веб: $DIR/web/dist" ;;
        window) echo "Поставлено окно: $DIR/bin/grigdesk-app; веб собран." ;;
      esac

      if [[ "$build_target" == web ]]; then
        echo 'Окно покажет новый веб после grigdesk-ctl build window.'
      elif [[ "$desktop_requires_selection" == 1 ]]; then
        echo 'Окно сохраняет выбор другой установки сервера; новый сервер ещё не выбран.'
      else
        echo 'Закройте окно и откройте снова — запустится новый код.'
      fi
      ;;
    dev)
      ensure_deps
      echo "→ Dev: vite :5180 + сервер (--watch) :$PORT"
      ( cd "$DIR/web" && npm run dev ) &
      VITE_PID=$!
      trap 'kill "$VITE_PID" 2>/dev/null || true' EXIT INT TERM
      cd "$DIR/server" && NODE_ENV=development node "${ENV_ARG[@]}" --watch src/app.ts
      ;;
    run)
      if port_busy; then
        echo "→ GrigDesk уже слушает :$PORT — открой http://localhost:$PORT"
        echo "  (чтобы перезапустить — сначала останови процесс на этом порту)"
        exit 0
      fi
      ensure_deps
      build_web
      echo "→ Сервер поднят: http://localhost:$PORT (только с этой машины)"
      cd "$DIR/server" && exec node "${ENV_ARG[@]}" src/app.ts
      ;;
    *)
      echo "Неизвестная команда: $CMD"
      echo "Смотри: grigdesk-ctl --help"
      exit 1
      ;;
  esac

}

case "$CMD" in
  dev|build|deps|run)
    # Справка не должна выполнять команду: build и run пишут в рабочий web/dist,
    # а dev поднимает сервер. Просьба о справке уходит в общий CLI без эффектов.
    for argument in "${@:2}"; do
      if [[ $argument == --help || $argument == -h ]]; then
        source "$DIR/deploy/lib/runtime-env.sh"
        grigdesk_require_node source
        exec node "$DIR/cli/main.ts" --help
      fi
    done

    # Только валидная ручная сборка попадает в экран прогресса.
    # Внутренний ребёнок и старые ошибки аргументов сохраняют обычный путь.
    if [[ "$CMD" == build && -t 0 && -t 1 && "${GRIGDESK_CTL_BUILD_CHILD:-}" != 1 \
      && $# -le 2 && "${2-all}" =~ ^(all|server|web|window)$ ]]; then
      source "$DIR/deploy/lib/runtime-env.sh"
      grigdesk_require_node source
      exec node "$DIR/cli/main.ts" "$@"
    fi

    developer_command "${@:2}"
    ;;
  desktop)
    shift
    exec "$DIR/deploy/desktop.sh" "$@"
    ;;
  b24)
    shift

    if [[ -x "$DIR/bin/b24" ]]; then
      exec "$DIR/bin/b24" "$@"
    fi

    source "$DIR/deploy/lib/runtime-env.sh"
    grigdesk_require_node
    exec node "$DIR/b24/src/main.ts" "$@"
    ;;
  mobile|release)
    shift
    exec "$DIR/tools/$CMD" "$@"
    ;;
  *)
    source "$DIR/deploy/lib/runtime-env.sh"
    grigdesk_require_node
    exec node "$DIR/cli/main.ts" "$@"
    ;;
esac
