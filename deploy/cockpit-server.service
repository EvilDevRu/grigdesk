# systemd user-сервис сервера кокпита (host-native, по образцу factory-dashboard.service).
# Установка: см. deploy/install.sh. Управление:
#   systemctl --user enable --now cockpit-server
#   systemctl --user status cockpit-server
#   journalctl --user -u cockpit-server -f
[Unit]
Description=Кокпит: API-сервер (Fastify)
After=network.target
# network-online.target здесь НЕ ставим: у пользовательского менеджера его нет
# (LoadState=not-found), строка была бы декоративной. Готовность сети всё равно
# проверяется по факту — воротами VPN ниже, и это надёжнее любого таргета.
#
# VPN обязателен. Туннель поднимает sing-box из v2rayN — своего сервиса у него нет,
# поэтому зацепиться можно только за device-юнит интерфейса (проверено: он виден и
# пользовательскому менеджеру как active/plugged).
After=sys-subsystem-net-devices-singbox_tun.device
# СТРОГИЙ РЕЖИМ (по умолчанию выключен): гасить кокпит, если туннель ИСЧЕЗ на ходу.
# Сейчас ворота работают только на запуске — упавший на ходу VPN сервер не остановит,
# и до ручного перезапуска трафик пойдёт напрямую. Включать осознанно: при коротком
# моргании туннеля веб-интерфейс отвалится, а открытые в нём чаты-агенты оборвутся.
# BindsTo=sys-subsystem-net-devices-singbox_tun.device
#
# БЕЗ ЭТОГО — ГРАБЛИ, НА КОТОРЫЕ УЖЕ НАСТУПИЛИ. Дефолт «5 стартов за 10 секунд»
# при RestartSec=2 упирается в лимит мгновенно. 27.07.2026 юнит так намотал 7553
# падения (порт держал вручную запущенный экземпляр), а с воротами VPN он бы вдобавок
# оказался заблокирован навсегда: после перезагрузки туннель поднимается не за 10
# секунд, и кокпит не встал бы уже никогда. Ноль = ждать VPN сколько нужно.
StartLimitIntervalSec=0

[Service]
Type=simple
# NODE и рабочая директория подставит install.sh (шаблонные плейсхолдеры).
ExecStart=__NODE__ __COCKPIT_DIR__/server/src/app.js
WorkingDirectory=__COCKPIT_DIR__/server
# PATH задаём явно: у systemd user-сервиса он берётся из окружения сессии, зафиксированного
# при логине, и НЕ содержит ~/.local/bin и каталога node. Без этого кокпит не находит CLI
# исполнителей (claude, codex) — они показываются «недоступен», а запуски из чата и
# конвейера падают. __NODE_DIR__ (каталог node) подставит install.sh.
Environment=PATH=%h/.local/bin:__NODE_DIR__:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
# МАШИННЫЕ НАСТРОЙКИ — в корневом .env (см. .env.example), а НЕ строками Environment здесь:
# этот файл install.sh каждый раз перегенерирует из шаблона, и правки в установленной копии
# молча пропадут на первой же переустановке. Так же .env читает bin/cockpit (--env-file), то
# есть все три способа запуска (systemd, bin/cockpit, bin/restart) видят одно и то же.
# Через это задаются COCKPIT_MEDIA_PYTHON (python из venv с faster-whisper), COCKPIT_TLS_*,
# COCKPIT_SANDBOX_DOWN_CMD, ключи API. Ворота VPN ниже читают оттуда же (ExecStartPre берёт
# окружение юнита) — COCKPIT_VPN_IFACE/COCKPIT_VPN_PROBE.
# Синтаксис — systemd, не shell: без export, без подстановки $VAR и %h (пути только абсолютные).
# «-» — файла может не быть.
EnvironmentFile=-__COCKPIT_DIR__/.env
# ВОРОТА VPN. Ненулевой код — сервер не запускается, systemd повторит через RestartSec.
# Так после перезагрузки кокпит спокойно ждёт sing-box вместо старта в обход туннеля.
# Проверяется МАРШРУТ, а не наличие интерфейса: sing-box поднимает singbox_tun раньше,
# чем расставляет правила, и в это окно трафик ещё идёт мимо.
ExecStartPre=__COCKPIT_DIR__/deploy/require-vpn.sh
Restart=always
# 5с вместо 2с: пауза заметна только при ожидании VPN, а журнал не забивается.
RestartSec=5

[Install]
WantedBy=default.target
