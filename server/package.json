{
  "name": "cockpit-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Кокпит: API-сервер (Fastify). Host-native, читает состояние фабрики и командует ей.",
  "main": "src/app.js",
  "scripts": {
    "start": "node --experimental-strip-types src/app.js",
    "dev": "node --experimental-strip-types --watch src/app.js",
    "test": "npm run typecheck:docker && npm run typecheck:code && npm run typecheck:sandboxes && node --experimental-strip-types --test ../tests/server/*.test.js",
    "typecheck:docker": "tsc -p tsconfig.docker.json --noEmit",
    "typecheck:code": "tsc -p tsconfig.code.json --noEmit",
    "typecheck:sandboxes": "tsc -p tsconfig.sandboxes.json --noEmit"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/http-proxy": "^11.6.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.3",
    "qrcode-generator": "^2.0.4",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  }
}
