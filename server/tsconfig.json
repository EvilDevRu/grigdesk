// Общая проверка всего собственного TypeScript сервера. Области остаются отдельными
// командами ради быстрой обратной связи, но итог миграции считает эта.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Переходно: в server/src ещё остаётся собственный JavaScript. checkJs выключен,
    // чтобы невыведенные формы соседей не выдавались за проверенные; allowJs снимается
    // вместе с последним .js этой области.
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "../shared/**/*.ts",
    "../tools/**/*.mts",
    "../tests/types/*.mts",
    "../tests/docs/*.mts"
  ]
}
