// Нейтральная база серверных проверок: среда Node и общие требования к типам.
{
  "compilerOptions": {
    // Node 22 — минимум проекта, поэтому библиотеке разрешён весь ES2023
    // (findLast, toSorted и соседи): downlevel-эмита здесь нет, noEmit включён.
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
