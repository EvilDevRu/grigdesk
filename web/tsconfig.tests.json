// Проверка тестов интерфейса.
//
// База — браузерная, хотя запускает тесты Node. Причина в компоновке: `.vue` не
// является известным Node расширением, и при `module: NodeNext` компилятор считает
// каждый компонент CommonJS — `import.meta` в нём становится ошибкой на ровном месте.
// Среду Node тесты получают типами, а не режимом модулей.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Переходно: тесты ещё на JavaScript и переносятся вместе со своей волной.
    "allowJs": true,
    "checkJs": false,
    "types": ["node", "vite/client"],
    // Каталог tests лежит вне пакета web, и поиск вверх до его node_modules не
    // доходит. В прогоне зависимости берёт компилятор SFC из web/, поэтому здесь
    // объявлено ровно то же место — иначе проверка «не нашла vue» там, где он есть.
    "baseUrl": ".",
    "paths": {
      "fastify": ["../server/node_modules/fastify"],
      "vue": ["node_modules/vue"],
      "vue/*": ["node_modules/vue/*"],
      "pinia": ["node_modules/pinia"],
      "vue-router": ["node_modules/vue-router"],
      "@vue/*": ["node_modules/@vue/*"]
    }
  },
  "include": [
    // HTTP-фикстуры подключают providers/auth сервера вместе с их общими типами Fastify.
    "../server/src/lib/fastifyDecorations.ts",
    "src/types/browserNative.d.ts",
    "../tests/web/**/*"
  ]
}
