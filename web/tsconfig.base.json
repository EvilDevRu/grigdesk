// Нейтральная база проверок интерфейса: среда браузера и сборщика, без Node-глобалей.
{
  "compilerOptions": {
    "target": "ES2022",
    "paths": {
      "vue": ["./node_modules/vue"],
      "vue/*": ["./node_modules/vue/*"]
    },
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // ES2023.Array — только объявления `findLast`/`toSorted` и соседей: код уже
    // пользуется ими в бою, а браузеры держат их с 2022 года. `target` намеренно
    // остаётся ES2022 — его читает esbuild при сборке, и менять вывод незачем.
    "lib": ["ES2022", "ES2023.Array", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowJs": false,
    "checkJs": false,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  }
}
