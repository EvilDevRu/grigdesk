// Служебные программы web: они запускаются Node, а не браузером, и общий с
// интерфейсом lib дал бы им DOM, которого у них нет. База берётся серверная —
// среда у них одна и та же, и второй копии её требований в репозитории быть не должно.
{
  "extends": "../server/tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.mjs"
  ]
}
