{
  "name": "cockpit-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Кокпит: web-клиент (Vite + Vue 3, PWA). Окно в мозг.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck:ui": "vue-tsc -p tsconfig.ui.json --noEmit",
    "check:readability": "node scripts/check-code-readability.mjs",
    "check:sfc": "node scripts/check-vue-sfc-order.mjs",
    "check:ui": "node scripts/check-ui-suite.mjs",
    "check:ui-styles": "node scripts/check-ui-control-styles.mjs",
    "test:ui-browser": "node scripts/check-ui-geometry.mjs",
    "test:components": "NODE_TEST_HEAP_MB=1024 NODE_TEST_MAX_RSS_MB=6144 bash ../tests/run-node-tests-safe.sh --test --test-concurrency=4 ../tests/web/*.test.js",
    "test": "npm run typecheck && npm run typecheck:tests && npm run typecheck:scripts && npm run check:sfc && npm run check:ui && npm run check:ui-styles && npm run check:readability && npm run test:components",
    "typecheck:docker": "vue-tsc -p tsconfig.docker.json --noEmit",
    "typecheck:code": "vue-tsc -p tsconfig.code.json --noEmit",
    "typecheck:sandboxes": "vue-tsc -p tsconfig.sandboxes.json --noEmit",
    "typecheck:showcase": "vue-tsc -p tsconfig.showcase.json --noEmit",
    "typecheck:knowledge": "vue-tsc -p tsconfig.knowledge.json --noEmit",
    "typecheck:shelf": "vue-tsc -p tsconfig.shelf.json --noEmit",
    "typecheck:video": "vue-tsc -p tsconfig.video.json --noEmit",
    "typecheck:triage": "vue-tsc -p tsconfig.triage.json --noEmit",
    "typecheck:ssh": "vue-tsc -p tsconfig.ssh.json --noEmit",
    "typecheck:github": "vue-tsc -p tsconfig.github.json --noEmit",
    "typecheck:db": "vue-tsc -p tsconfig.db.json --noEmit",
    "typecheck:inbox": "vue-tsc -p tsconfig.inbox.json --noEmit",
    "typecheck:telegram": "vue-tsc -p tsconfig.telegram.json --noEmit",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:tests": "vue-tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^14.0.0",
    "monaco-editor": "^0.56.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/compiler-sfc": "^3.5.40",
    "@vue/test-utils": "^2.4.11",
    "esbuild": "^0.25.12",
    "happy-dom": "^18.0.1",
    "postcss": "^8.5.26",
    "typescript": "^5.9.3",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
