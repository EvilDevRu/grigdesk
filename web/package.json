{
  "name": "cockpit-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Кокпит: web-клиент (Vite + Vue 3, PWA). Окно в мозг.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck:ui": "vue-tsc -p tsconfig.ui.json --noEmit",
    "check:readability": "node scripts/check-code-readability.mjs",
    "check:sfc": "node scripts/check-vue-sfc-order.mjs",
    "check:ui": "node scripts/check-ui-suite.mjs",
    "check:ui-styles": "node scripts/check-ui-control-styles.mjs",
    "test:ui-browser": "node scripts/check-ui-geometry.mjs",
    "test:components": "node --experimental-strip-types --max-old-space-size=768 --test --test-concurrency=4 ../tests/web/*.test.js",
    "test": "npm run typecheck:ui && npm run typecheck:docker && npm run typecheck:code && npm run check:sfc && npm run check:ui && npm run check:ui-styles && npm run check:readability && npm run test:components",
    "typecheck:docker": "vue-tsc -p tsconfig.docker.json --noEmit && npm --prefix ../server run typecheck:docker",
    "typecheck:code": "vue-tsc -p tsconfig.code.json --noEmit && npm --prefix ../server run typecheck:code"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^14.0.0",
    "monaco-editor": "^0.56.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/compiler-sfc": "^3.5.40",
    "@vue/test-utils": "^2.4.11",
    "esbuild": "^0.25.12",
    "happy-dom": "^18.0.1",
    "postcss": "^8.5.26",
    "typescript": "^5.9.3",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^2.2.12"
  }
}
