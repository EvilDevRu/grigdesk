{
  "name": "grigdesk-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "GrigDesk: интерфейс приложения на Vue 3 и Vite.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck:ui": "vue-tsc -p tsconfig.ui.json --noEmit",
    "check:readability": "node scripts/check-code-readability.mjs",
    "check:sfc": "node scripts/check-vue-sfc-order.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:ui": "node scripts/check-ui-suite.mjs",
    "check:ui-styles": "node scripts/check-ui-control-styles.mjs",
    "test:ui-browser": "node scripts/check-ui-geometry.mjs",
    "test:components": "NODE_TEST_HEAP_MB=1024 NODE_TEST_MAX_RSS_MB=6144 bash ../tests/run-node-tests-safe.sh --test --test-concurrency=4 ../tests/web/*.test.js ../tests/web/sandboxes-responsive.test.mts ../tests/web/sandbox-url.test.mts ../tests/web/webRuntimePreservation.test.mts ../tests/web/webSourceMigration.test.mts ../tests/web/webNetworkBoundaries.test.mts ../tests/web/webViewBoundaries.component.test.mts ../tests/web/speechWorkletBuild.test.mts ../tests/web/pureModulesBehavior.test.mts ../tests/web/pureModulesMigration.test.mts ../tests/web/legacy-storage.test.mts ../tests/web/brand-assets.test.mts ../tests/web/api-same-origin.test.mts",
    "test": "npm run typecheck && npm run typecheck:tests && npm run typecheck:scripts && npm run check:sfc && npm run check:ui && npm run check:ui-styles && npm run check:readability && npm run test:components",
    "typecheck:docker": "vue-tsc -p tsconfig.docker.json --noEmit",
    "typecheck:code": "vue-tsc -p tsconfig.code.json --noEmit",
    "typecheck:sandboxes": "vue-tsc -p tsconfig.sandboxes.json --noEmit",
    "typecheck:showcase": "vue-tsc -p tsconfig.showcase.json --noEmit",
    "typecheck:shelf": "vue-tsc -p tsconfig.shelf.json --noEmit",
    "typecheck:video": "vue-tsc -p tsconfig.video.json --noEmit",
    "typecheck:triage": "vue-tsc -p tsconfig.triage.json --noEmit",
    "typecheck:ssh": "vue-tsc -p tsconfig.ssh.json --noEmit",
    "typecheck:github": "vue-tsc -p tsconfig.github.json --noEmit",
    "typecheck:db": "vue-tsc -p tsconfig.db.json --noEmit",
    "typecheck:inbox": "vue-tsc -p tsconfig.inbox.json --noEmit",
    "typecheck:telegram": "vue-tsc -p tsconfig.telegram.json --noEmit",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit && npm run typecheck:worklet",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:worklet": "tsc -p tsconfig.audioWorklet.json --noEmit",
    "typecheck:tests": "vue-tsc -p tsconfig.tests.json --noEmit",
    "predev": "node scripts/buildMarkdownRenderer.mjs",
    "prebuild": "node scripts/buildMarkdownRenderer.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^14.0.0",
    "mermaid": "12.1.0",
    "monaco-editor": "^0.56.0",
    "pinia": "^2.2.6",
    "shiki": "4.5.0",
    "three": "0.186.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/compiler-sfc": "^3.5.40",
    "@vue/test-utils": "^2.4.11",
    "esbuild": "^0.25.12",
    "happy-dom": "^18.0.1",
    "postcss": "^8.5.26",
    "typescript": "^5.9.3",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
