+  const endpoint = request.baseURL ?? providerBaseUrl
+  const standardApi = endpoint === 'https://api.z.ai/api/paas/v4'
+  const codingPlan = endpoint === 'https://api.z.ai/api/coding/paas/v4'
+
+  if (provider === 'zai' && (standardApi || codingPlan)
