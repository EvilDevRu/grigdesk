+function isJsonObject(value: JsonValue | undefined): value is Record<string, JsonValue> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value)
+}
+
+/**
+ * Web-клиент GrigDesk получает прежнюю обёртку результата инструмента.
+ * Журнал и модель продолжают использовать формат v4.
+ */
+function grigdeskToolResult(entry: SessionEventEntry): SessionEventEntry {
+  const event = entry.event
+
+  if (event.type !== 'tool/result' || !isJsonObject(event.data)) {
+    return entry
+  }
+
+  const message = event.data['message']
+
+  if (!isJsonObject(message) || message['role'] !== 'tool'
+    || typeof message['toolCallId'] !== 'string' || !Array.isArray(message['content'])) {
+    return entry
+  }
+
+  const { toolCallId, isError, content, ...rest } = message
+  const result = {
+    type: 'tool-result',
+    toolCallId,
+    content,
+    ...(typeof isError === 'boolean' ? { isError } : {}),
+  }
+  const data = { ...event.data, message: { ...rest, content: [result] } }
+
+  return { ...entry, event: { ...event, data } }
 }
 
