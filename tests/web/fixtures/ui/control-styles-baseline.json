{
  "version": 1,
  "findings": {
    "web/src/features/companion/CompanionAvatar.vue": {
      ".companion-avatar": {
        "height": {
          "clamp(56px, 5.5vw, 72px)": 1
        },
        "min-height": {
          "56px": 1
        },
        "padding": {
          "0": 1
        },
        "border": {
          "0": 1
        },
        "border-radius": {
          "18px": 1
        },
        "color": {
          "var(--accent)": 1
        },
        "background": {
          "none": 1
        },
        "cursor": {
          "pointer": 1
        },
        "transition": {
          "none": 1
        }
      },
      ".companion-avatar:focus-visible": {
        "outline": {
          "3px solid color-mix(in srgb, var(--accent) 55%, transparent)": 1
        }
      },
      ".companion-avatar:hover .avatar-art": {
        "transform": {
          "translateY(-3px) scale(1.05)": 1
        }
      },
      ".companion-avatar:active .avatar-art": {
        "transform": {
          "translateY(2px) scale(1.07, .9)": 1
        }
      },
      ".companion-avatar.attention-wait .attention-badge": {
        "color": {
          "#1a1206": 1
        }
      },
      ".companion-avatar:hover": {
        "transform": {
          "none": 1
        }
      }
    },
    "web/src/features/companion/CompanionTopbarButton.vue": {
      ".companion-tb": {
        "padding": {
          "0": 1
        },
        "border": {
          "0": 1
        },
        "background": {
          "none": 1
        },
        "line-height": {
          "0": 1
        },
        "color": {
          "var(--accent)": 1
        },
        "cursor": {
          "pointer": 1
        },
        "transition": {
          "opacity .12s": 1
        }
      },
      ".companion-tb:hover": {
        "opacity": {
          ".82": 1
