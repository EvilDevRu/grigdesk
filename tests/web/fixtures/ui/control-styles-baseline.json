{
  "version": 1,
  "findings": {
    "web/src/shared/layout/AppShell.vue": {
      ".navitem, .collapse-btn": {
        "padding": {
          "9px 11px": 1,
          "10px 0": 1
        },
        "border-radius": {
          "9px": 1
        },
        "color": {
          "var(--ink-mid)": 1
        },
        "font-size": {
          "14px": 1
        },
        "background": {
          "none": 1
        },
        "border": {
          "none": 1
        },
        "cursor": {
          "pointer": 1
        },
        "transition": {
          "background .12s, color .12s": 1
        }
      },
      ".navitem:hover, .collapse-btn:hover": {
        "background": {
          "var(--surface)": 1
        },
        "color": {
          "var(--ink)": 1
        }
      },
      ".navitem.active": {
        "background": {
          "color-mix(in srgb, var(--accent) 14%, transparent)": 1,
          "none": 1
        },
        "color": {
          "var(--accent)": 1
        }
      },
      ".collapsed .navitem, .collapsed .collapse-btn": {
        "padding": {
          "10px 0": 1
        }
      },
      ".navitem": {
        "font-size": {
          "10px": 1
        },
        "padding": {
          "9px 2px": 1
        },
        "border-radius": {
          "0": 1
        }
      }
    },
    "web/src/views/AgentsView.vue": {
      ".item .ic": {
        "font-size": {
          "12px": 1
        }
      },
      ".item .nm": {
        "line-height": {
          "18px": 1
        }
      },
      ".tag": {
        "font-family": {
          "var(--mono)": 1
        }
      },
      ".prompt": {
        "min-height": {
          "180px": 1
        },
        "line-height": {
          "1.55": 1
        }
      }
    },
    "web/src/views/InboxView.vue": {
      ".section-tab span": {
        "padding": {
          "1px 6px": 1
        },
        "border-radius": {
          "999px": 1
        },
        "background": {
          "var(--surface-2)": 1
        },
        "font-size": {
          "11px": 1
        }
      }
    },
    "web/src/views/code/CodePanel.vue": {
      ".tree .trow": {
        "padding-left": {
          "calc(var(--tree-lead) + var(--depth, 0) * var(--tree-step))": 1
        }
      },
      ".search-result": {
        "min-height": {
          "30px": 1
        },
        "height": {
          "auto": 1
        },
        "padding-block": {
          "5px": 1
        }
      }
    },
    "web/src/views/code/PatchReview.vue": {
      ".patch-file-head": {
        "padding": {
          "7px 12px": 1
        },
        "background": {
          "var(--surface)": 1
        }
      },
      ".patch-line": {
        "min-height": {
          "20px": 1
        },
        "line-height": {
          "20px": 1
        },
        "cursor": {
          "pointer": 1
        }
      },
      ".patch-line.add": {
        "background": {
          "color-mix(in srgb, var(--good) 14%, transparent)": 1
        }
      },
      ".patch-line.del": {
        "background": {
          "color-mix(in srgb, var(--bad) 14%, transparent)": 1
        }
      },
      ".patch-line.meta": {
        "color": {
          "var(--ink-mid)": 1
        }
      }
    },
    "web/src/views/diff/DiffPanel.vue": {
      ".trow": {
        "background": {
          "none": 1
        },
        "border": {
          "none": 1
        },
        "color": {
          "var(--ink)": 1
        },
        "padding": {
          "5px 8px": 1
        },
        "border-radius": {
          "7px": 1
        },
        "cursor": {
          "pointer": 1
        },
        "font-size": {
          "12.5px": 1
        }
      },
      ".trow:hover": {
        "background": {
          "var(--surface)": 1
        }
      },
      ".trow.dir": {
        "color": {
          "var(--ink-mid)": 1
        }
      },
      ".frow.sel": {
        "background": {
          "color-mix(in srgb, var(--accent) 16%, transparent)": 1
        }
      }
    },
    "web/src/styles/base.css": {
      "button": {
        "font-family": {
          "inherit": 1
        }
      }
    },
    "web/src/styles/utilities.css": {
      ".mono": {
        "font-family": {
          "var(--mono)": 1
        }
      }
    }
  }
}
