# Конструкт offline-contract: auth-сигнатура в stderr.log дословно из
# kimi-no-login/stderr.log, активность в events.jsonl (assistant tool_calls +
# tool result + assistant content) — из kimi-ok/events.jsonl. Строка
# meta/session.resume_hint оставлена из kimi-ok сознательно: это хинт
# сериализации сессии, а НЕ модельная активность. Auth-строка при наличии
# работы в events НЕ может классифицироваться как provider_unavailable —
# иначе стадия выполнилась бы дважды (прецеденты
# claude-request-not-allowed-after-work, codex-auth-corrupt-stream).
SCHEMA=1
CLI_VERSION=0.31.1
RC=1
FIXTURE_VERIFIED=1
PROVENANCE=offline-contract
EXPECTED_CLASS=unknown
