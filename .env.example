# Конфигурация GrigDesk. Файл .env лежит в папке данных: по умолчанию ~/.grigdesk/.env.
# Другую папку выбирает GRIGDESK_HOME, другой файл — GRIGDESK_ENV_FILE в окружении запуска.
# В самом .env оба ключа запрещены. Существующие данные переносит tools/moveDataHome.mts.
# CLI bin/grigdesk-ctl читает как данные; bin/grigdesk-ctl run и deploy/restart.sh — через `node --env-file`,
# systemd-юнит — через `EnvironmentFile=` (а значит и его ExecStartPre — ворота VPN).
# Другого места для машинных настроек нет: строки Environment= в установленном юните
# затрёт deploy/install.sh на следующем прогоне. После правки — перезапуск сервера.
#
# СИНТАКСИС — общий знаменатель systemd и node --env-file: KEY=VALUE, без export, без кавычек
# вокруг значения, без подстановки $VAR. Пути — ТОЛЬКО абсолютные: `~/.factory/state` уедет
# в переменную вместе с тильдой, и сервер пойдёт искать каталог с именем «~». Поэтому дефолты
# с тильдой ниже закомментированы — разворачивать $HOME умеет код, но не этот файл.
#
# Пустой .env полностью рабочий: у всего закомментированного есть дефолт в server/src/config.ts.
# Задавай только то, что меняешь. Если внутри окажутся ключи API — `chmod 600 .env`.

# ── Сеть ──────────────────────────────────────────────────────────────────
# Сервер слушает только 127.0.0.1; окно открывается на http://127.0.0.1:<порт>.
GRIGDESK_PORT=8140
# Неизменяемые версии интерфейса из AppImage; одинаковый путь для сервера и приложения.
# По умолчанию <папка данных>/state/ui-releases. Старые версии сохраняются для открытых окон.
# GRIGDESK_UI_RELEASES_DIR=<абсолютный путь>/ui-releases
# Если локальных контейнеров посредника несколько, выбери compose project для grigdesk-ctl relay.
# Без явного проекта CLI выбирает только контейнер с одним compose-файлом этой копии.
# GRIGDESK_RELAY_PROJECT=
# Бюджет остановки сервера (слив ходов чата + закрытие исполнителей и сокетов). Должен быть
# меньше ожидания deploy/restart.sh (45 с) и TimeoutStopSec юнита (45 с).
# GRIGDESK_SHUTDOWN_TIMEOUT_MS=30000
# Локальное окно входит по ключу из $XDG_RUNTIME_DIR/grigdesk; CLI-токен — в state/ папки данных.
# Парольный вход снят; ключи создаёт сервер с приватными правами.
# Прежний GRIGDESK_TOKEN убран: его приходилось дублировать во фронт через VITE_GRIGDESK_TOKEN,
# а Vite подставляет env в бандл на сборке — секрет оказывался в публичном JS открытым текстом.

# Telegram account-aware credential; token связан с botId и accountRef.
# GRIGDESK_TELEGRAM_ACCOUNT_CREDS_PATH=<папка данных>/state/telegram-account-creds.json

# GitHub Issues channel. Callback base должен быть публичным HTTPS без query/fragment;
# сервер добавляет к нему случайный ingressRef. Без явного base подключение невозможно.
# GRIGDESK_GITHUB_WEBHOOK_BASE_URL=https://grigdesk.example.ru/hooks/github
# Нативный archive/bindings по умолчанию лежит в <папка данных>/github, секреты — в state/ папки данных.
# GRIGDESK_GITHUB_DIR=<абсолютный путь>/github
# GRIGDESK_GITHUB_CREDS_PATH=<папка данных>/state/github-creds.json

# ── Ворота VPN (deploy/require-vpn.sh в ExecStartPre) ───────────────────────
# По умолчанию GrigDesk не стартует, пока маршрут до PROBE не идёт через автоматически
# распознанный TUN. Для другой VPN-схемы задай интерфейс явно; отключение тоже только явное.
# Проверяется маршрут, а не одно interface=up: устройство может появиться раньше policy routes.
# GRIGDESK_REQUIRE_VPN=0
# GRIGDESK_VPN_IFACE=wg0
# GRIGDESK_VPN_PROBE=1.1.1.1

# ── Пути «мозга» (фабрика/конвейер) ───────────────────────────────────────
# Дефолты: $HOME/.factory/state, встроенный <корень grigdesk>/engine и локальный profiles/.
# /profiles/ целиком игнорируется Git и переносится/резервируется отдельно.
# Внешний checkout движка/профилей поддерживается только явными абсолютными путями.
# FACTORY_STATE_DIR=/home/user/.factory/state
# FACTORY_HOME=/absolute/path/to/another/engine
# FACTORY_PROFILES_DIR=/absolute/path/to/profiles
# GRIGDESK_FACTORY_BIN=/absolute/path/to/another/engine/bin/factory
# FACTORY_CONFIG_ROOT=/home/user/.factory/config
# Профиль запуска на конвейер (пусто → определяется по данным).
GRIGDESK_FACTORY_PROFILE=

# ── Исполнители (ИИ) ──────────────────────────────────────────────────────
# Бинари CLI в PATH. Нет бинаря → провайдер показывается «недоступен», а не падает.
GRIGDESK_CLAUDE_BIN=claude
# Обычно не нужны: GrigDesk читает публичную OAuth-пару из установленного Claude CLI.
# Для нестандартной сборки задавать только ВМЕСТЕ.
# GRIGDESK_CLAUDE_OAUTH_CLIENT_ID=
# GRIGDESK_CLAUDE_OAUTH_TOKEN_URL=
GRIGDESK_CODEX_BIN=codex
# Kimi Code: основной install script кладёт бинарник в ~/.kimi-code/bin. Штатные
# launcher/systemd добавляют этот каталог в PATH; абсолютный override обычно не нужен.
GRIGDESK_KIMI_BIN=kimi
# KIMI_CODE_HOME=/home/user/.kimi-code
# Server-owned профиль изоляции Kimi; host config/skills/plugins/MCP сюда не копируются.
# GRIGDESK_KIMI_RUNTIME_HOME=/home/user/.factory/state/grigdesk-kimi-contained
# GRIGDESK_KIMI_BWRAP_BIN=/usr/bin/bwrap
# GRIGDESK_KIMI_SYSTEMD_RUN_BIN=/usr/bin/systemd-run
# Авторизация Claude: пусто → берётся хостовая (claude login) либо ANTHROPIC_API_KEY отсюда.
# Старый сохранённый ключ Claude может оставаться в state/claude-auth.json папки данных (0600).
# ANTHROPIC_API_KEY=
# GRIGDESK_CLAUDE_AUTH_PATH=<папка данных>/state/claude-auth.json
# Codex: список моделей тянется platform-API и требует именно ключ (OAuth-токен codex не годится).
# OPENAI_API_KEY=
# Автообнаружение новых моделей Anthropic ХОСТОВЫМ OAuth-токеном claude CLI (~/.claude/.credentials.json).
# Только явный опт-ин «1»: токен выдан для CLI, дёргать им API без спроса нельзя.
# ANTHROPIC_API_KEY выше работает и без этого флага.
# GRIGDESK_DISCOVER_WITH_CLI_TOKEN=0
# ── Триаж задач (разведка кода headless-агентом, без стенда) ───────────────
# GRIGDESK_ANALYSIS_MODEL=sonnet
# Параллельных оценок: с одним воркером очередь в 70 задач — это часы ожидания.
# GRIGDESK_ANALYSIS_CONCURRENCY=2
# GRIGDESK_ANALYSIS_TIMEOUT_MS=1200000
# GRIGDESK_ANALYSIS_DIR=/home/user/.factory/analysis

# DeepSeek. Ключ удобнее задать окном «Настройки → Исполнители → Ключи доступа»:
# оно пишет сюда же и применяет ключ без перезапуска.
# DEEPSEEK_API_KEY=
# GRIGDESK_DEEPSEEK_RUNTIME_HOME=/home/user/.factory/state/grigdesk-deepseek
# GRIGDESK_DEEPSEEK_BIN=/home/user/.factory/state/grigdesk-deepseek/install/current/node_modules/.bin/dsh

# GLM (Z.ai) — на той же встроенной сборке DSH. Режим выбирается явно, умолчания нет;
# ключ берётся только из переменной своего режима. Окно «Ключи доступа» в карточке GLM
# пишет режим и ключи сюда и применяет без перезапуска; ручная правка — с перезапуском.
# GRIGDESK_GLM_API_MODE=api|coding-plan
# ZAI_API_KEY=
# ZAI_CODING_API_KEY=
# GRIGDESK_GLM_RUNTIME_HOME=/home/user/.factory/state/grigdesk-glm

# ── Битрикс24 (креды задаются из «Настроек», живут в state/ папки данных) ──────────────
GRIGDESK_B24_BASE_URL=
# B24_COOKIE_PATH=<папка данных>/state/b24-cookies.json
# B24_CREDS_PATH=<папка данных>/state/b24-creds.json

# ── Стенды / медиа ────────────────────────────────────────────────────────
# Команда сноса стенда задачи; {task} подставляется. Пусто → кнопка «снести стенд» неактивна.
GRIGDESK_SANDBOX_DOWN_CMD=
# Python из venv с faster-whisper — распознавание речи: раздел «Видео» И диктовка в чате.
# deploy/install.sh создаёт <папка данных>/state/media-venv; непустой custom path сохраняет.
GRIGDESK_MEDIA_PYTHON=
# GRIGDESK_MEDIA_DIR=<папка данных>/state/media
# Собственный HF-кэш GrigDesk. Пусто → <папка данных>/state/hf; обычная диктовка сеть не включает.
# GRIGDESK_MEDIA_HF_DIR=<папка данных>/state/hf
# Необязательная локальная короткая запись с речью для кнопки speed benchmark.
# Без неё кнопка честно выключена; tone/silence за эталон речи не выдаём.
# GRIGDESK_SPEECH_BENCHMARK_AUDIO=/absolute/path/to/reference.wav
# Облачный голос раздела «Презентации»: Yandex SpeechKit (API v3). Ключ сервисного аккаунта
# с ролью ai.speechkit-tts.user; синтез платный, текст сцен уходит поставщику. Пусто → говорят
# только локальные движки. Идентификатор каталога обычно не нужен: ключ сервисного аккаунта
# уже привязан к каталогу.
# GRIGDESK_SHOWCASE_YANDEX_API_KEY=
# GRIGDESK_SHOWCASE_YANDEX_FOLDER_ID=
# Облачный голос Microsoft (Edge TTS) в «Презентациях»: ключа и оплаты нет, включён по умолчанию,
# текст сцен уходит поставщику. 0 → выключить; движок остаётся в списке с подсказкой.
# GRIGDESK_SHOWCASE_EDGE_TTS=1

# ── Чего здесь быть не должно ─────────────────────────────────────────────
# • GRIGDESK_CHAT_KEY, GRIGDESK_INTERNAL, GRIGDESK_PERM_URL — служебные: сервер сам передаёт их
#   подпроцессу разрешений (lib/chat/permission-mcp.js). Заданные снаружи — только помешают.
# • GRIGDESK_URL, GRIGDESK_TOKEN задаются в окружении вызова CLI bin/b24. Порт и путь токена
#   он читает также из .env; токен по умолчанию — <папка данных>/state/cli-token.
# • Остальные пути (chats/, agents/, routes/, plugins/, web/dist, файлы state/, transcribe.py)
#   переопределяются переменными GRIGDESK_*_DIR/_PATH — полный список с дефолтами в
#   server/src/config.ts. В обычной жизни не трогаются, поэтому не перечислены.
