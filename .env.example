# Конфигурация кокпита. Скопируй в .env и правь под свою машину.
# Читают ВСЕ три способа запуска: bin/cockpit и bin/restart — через `node --env-file`,
# systemd-юнит — через `EnvironmentFile=` (а значит и его ExecStartPre — ворота VPN).
# Другого места для машинных настроек нет: строки Environment= в установленном юните
# затрёт deploy/install.sh на следующем прогоне. После правки — перезапуск сервера.
#
# СИНТАКСИС — общий знаменатель systemd и node --env-file: KEY=VALUE, без export, без кавычек
# вокруг значения, без подстановки $VAR. Пути — ТОЛЬКО абсолютные: `~/.factory/state` уедет
# в переменную вместе с тильдой, и сервер пойдёт искать каталог с именем «~». Поэтому дефолты
# с тильдой ниже закомментированы — разворачивать $HOME умеет код, но не этот файл.
#
# Пустой .env полностью рабочий: у всего закомментированного есть дефолт в server/src/config.js.
# Задавай только то, что меняешь. Если внутри окажутся ключи API — `chmod 600 .env`.

# ── Сеть ──────────────────────────────────────────────────────────────────
# HOST=0.0.0.0 — чтобы окно (планшет) достучалось через Tailscale.
COCKPIT_PORT=8140
COCKPIT_HOST=0.0.0.0
# Доступ к кокпиту: логин и пароль (один пользователь). Задаются НЕ здесь — при первом
# открытии кокпит сам попросит создать пароль, дальше меняется в Настройки → Доступ.
# Хранится scrypt-хешем в server/.state/auth-account.json (0600), в git не уезжает.
# Прежний COCKPIT_TOKEN убран: его приходилось дублировать во фронт через VITE_COCKPIT_TOKEN,
# а Vite подставляет env в бандл на сборке — секрет оказывался в публичном JS открытым текстом.

# TLS. Пусто → http. Задать оба → Fastify слушает https на том же порту.
# ОБЯЗАТЕЛЕН для доступа вне localhost: по http пароль уходит открытым текстом, и от TLS
# же зависит флаг Secure у сессионной cookie.
COCKPIT_TLS_KEY=
COCKPIT_TLS_CERT=

# Работа за доверенным шлюзом (VPS с Caddy + обратный SSH-туннель, deploy/gateway/).
# Указывать ИМЕННО адрес соседа, от которого приходят запросы — для туннеля это 127.0.0.1.
# НЕ `true`: тогда любой клиент назначал бы себе адрес через X-Forwarded-For и обходил
# и лимит попыток входа, и проверку «первичная настройка только с localhost».
# Включает: Secure у сессионной cookie по X-Forwarded-Proto + реальный IP клиента.
COCKPIT_TRUST_PROXY=

# Публичный домен кокпита за шлюзом (например cockpit.example.ru). Пусто → шлюза нет.
# Нужен для двух вещей: валидатор решает, каким именам выдавать сертификат (сам домен и
# p<порт>.<домен> с портом из диапазонов стендов), и сессионная cookie получает Domain,
# без которого она не уедет на поддомены стендов и те окажутся недоступны.
COCKPIT_PUBLIC_DOMAIN=

# ── Ворота VPN (deploy/require-vpn.sh в ExecStartPre юнита) ────────────────
# Кокпит не стартует, пока трафик не идёт через туннель. Проверяется МАРШРУТ до PROBE,
# а не наличие интерфейса: sing-box поднимает устройство раньше, чем расставляет правила.
# Здесь же и лечится «кокпит не запускается после перезагрузки»: у другого VPN-клиента
# интерфейс называется иначе, и ворота честно не пропускают старт.
# COCKPIT_VPN_IFACE=singbox_tun
# COCKPIT_VPN_PROBE=1.1.1.1

# ── Пути «мозга» (фабрика/конвейер) ───────────────────────────────────────
# Дефолты: $HOME/.factory/state, встроенный <корень cockpit>/engine и локальный profiles/.
# /profiles/ целиком игнорируется Git и переносится/резервируется отдельно.
# Внешний checkout движка/профилей поддерживается только явными абсолютными путями.
# FACTORY_STATE_DIR=/home/<юзер>/.factory/state
# FACTORY_HOME=/absolute/path/to/another/engine
# FACTORY_PROFILES_DIR=/absolute/path/to/profiles
# COCKPIT_FACTORY_BIN=/absolute/path/to/another/engine/bin/factory
# FACTORY_CONFIG_ROOT=/home/<юзер>/.factory/config
# Профиль запуска на конвейер (пусто → определяется по данным).
COCKPIT_FACTORY_PROFILE=

# ── Исполнители (ИИ) ──────────────────────────────────────────────────────
# Бинари CLI в PATH. Нет бинаря → провайдер показывается «недоступен», а не падает.
COCKPIT_CLAUDE_BIN=claude
COCKPIT_CODEX_BIN=codex
# Авторизация Claude: пусто → берётся хостовая (claude login) либо ANTHROPIC_API_KEY отсюда.
# Свой ключ кокпита лучше задавать в UI — он ляжет в .state/claude-auth.json (0600), а не сюда.
# ANTHROPIC_API_KEY=
# COCKPIT_CLAUDE_AUTH_PATH=<абсолютный путь>/server/.state/claude-auth.json
# Codex: список моделей тянется platform-API и требует именно ключ (OAuth-токен codex не годится).
# OPENAI_API_KEY=
# Автообнаружение новых моделей Anthropic ХОСТОВЫМ OAuth-токеном claude CLI (~/.claude/.credentials.json).
# Только явный опт-ин «1»: токен выдан для CLI, дёргать им API без спроса нельзя.
# ANTHROPIC_API_KEY выше работает и без этого флага.
# COCKPIT_DISCOVER_WITH_CLI_TOKEN=0
# ── Триаж задач (разведка кода headless-агентом, без стенда) ───────────────
# COCKPIT_ANALYSIS_MODEL=sonnet
# Параллельных оценок: с одним воркером очередь в 70 задач — это часы ожидания.
# COCKPIT_ANALYSIS_CONCURRENCY=2
# COCKPIT_ANALYSIS_TIMEOUT_MS=1200000
# COCKPIT_ANALYSIS_DIR=/home/<юзер>/.factory/analysis

# ── Автоматическое ревью GitHub PR ───────────────────────────────────────
# Снимки, рекомендации и отдельные review-runs. Обычные t<TASK>.pipeline не затрагиваются.
# COCKPIT_REVIEWS_DIR=<абсолютный путь>/server/.state/reviews
# Период фонового опроса и окно объединения пришедших подряд комментариев.
# COCKPIT_REVIEW_POLL_MS=300000
# COCKPIT_REVIEW_DEBOUNCE_MS=45000
# Read-only анализатор и отдельный переводчик. По умолчанию — Codex, одна job за раз.
# COCKPIT_REVIEW_PROVIDER=codex
# COCKPIT_REVIEW_MODEL=gpt-5.6-sol
# COCKPIT_REVIEW_EFFORT=high
# COCKPIT_REVIEW_ANALYSIS_CONCURRENCY=1
# COCKPIT_REVIEW_ANALYSIS_TIMEOUT_MS=1800000

# ── Битрикс24 (креды задаются из «Настроек», живут в .state) ──────────────
COCKPIT_B24_BASE_URL=
# B24_COOKIE_PATH=<абсолютный путь>/server/.state/b24-cookies.json
# B24_CREDS_PATH=<абсолютный путь>/server/.state/b24-creds.json

# ── Стенды / медиа ────────────────────────────────────────────────────────
# Команда сноса стенда задачи; {task} подставляется. Пусто → кнопка «снести стенд» неактивна.
COCKPIT_SANDBOX_DOWN_CMD=
# Python из venv с faster-whisper — распознавание речи: раздел «Видео» И диктовка в чате.
# Пусто → и то, и другое отвечает «не настроено» (проверка: GET /api/media/doctor).
# Рекомендуемый путь: <корень>/server/.state/media-venv/bin/python (runtime, не коммитится).
# Создание: python3 -m venv server/.state/media-venv
#           server/.state/media-venv/bin/pip install -r server/requirements-media.txt
COCKPIT_MEDIA_PYTHON=
# COCKPIT_MEDIA_DIR=<абсолютный путь>/server/.state/media

# ── Фронт (VITE_*, читаются Vite при сборке web; envDir = корень репо) ─────
# Уезжают в ПУБЛИЧНЫЙ бандл — секретам здесь не место (см. историю COCKPIT_TOKEN выше).
# base URL «мозга». Пусто = тот же origin (фронт отдаёт сам сервер). Задел «сменный мозг».
# Если задан ДРУГОЙ origin — вход по cookie требует CORS с credentials, учти при настройке.
VITE_BRAIN_URL=

# ── Чего здесь быть не должно ─────────────────────────────────────────────
# • COCKPIT_CHAT_KEY, COCKPIT_INTERNAL, COCKPIT_PERM_URL — служебные: сервер сам передаёт их
#   подпроцессу разрешений (lib/chat/permission-mcp.js). Заданные снаружи — только помешают.
# • COCKPIT_URL, COCKPIT_TOKEN — это переменные CLI `bin/b24`, а он .env не читает (токен берёт
#   из server/.state/cli-token). Задавать их надо в окружении вызова, а не тут.
# • Остальные пути (chats/, agents/, routes/, plugins/, web/dist, файлы .state, transcribe.py)
#   переопределяются переменными COCKPIT_*_DIR/_PATH — полный список с дефолтами в
#   server/src/config.js. В обычной жизни не трогаются, поэтому не перечислены.
