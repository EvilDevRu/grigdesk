<?xml version="1.0" encoding="utf-8"?>
<!-- Probe-overlay 3a: отдельная точка входа и локальный сервер только для probe. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <activity android:name="local.grigdesk.client.MainActivity" android:exported="false"
            tools:node="replace" />
        <activity
            android:name="local.grigdesk.client.ProbeLauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="local.grigdesk.client.LocalServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
