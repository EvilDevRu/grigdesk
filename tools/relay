#!/usr/bin/env bash
# Общая сборка публикует нативный relay рядом с остальными утилитами.
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
if [[ $# != 1 || $1 != build ]]; then
  printf '%s\n' 'Использование: tools/relay build' >&2
  exit 2
fi

exec bash "$ROOT/tools/build-go-utilities.sh" "$ROOT/bin/utilities"
