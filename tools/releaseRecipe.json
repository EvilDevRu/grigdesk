{
  "format": 1,
  "stages": [
    {
      "id": "bundle-install",
      "group": "prepare-build",
      "argv": [
        "bash",
        "-c",
        "npm --prefix server ci && npm --prefix web ci && npm --prefix mobile ci && npm --prefix deepseek ci && npm --prefix desktop ci --ignore-scripts && node desktop/node_modules/esbuild/install.js"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "server-install",
      "group": "prepare-server",
      "argv": [
        "npm",
        "--prefix",
        "server",
        "ci"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "qwen-test-cli",
      "group": "prepare-server",
      "argv": [
        "npm",
        "--prefix",
        "tests/fixtures/qwen-cli",
        "ci",
        "--no-audit",
        "--no-fund"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "web-install",
      "group": "prepare-web",
      "argv": [
        "npm",
        "--prefix",
        "web",
        "ci"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "mobile-install",
      "group": "prepare-web",
      "argv": [
        "npm",
        "--prefix",
        "mobile",
        "ci"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "deepseek-runtime",
      "group": "prepare-build",
      "argv": [
        "bash",
        "-c",
        "npm --prefix deepseek run prepare:runtime -- --node-cache-dir \"$GRIGDESK_DEEPSEEK_NODE_CACHE\""
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "deepseek-vendor",
      "group": "prepare-build",
      "argv": [
        "bash",
        "-c",
        "node --input-type=module <<'NODE'\nimport { materializeDeepSeekSnapshot } from './deepseek/scripts/deepseekVendorManifest.ts';\nawait materializeDeepSeekSnapshot('./deepseek/vendor/deepseek-harness');\nNODE"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "server-browser",
      "group": "prepare-build",
      "argv": [
        "node",
        "server/node_modules/playwright-core/cli.js",
        "install",
        "chromium"
      ],
      "needs": [
        "bundle-install"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "go-binaries",
      "group": "prepare-build",
      "argv": [
        "bash",
        "-c",
        "bash tools/build-go-utilities.sh \"$PWD/bin/utilities\" && bash tools/build-factory.sh \"$PWD/engine/bin\" && mkdir -p \"$PWD/bin\" && cp \"$PWD/engine/bin/factory\" \"$PWD/bin/factory\""
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "server-environment",
      "group": "prepare-server",
      "needs": [
        "prepare-build"
      ],
      "argv": [
        "node",
        "tools/releaseEnvironment.mts",
        "--require-ready",
        "--require-user-manager"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "deepseek-warmup",
      "group": "server",
      "needs": [
        "prepare-build",
        "server-environment"
      ],
      "argv": [
        "bash",
        "-c",
        "NODE_TEST_MAX_RSS_MB=4096 bash tests/run-node-tests-safe.sh tests/helpers/deepseekBinary.mts --prepare-suite && NODE_TEST_MAX_RSS_MB=4096 exec bash tests/run-node-tests-safe.sh tests/helpers/deepseekRuntimeArtifact.mts"
      ],
      "timeoutMs": 1800000,
      "memory": {
        "rssMb": 4096,
        "heapMb": 1024,
        "concurrency": 2
      }
    },
    {
      "id": "cache-root-check",
      "group": "server",
      "needs": [
        "prepare-build",
        "server-environment",
        "deepseek-warmup"
      ],
      "argv": [
        "bash",
        "-c",
        "NODE_TEST_MAX_RSS_MB=4096 exec bash tests/run-node-tests-safe.sh --test tests/server/deepseek-binary-cache-root.test.js"
      ],
      "timeoutMs": 1800000,
      "memory": {
        "rssMb": 4096,
        "heapMb": 1024,
        "concurrency": 2
      }
    },
    {
      "id": "server-tests",
      "group": "server",
      "needs": [
        "prepare-server",
        "prepare-build",
        "server-environment",
        "deepseek-warmup",
        "cache-root-check"
      ],
      "argv": [
        "bash",
        "tools/ci/run-release-server-tests.sh"
      ],
      "env": {
        "NODE_OPTIONS": "--test-reporter=tap"
      },
      "timeoutMs": 14400000,
      "memory": {
        "rssMb": 4096,
        "heapMb": 1024,
        "concurrency": 2
      }
    },
    {
      "id": "shared-tests",
      "group": "server",
      "needs": [
        "prepare-server",
        "prepare-build",
        "server-environment"
      ],
      "argv": [
        "bash",
        "-c",
        "NODE_TEST_MAX_RSS_MB=4096 exec bash tests/run-node-tests-safe.sh --test --test-concurrency=2 tests/shared/*.test.mts"
      ],
      "timeoutMs": 1800000,
      "memory": {
        "rssMb": 4096,
        "heapMb": 1024,
        "concurrency": 2
      }
    },
    {
      "id": "guide-tests",
      "group": "server",
      "needs": [
        "prepare-server",
        "prepare-build",
        "server-environment"
      ],
      "argv": [
        "bash",
        "-c",
        "NODE_TEST_MAX_RSS_MB=4096 exec bash tests/run-node-tests-safe.sh --test --test-concurrency=2 tests/docs/help-guide.test.mts tests/docs/markdown-links.test.mjs tests/docs/release-script-contract.test.mts"
      ],
      "timeoutMs": 1800000,
      "memory": {
        "rssMb": 4096,
        "heapMb": 1024,
        "concurrency": 2
      }
    },
    {
      "id": "factory-go-tests",
      "group": "server",
      "needs": [
        "prepare-build",
        "server-environment"
      ],
      "argv": [
        "env",
        "GOTOOLCHAIN=local",
        "GOWORK=off",
        "go",
        "test",
        "-count=1",
        "-p=2",
        "./utilities/factory/..."
      ],
      "timeoutMs": 1800000,
      "memory": {
        "rssMb": 4096,
        "heapMb": 1024,
        "concurrency": 2
      }
    },
    {
      "id": "voice-tests",
      "group": "server",
      "needs": [
        "prepare-build",
        "server-environment"
      ],
      "argv": [
        "go",
        "test",
        "-count=1",
        "-p=2",
        "./utilities/voice/...",
        "./utilities/tracker/...",
        "./utilities/pipeline/..."
      ],
      "timeoutMs": 1800000,
      "memory": {
        "rssMb": 4096,
        "heapMb": 1024,
        "concurrency": 2
      }
    },
    {
      "id": "go-utilities-behavior",
      "group": "server",
      "needs": [
        "prepare-build",
        "server-environment"
      ],
      "argv": [
        "bash",
        "tests/run-go-utilities.sh"
      ],
      "timeoutMs": 1800000,
      "memory": {
        "rssMb": 4096,
        "heapMb": 1024,
        "concurrency": 2
      }
    },
    {
      "id": "routes-tests",
      "group": "server",
      "needs": [
        "prepare-build",
        "server-environment"
      ],
      "argv": [
        "go",
        "test",
        "-count=1",
        "-p=2",
        "./utilities/routes/...",
        "./utilities/relay/...",
        "./utilities/ctl/...",
        "./utilities/maintenance/...",
        "./utilities/internal/..."
      ],
      "timeoutMs": 1800000,
      "memory": {
        "rssMb": 4096,
        "heapMb": 1024,
        "concurrency": 2
      }
    },
    {
      "id": "installer-tests",
      "group": "server",
      "needs": [
        "prepare-build",
        "server-environment"
      ],
      "argv": [
        "bash",
        "-c",
        "NODE_TEST_MAX_RSS_MB=4096 exec bash tests/run-node-tests-safe.sh --test --test-concurrency=2 tests/server/install-bootstrap.test.mts tests/server/install-bootstrap-dialog.test.mts tests/server/install-online.test.mts tests/server/installation-target.test.mts tests/server/verify-installation.test.mts tests/server/release-pipeline.test.mts tests/server/release-environment.test.mts tests/server/distribution-snapshot.test.mts tests/server/distribution-trust.test.mts tests/server/release-publish-command.test.mts tests/server/distribution-build.test.mts tests/server/verify-built-release.test.mts tests/server/linux-offline-package.test.mts tests/server/deb-package.test.js tests/server/stable-platform-release.test.mts tests/server/prepare-github-release.test.mts"
      ],
      "timeoutMs": 1800000,
      "memory": {
        "rssMb": 4096,
        "heapMb": 1024,
        "concurrency": 2
      }
    },
    {
      "id": "distribution-cli-tests",
      "group": "server",
      "needs": [
        "prepare-build",
        "server-environment"
      ],
      "argv": [
        "bash",
        "tests/run-node-tests-safe.sh",
        "--test",
        "--test-concurrency=2",
        "tests/cli/distribution-menu.test.mts",
        "tests/cli/entry.test.mts"
      ],
      "env": {
        "NODE_TEST_MAX_RSS_MB": "4096"
      },
      "timeoutMs": 1800000,
      "memory": {
        "rssMb": 4096,
        "heapMb": 1024,
        "concurrency": 2
      }
    },
    {
      "id": "web-environment",
      "group": "prepare-web",
      "needs": [
        "prepare-build"
      ],
      "argv": [
        "node",
        "tools/releaseEnvironment.mts",
        "--require-ready"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "web-factory",
      "group": "prepare-web",
      "needs": [
        "prepare-build"
      ],
      "argv": [
        "node",
        "server/scripts/buildFactory.mjs"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "web-tests",
      "group": "web",
      "needs": [
        "prepare-web",
        "prepare-build",
        "web-environment",
        "web-factory"
      ],
      "argv": [
        "npm",
        "--prefix",
        "web",
        "test"
      ],
      "env": {
        "NODE_OPTIONS": "--test-reporter=tap"
      },
      "timeoutMs": 5400000,
      "memory": {
        "rssMb": 4096,
        "heapMb": 1024,
        "concurrency": 2
      }
    },
    {
      "id": "web-build",
      "group": "build",
      "needs": [
        "server",
        "web"
      ],
      "argv": [
        "npm",
        "--prefix",
        "web",
        "run",
        "build"
      ],
      "timeoutMs": 7200000
    },
    {
      "id": "mac-install",
      "group": "mac-prepare",
      "argv": [
        "bash",
        "-c",
        "npm --prefix server ci && npm --prefix web ci && npm --prefix mobile ci && npm --prefix deepseek ci && npm --prefix desktop ci --ignore-scripts && node desktop/node_modules/esbuild/install.js"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "mac-deepseek",
      "group": "mac-prepare",
      "argv": [
        "bash",
        "-c",
        "npm --prefix deepseek run prepare:runtime -- --node-cache-dir \"$GRIGDESK_DEEPSEEK_NODE_CACHE\""
      ],
      "timeoutMs": 1800000,
      "needs": [
        "mac-install"
      ]
    },
    {
      "id": "mac-deepseek-vendor",
      "group": "mac-prepare",
      "argv": [
        "bash",
        "-c",
        "node --input-type=module <<'NODE'\nimport { materializeDeepSeekSnapshot } from './deepseek/scripts/deepseekVendorManifest.ts';\nawait materializeDeepSeekSnapshot('./deepseek/vendor/deepseek-harness');\nNODE"
      ],
      "timeoutMs": 1800000,
      "needs": [
        "mac-install"
      ]
    },
    {
      "id": "mac-browser",
      "group": "mac-prepare",
      "argv": [
        "node",
        "server/node_modules/playwright-core/cli.js",
        "install",
        "chromium"
      ],
      "needs": [
        "mac-install"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "mac-env",
      "group": "mac-prepare",
      "needs": [
        "mac-deepseek",
        "mac-deepseek-vendor",
        "mac-browser"
      ],
      "argv": [
        "node",
        "tools/releaseEnvironment.mts",
        "--require-native-ready"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "mac-server-typecheck",
      "group": "mac-check",
      "needs": [
        "mac-prepare"
      ],
      "argv": [
        "npm",
        "--prefix",
        "server",
        "run",
        "typecheck"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "mac-web-tests",
      "group": "mac-check",
      "needs": [
        "mac-prepare"
      ],
      "argv": [
        "npm",
        "--prefix",
        "web",
        "test"
      ],
      "env": {
        "NODE_OPTIONS": "--test-reporter=tap"
      },
      "timeoutMs": 5400000,
      "memory": {
        "rssMb": 4096,
        "heapMb": 1024,
        "concurrency": 2
      }
    },
    {
      "id": "mac-shared-contracts",
      "group": "mac-check",
      "needs": [
        "mac-prepare"
      ],
      "argv": [
        "bash",
        "tests/run-node-tests-safe.sh",
        "--test",
        "--test-concurrency=2",
        "tests/shared/release-channel-contracts.test.mts",
        "tests/shared/release-compatibility.test.mts",
        "tests/server/release-platform.test.mts",
        "tests/server/maintenance-runtime-info.test.mts",
        "tests/server/release-desktop-build.test.mts",
        "tests/server/macos-app-archive.test.mts",
        "tests/server/macos-launchd.test.mts",
        "tests/desktop/exit-controller.test.js",
        "tests/server/macos-runtime-context.test.mts",
        "tests/server/runtime-pin-evidence.test.mts",
        "tests/server/platform-candidate.test.mts"
      ],
      "timeoutMs": 1800000,
      "memory": {
        "rssMb": 4096,
        "heapMb": 1024,
        "concurrency": 2
      }
    },
    {
      "id": "mac-doctor-contract",
      "group": "mac-check",
      "needs": [
        "mac-prepare"
      ],
      "argv": [
        "bash",
        "tests/run-node-tests-safe.sh",
        "--test",
        "--test-concurrency=2",
        "--test-name-pattern=^ENVIRONMENT-DARWIN",
        "tests/server/release-environment.test.mts"
      ],
      "timeoutMs": 1800000,
      "memory": {
        "rssMb": 4096,
        "heapMb": 1024,
        "concurrency": 2
      }
    },
    {
      "id": "mac-sea-native",
      "group": "mac-check",
      "needs": [
        "mac-prepare"
      ],
      "argv": [
        "bash",
        "tests/run-node-tests-safe.sh",
        "--test",
        "--test-concurrency=1",
        "tests/server/macos-sea-build.e2e.mts"
      ],
      "timeoutMs": 3600000,
      "memory": {
        "rssMb": 4096,
        "heapMb": 1024,
        "concurrency": 1
      }
    },
    {
      "id": "mac-dist-contract",
      "group": "mac-check",
      "needs": [
        "mac-prepare"
      ],
      "argv": [
        "bash",
        "tests/run-node-tests-safe.sh",
        "--test",
        "tests/server/macos-dist-build.e2e.mts"
      ],
      "timeoutMs": 1800000,
      "memory": {
        "rssMb": 4096,
        "heapMb": 1024,
        "concurrency": 1
      }
    },
    {
      "id": "mac-runtime-pin-source",
      "group": "mac-check",
      "needs": [
        "mac-prepare"
      ],
      "argv": [
        "node",
        "tools/ci/run-macos-runtime-pin-tests.mts",
        "source"
      ],
      "timeoutMs": 3600000
    },
    {
      "id": "mac-web-build",
      "group": "mac-build",
      "needs": [
        "mac-check"
      ],
      "argv": [
        "npm",
        "--prefix",
        "web",
        "run",
        "build"
      ],
      "timeoutMs": 7200000
    },
    {
      "id": "candidate-release-package",
      "group": "candidate-build",
      "needs": [
        "web-build"
      ],
      "argv": [
        "node",
        "tools/ci/stage-release-bundle.mts"
      ],
      "timeoutMs": 7200000
    },
    {
      "id": "mac-release-package",
      "group": "mac-build",
      "needs": [
        "mac-web-build"
      ],
      "argv": [
        "node",
        "tools/ci/stage-release-bundle.mts"
      ],
      "timeoutMs": 7200000
    }
  ]
}
