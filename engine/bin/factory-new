#!/usr/bin/env bash
# Скелет профиля для НОВОГО проекта: factory-new <имя> [корень проекта]
# Создаёт изолированный каталог профиля по контракту, затем гоняет проверки.
# Дальше остаётся заполнить помеченные TODO — см. docs/engine/NEW-PROJECT.md.
set -uo pipefail
FACTORY_HOME="$(cd "$(dirname "$0")/.." && pwd)"
export FACTORY_PROFILES_DIR="${FACTORY_PROFILES_DIR:-$(cd "$FACTORY_HOME/.." && pwd)/profiles}"

NAME="${1:-}"; ROOT="${2:-}"
[[ -n "$NAME" ]] || { echo "использование: factory-new <имя-профиля> [корень проекта]"; exit 1; }
[[ "$NAME" =~ ^[a-z][a-z0-9_-]*$ ]] || { echo "имя профиля: строчные латинские буквы, цифры, - и _"; exit 1; }

PROFILE_DIR="$FACTORY_PROFILES_DIR/$NAME"
PF="$PROFILE_DIR/profile.sh"
ENVF="$PROFILE_DIR/dashboard.env"
GRAPHF="$PROFILE_DIR/graph.json"
RUNNERSF="$PROFILE_DIR/runners.env"
[[ -e "$PF" || -e "$RUNNERSF" ]] && { echo "профиль уже есть: $PF"; exit 1; }
ROOT="${ROOT:-/home/$USER/Workspace/$NAME}"
mkdir -p "$PROFILE_DIR"

# Этапы скелета задаются ОДИН раз: отсюда их берут и профиль, и схема графа.
# Разъедутся — кокпит нарисует узлы, которых в маршруте нет, и наоборот
# (ровно это ловит tests/engine/routes-sync.py).
SKEL_STAGES=(SCOUT BUILD REVIEW GATE_ACCEPT)

cat > "$PF" <<EOF
#!/usr/bin/env bash
# Профиль проекта ${NAME^^} для движка фабрики (контракт: docs/engine/PROFILE-CONTRACT.md).
# Заполни все TODO и прогони: bin/factory-check ${NAME}

PROFILE_NAME="${NAME}"
${NAME^^}_ROOT="${ROOT}"
PROFILE_AGENT_CWD="\$${NAME^^}_ROOT"      # рабочий каталог агента (всё внутри доступно)
# Каталоги ВНЕ cwd, куда агент обязан писать (worktree, соседние репозитории). Через пробел.
PROFILE_AGENT_DIRS=""
# Команды сверх личных настроек пользователя, например запуск тестов в контейнере:
# PROFILE_AGENT_ALLOW=("Bash(docker exec ${NAME}-app:*)")

# TODO: чем живёт проект — стек, где что лежит, чем проверять результат, ЗАПРЕТЫ.
# Этот текст уходит в КАЖДЫЙ промпт: пиши то, без чего агент наделает глупостей.
PROFILE_CTX="TODO: стек и правила проекта ${NAME}."

# --- маршруты: имя → этапы. Этапы придумывает проект, движок их не знает.
# Обязателен ровно один общий контракт: этапы GATE_* — это ворота человека, движок ждёт
# решения на дашборде. Всё остальное — обычные этапы, их выполняет агент.
# SHIP в списке НЕТ намеренно: отгрузку движок гоняет сам после утверждённой приёмки
# (промпт SHIP ниже он всё равно спросит у профиля). То же с RETRO. А DEMO — вообще не этап
# конвейера: демо снимается отдельным прогоном \`factory <TASK> demo\` по кнопке плагина.
# (бэктики выше экранированы: heredoc без кавычек ИСПОЛНЯЕТ их как команду — при генерации
# скелета это давало «TASK: Нет такого файла» и дырку в комментарии вместо текста)
# Меняешь состав — поправь и profiles/${NAME}/graph.json (узлы схемы обязаны совпадать).
PROFILE_ROUTE_STAGES_dev=(${SKEL_STAGES[*]})

# --- стенд проекта ---
# Скрипты подъёма/сноса клади рядом с profile.sh и зови отсюда: провижн — часть профиля,
# а не проекта (в проекте рядом с ними заводятся копии движка со своим состоянием).
profile_sandbox_up()     { :; }            # TODO: поднять стенд (или ничего, если он общий)
profile_sandbox_down()   { :; }            # TODO: снести стенд после приёмки
profile_sandbox_exists() { echo 1; }       # непусто = стенд уже есть, поднимать не надо

# Занятость слотов стенда — нужна, ТОЛЬКО если стендов несколько и индекс (порты/IP/базы)
# резервирует внешний распределитель (кокпит) через \`factory slots --profile ${NAME}\`.
# Считать обязан тот же код, что и подъём стенда: два счётчика разойдутся — две задачи
# возьмут один индекс, и вторая умрёт на «Address already in use».
# profile_slots() {
#   echo "RANGE 0 5"
#   echo "USED 2 t1234 task"     # <k> <кто занял> <task|port|ip>
# }

# --- что показывать кокпиту (движок это не использует) ---
# PROFILE_TRIAGE_REPOS="be:${ROOT} fe:${ROOT}"   # префикс:путь — по префиксам считается протухание анализа
# PROFILE_TRIAGE_MARKERS="TODO: что в этом проекте дорого сломать — по строке на маркер риска"
# PROFILE_ARCHIVE_ON_FINISH=1                    # карточка после отгрузки не нужна — движок сам архивирует

# --- бюджет времени этапа (мин): ориентир ГЛУБИНЫ для агента ---
# Без него агент копает, пока не упрётся в таймаут. Цель — этап 5-10 минут; больше ставь только
# там, где этого требует природа работы (прогон на живом стенде, правка кода до зелёных тестов).
profile_stage_budget() {
  case "\$1" in
    SCOUT) echo 8 ;;
    BUILD) echo 20 ;;
    REVIEW) echo 8 ;;
    SHIP) echo 6 ;;
    *) echo '' ;;
  esac
}

# --- лимит времени этапа (сек): страховка от вечного агента, пусто = общий по умолчанию ---
# Убитый по таймауту агент теряет ВСЮ работу этапа, поэтому длинным этапам давай запас.
profile_stage_timeout() {
  case "\$1" in
    BUILD) echo 3600 ;;
    *) echo '' ;;
  esac
}

# --- веер субагентов: как этап делится на параллельную работу ---
# Два режима:
#   AUTO <min>-<max> + подсказка — агент САМ строит карту под конкретную задачу и делит её
#                                  (для разведки и ревью это лучше: состав работы каждый раз разный);
#   перечисление зон, по строке на зону — фиксированное деление, когда состав известен заранее.
# НЕ объявляй веер там, где работа последовательна по природе: прогон на одном стенде и замеры
# (параллельная нагрузка исказит цифры), правка кода (агенты подерутся за файлы), сведение
# результатов воедино (это по определению один агент).
profile_stage_fanout() {
  case "\$1" in
    SCOUT) cat <<'ZONES'
AUTO 3-8
TODO: подскажи, что считать зоной в этом проекте (подсистемы, слои, части пайплайна).
Пустых зон не создавать — лучше меньше, но содержательных.
ZONES
;;
    REVIEW) cat <<'ZONES'
AUTO 3-6
TODO: дели по РЕАЛЬНОМУ диффу; перечисли линзы, которые обязательно закрыть в этом проекте.
ZONES
;;
    *) echo '' ;;
  esac
}

# --- промпт этапа: что именно делать ---
# Точные run-scoped stage-result/stage-progress команды движок добавляет сам.
profile_stage_prompt() {
  local t=\$1 stage=\$2
  case "\$stage" in
    SCOUT) cat <<PROMPT
TODO: разведка. Найди места правки, сохрани находки в \$STATE_DIR/t\$t.recon.md.
Опубликуй ROUTE=dev через добавленную stage-progress команду и заверши stage-result done.
PROMPT
;;
    BUILD) cat <<PROMPT
TODO: сделать работу по находкам разведки.
Заверши добавленной stage-result командой: done либо failed с причиной.
PROMPT
;;
    REVIEW) cat <<PROMPT
TODO: адверсариальное ревью изменений. Нашёл дефекты — stage-result failed с причиной.
Чисто — stage-result done.
PROMPT
;;
    SHIP) cat <<PROMPT
TODO: публикация результата (коммит/PR/уведомление). В конце: stage-result done.
PROMPT
;;
  esac
}
EOF

cat > "$RUNNERSF" <<EOF
RUNNERS_SCHEMA=1
CONFIG_REVISION=1
RUNNERS_COVERAGE=required
PROJECT_RUNNER_PRIMARY=claude
PROJECT_RUNNER_FAILOVER=codex
MODEL_DEFAULT_CLAUDE_FAMILY=opus
MODEL_DEFAULT_CLAUDE_VERSION=latest
MODEL_DEFAULT_CLAUDE_VARIANT=auto
MODEL_DEFAULT_CLAUDE_EFFORT=max
MODEL_DEFAULT_CODEX_FAMILY=sol
MODEL_DEFAULT_CODEX_VERSION=latest
MODEL_DEFAULT_CODEX_VARIANT=auto
MODEL_DEFAULT_CODEX_EFFORT=xhigh
MODEL_SCOUT_CLAUDE_FAMILY=sonnet
MODEL_SCOUT_CLAUDE_EFFORT=high
MODEL_SCOUT_CODEX_EFFORT=high
MODEL_SHIP_CLAUDE_FAMILY=sonnet
MODEL_SHIP_CLAUDE_EFFORT=high
MODEL_SHIP_CODEX_EFFORT=high
EOF

cat > "$ENVF" <<EOF
# Проектные параметры дашборда для профиля ${NAME}.
# ВАЖНО: значения с пробелами — в кавычках (файл читается через \`set -a; source\`).
FACTORY_BE_ROOT=${ROOT}
FACTORY_FE_ROOT=${ROOT}
FACTORY_MYSQL_CONTAINER=
FACTORY_REDIS_CONTAINER=
FACTORY_SANDBOX_PREFIX=${NAME}
# Контейнер стенда: с {task} — песочница на задачу, без него — общий постоянный стенд.
FACTORY_STAND_CONTAINER=${NAME}
FACTORY_STAND_URL=
# Трекер задач (необязателен). Без него название прогона берётся из текста тикета.
FACTORY_TIMER_CMD=
EOF

# --- схема конвейера ------------------------------------------------------------------
# Кокпит (:8140) НЕ умеет автосхему: профиль без graph.json у него просто не показывается —
# запрос графа падает, карточка молча отфильтровывается, и человек считает, что задача
# не запустилась. Поэтому скелет кладёт готовую схему сразу: узлы = этапы маршрута,
# раскладка змейкой, дальше человек двигает координаты под себя.
# Раскладку держит factory-graph-new (одна реализация на всех): после правки маршрутов
# профиля схему пересобирают тем же скриптом с --force.
python3 "$FACTORY_HOME/bin/factory-graph-new" "$NAME" >/dev/null

chmod +x "$PF" 2>/dev/null
echo "создано:"
echo "  $PF"
echo "  $RUNNERSF"
echo "  $ENVF"
echo "  $GRAPHF"
echo
echo "дальше: заполни TODO (docs/engine/NEW-PROJECT.md), затем — engine/bin/factory-check $NAME"
echo
bash "$FACTORY_HOME/bin/factory-check" "$NAME" --quick
