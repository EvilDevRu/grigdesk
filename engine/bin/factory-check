#!/usr/bin/env bash
# Все проверки профиля в одном месте: factory-check [профиль ...] [--quick] [--host-preflight]
#   --quick — изолированный временный state, без запуска Cockpit и без запросов к моделям.
#   --host-preflight — metadata-only проверка CLI/каталогов; требует RUN_HOST_PREFLIGHT=1.
# Ноль на выходе = профиль готов вести задачи.
set -uo pipefail
FACTORY_HOME="$(cd "$(dirname "$0")/.." && pwd)"
export FACTORY_PROFILES_DIR="${FACTORY_PROFILES_DIR:-$(cd "$FACTORY_HOME/.." && pwd)/profiles}"
FACTORY_TESTS_HOME="${FACTORY_TESTS_HOME:-$FACTORY_HOME/../tests/engine}"
if [[ ! -d "$FACTORY_TESTS_HOME" ]]; then
  echo "не найдены тесты движка: $FACTORY_TESTS_HOME" >&2
  exit 2
fi
FACTORY_TESTS_HOME="$(cd "$FACTORY_TESTS_HOME" && pwd)"
# shellcheck disable=SC1091
source "$FACTORY_HOME/lib/profile-config.sh"

QUICK=0; HOST_PREFLIGHT=0; PROFILES=()
for a in "$@"; do
  case "$a" in
    --quick) QUICK=1 ;;
    --host-preflight) HOST_PREFLIGHT=1 ;;
    *) PROFILES+=("$a") ;;
  esac
done
FACTORY_HOST_STATE="${FACTORY_STATE:-${STATE_DIR:-${HOME:-/tmp}/.factory/state}}"

FACTORY_CHECK_ROOT=""
_factory_check_cleanup() {
  case "$FACTORY_CHECK_ROOT" in
    /tmp/factory-check.*)
      [[ -d "$FACTORY_CHECK_ROOT" ]] && rm -rf -- "$FACTORY_CHECK_ROOT"
      ;;
  esac
}
trap _factory_check_cleanup EXIT INT TERM

if (( QUICK == 1 )); then
  FACTORY_CHECK_ROOT=$(mktemp -d /tmp/factory-check.XXXXXX)
  export FACTORY_STATE="$FACTORY_CHECK_ROOT/state"
  export STATE_DIR="$FACTORY_STATE"
  export FACTORY_CONFIG_ROOT="$FACTORY_CHECK_ROOT/config"
  export XDG_CONFIG_HOME="$FACTORY_CHECK_ROOT/xdg-config"
  export XDG_STATE_HOME="$FACTORY_CHECK_ROOT/xdg-state"
  export XDG_CACHE_HOME="$FACTORY_CHECK_ROOT/xdg-cache"
  mkdir -p "$FACTORY_STATE" "$FACTORY_CONFIG_ROOT" "$XDG_CONFIG_HOME" \
    "$XDG_STATE_HOME" "$XDG_CACHE_HOME"
else
  export FACTORY_STATE="${FACTORY_STATE:-${STATE_DIR:-$HOME/.factory/state}}"
  export STATE_DIR="${STATE_DIR:-$FACTORY_STATE}"
fi

if [[ "${FACTORY_TESTING:-0}" == 1 && -n "${FACTORY_CHECK_STATE_REPORT:-}" ]]; then
  printf '%s\n' "$FACTORY_STATE" >"$FACTORY_CHECK_STATE_REPORT"
fi
if [[ "${FACTORY_TESTING:-0}" == 1 && "${FACTORY_CHECK_ONLY_ISOLATION:-0}" == 1 ]]; then
  exit 0
fi

if [[ ${#PROFILES[@]} -eq 0 ]]; then
  mapfile -t PROFILES < <(
    find "$FACTORY_PROFILES_DIR" -mindepth 2 -maxdepth 2 -type f -name profile.sh \
      -printf '%h\n' 2>/dev/null | xargs -r -n1 basename | sort
  )
fi

RC=0
for prof in "${PROFILES[@]}"; do
  echo "── $prof ───────────────────────────────────────────"

  # 1. Контракт: обязательные переменные и хуки на месте?
  miss=$(bash -c "
    source '$FACTORY_PROFILES_DIR/${prof}/profile.sh' 2>/dev/null
    for v in PROFILE_NAME PROFILE_CTX PROFILE_AGENT_CWD; do
      [[ -n \"\${!v:-}\" ]] || echo \"нет переменной \$v\"
    done
    compgen -A variable | grep -q '^PROFILE_ROUTE_STAGES_' || echo 'нет ни одного PROFILE_ROUTE_STAGES_<маршрут>'
    for f in profile_sandbox_up profile_sandbox_down profile_sandbox_exists profile_stage_prompt; do
      declare -F \$f >/dev/null || echo \"нет функции \$f\"
    done
  ")
  if [[ -n "$miss" ]]; then
    echo "$miss" | sed 's/^/✗ контракт: /'
    RC=1
  else
    echo "✓ контракт: переменные и хуки на месте"
  fi

  # 1a. Контракт route v2: заявленная в graph.json capability обязывает профиль
  # реализовать все семь v2-хуков — иначе factory-v2 откажет на старте.
  graph_json="$FACTORY_PROFILES_DIR/${prof}/graph.json"
  if [[ -f "$graph_json" ]] && python3 - "$graph_json" <<'PY' 2>/dev/null
import json
import sys
data = json.load(open(sys.argv[1], encoding="utf-8"))
caps = data.get("capabilities") if isinstance(data, dict) else None
raise SystemExit(0 if isinstance(caps, list) and "route-v2" in caps else 1)
PY
  then
    v2_miss=$(bash -c "
      source '$FACTORY_PROFILES_DIR/${prof}/profile.sh' 2>/dev/null
      for f in profile_v2_backend_source profile_v2_frontend_source \
        profile_v2_backend_worktree profile_v2_frontend_worktree \
        profile_v2_source_branch profile_v2_container profile_v2_sandbox_alive; do
        declare -F \$f >/dev/null || echo \"нет v2-хука \$f\"
      done
    ")
    if [[ -n "$v2_miss" ]]; then
      echo "$v2_miss" | sed 's/^/✗ route-v2: /'
      RC=1
    else
      echo "✓ route-v2: capability заявлена, все 7 v2-хуков на месте"
    fi

    # Форма списка изменчивых путей. Иначе ошибку видно только на живом прогоне:
    # instrumentation_tx_begin отдаст 78 уже после подъёма стенда и работы предыдущих
    # узлов, а пустой список — не отказ, а fail-closed на первом же мусоре стенда (t8165).
    vol_bad=$(bash -c "
      source '$FACTORY_PROFILES_DIR/${prof}/profile.sh' 2>/dev/null
      read -r -a globs <<<\"\${PROFILE_VOLATILE_PATHS:-}\"
      for g in \${globs[@]+\"\${globs[@]}\"}; do
        [[ \"\$g\" == /* ]] &&
          echo \"абсолютный путь \$g — глоб задаётся ОТ корня рабочего дерева\"
      done
      (( \${#globs[@]} > 0 )) ||
        echo \"⚠ PROFILE_VOLATILE_PATHS пуст: всё, что пишет сам стенд (логи, кэши, \
артефакты тестов), сторож примет за правку агента и остановит узел инструментации\"
    ")
    if [[ "$vol_bad" == *"абсолютный путь"* ]]; then
      echo "$vol_bad" | sed 's/^/✗ изменчивые пути: /'
      RC=1
    elif [[ -n "$vol_bad" ]]; then
      echo "$vol_bad"
    else
      echo "✓ изменчивые пути: список объявлен и относителен корню"
    fi
  fi

  runner_config="$FACTORY_PROFILES_DIR/${prof}/runners.env"
  if ! profile_config_validate "$runner_config"; then
    echo "✗ canonical runner config отсутствует или некорректен: $runner_config"
    RC=1
  elif [[ "$(profile_config_get "$runner_config" RUNNERS_COVERAGE)" != required ]]; then
    echo "✗ $runner_config: требуется RUNNERS_COVERAGE=required"
    RC=1
  else
    echo "✓ исполнители: canonical config обязателен и валиден"
  fi

  # 1b. Мёртвые хуки и хвост движка внутри маршрута — оба случая тихие.
  # Хвост (SHIP → RETRO) движок гоняет в bin/factory ПОСЛЕ конвейера и по своим правилам.
  # SHIP/RETRO там идемпотентны по статусу (уже `done` — хвост пропустит), поэтому в маршруте
  # они допустимы, но ТОЛЬКО после ворот приёмки: раньше ворот — это отгрузка без утверждения
  # человеком. А демо в маршруте ломается всерьёз: оно вообще не этап конвейера — снимается
  # отдельно, кнопкой плагина «Демо» в кокпите (`factory <TASK> demo`).
  extra=$(bash -c "
    source '$FACTORY_PROFILES_DIR/${prof}/profile.sh' 2>/dev/null
    for f in profile_run_id profile_report; do
      declare -F \$f >/dev/null && echo \"⚠ хук \$f мёртв: движок его не вызывает — удали, чтобы не выглядел рабочим\"
    done
    for v in \$(compgen -A variable | grep '^PROFILE_ROUTE_STAGES_'); do
      n=\"\$v[@]\"
      gate_seen=0
      for s in \${!n}; do
        case \"\$s\" in
          GATE_ACCEPT) gate_seen=1 ;;
          DEMO|DEMO_ASK|GATE_DEMO)
            echo \"✗ \$v содержит \$s — демо не этап конвейера: оно снимается по кнопке плагина «Демо» (factory <TASK> demo). В маршруте конвейер встанет на этапе, которого движок не ведёт\" ;;
          SHIP|RETRO)
            if [[ \$gate_seen -eq 0 ]]; then
              echo \"✗ \$v: \$s стоит до GATE_ACCEPT — отгрузка раньше, чем человек принял работу\"
            else
              echo \"⚠ \$v содержит \$s — его же гоняет хвост движка; повтора не будет (статус уже done), но порядок держи сам\"
            fi ;;
        esac
      done
    done
  ")
  [[ -n "$extra" ]] && echo "$extra"
  grep -q '^✗' <<<"$extra" && RC=1

  # 2. У каждого этапа маршрута есть промпт, и в нём есть команда отчёта о статусе
  bash -c "
    export STATE_DIR='$FACTORY_STATE'
    source '$FACTORY_HOME/lib/core.sh' 2>/dev/null
    source '$FACTORY_PROFILES_DIR/${prof}/profile.sh' 2>/dev/null
    bad=0
    for v in \$(compgen -A variable | grep '^PROFILE_ROUTE_STAGES_'); do
      n=\"\$v[@]\"
      for s in \${!n}; do
        [[ \"\$s\" == GATE_* ]] && continue          # ворота ждёт движок, промпт не нужен
        p=\$(profile_stage_prompt 9999 \"\$s\" 2>/dev/null)
        # Команду отчёта о статусе добавляет ядро (_stage_ctx), профилю дублировать не нужно.
        # А вот этап без задания — подозрительно: агент получит пустой промпт. Это законно
        # только если статус этапа выставляет соседний этап (у arsenkin TCRITIC ставит TESTS).
        if [[ -z \"\$p\" ]]; then
          echo \"⚠ этап \$s: нет промпта — убедись, что его статус выставляет другой этап\"
        fi
      done
    done
    [[ \$bad -eq 0 ]] && echo '✓ промпты: у всех этапов есть задание и отчёт о статусе'
    exit \$bad
  " || RC=1

  # 2b. Промпт просит параллельной работы, а веер не объявлен — просьбу агент проигнорирует
  # (проверено на задачах #8060 и #101: за 15 прогонов ни одного субагента не запущено).
  bash -c "
    export STATE_DIR='$FACTORY_STATE'
    source '$FACTORY_HOME/lib/core.sh' 2>/dev/null
    source '$FACTORY_PROFILES_DIR/${prof}/profile.sh' 2>/dev/null
    for v in \$(compgen -A variable | grep '^PROFILE_ROUTE_STAGES_'); do
      n=\"\$v[@]\"
      for s in \${!n}; do
        [[ \"\$s\" == GATE_* ]] && continue
        p=\$(profile_stage_prompt 9999 \"\$s\" 2>/dev/null)
        asks=\$(grep -ciE 'субагент|параллельн|конкурирующ' <<<\"\$p\")
        fan=0
        declare -F profile_stage_fanout >/dev/null && fan=\$(profile_stage_fanout \"\$s\" 2>/dev/null | grep -c .)
        [[ \$asks -gt 0 && \${fan:-0} -eq 0 ]] && echo \"⚠ этап \$s: промпт просит параллельной работы, но profile_stage_fanout молчит — веер не случится\"
      done
    done | sort -u
  "

  # 2c. Скорость конвейера: веер, бюджеты, модели
  bash "$FACTORY_TESTS_HOME/profile-speed.sh" "$prof"

  # 3. Доступ агента к путям (статически) + 4. соответствие схемы этапам
  python3 "$FACTORY_TESTS_HOME/profile-access.py" "$prof" || RC=1
  python3 "$FACTORY_TESTS_HOME/routes-sync.py" "$prof" || RC=1

  if (( HOST_PREFLIGHT == 1 )); then
    if [[ "${RUN_HOST_PREFLIGHT:-0}" != 1 ]]; then
      echo "✗ host preflight требует явного RUN_HOST_PREFLIGHT=1"
      RC=1
    else
      # shellcheck disable=SC1091
      source "$FACTORY_HOME/lib/profile-preflight.sh"
      if (
        export STATE_DIR="$FACTORY_HOST_STATE"
        export FACTORY_STATE="$FACTORY_HOST_STATE"
        profile_runner_host_preflight "$prof"
      ); then
        echo "✓ исполнители: host preflight готов"
      else
        echo "✗ исполнители: host preflight не пройден"
        RC=1
      fi
    fi
  fi
  echo
done

[[ $RC -eq 0 ]] && echo "ГОТОВО: профили можно запускать" || echo "ЕСТЬ ПРОБЛЕМЫ — см. выше"
exit $RC
