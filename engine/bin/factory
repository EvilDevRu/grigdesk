#!/usr/bin/env bash
# Единственный независимый от провайдера запускатель неизменяемого протокола маршрутов.
#
# Он намеренно не уходит в фон, не выбирает провайдера и не ослабляет SHIP. Выбор
# провайдера и failover задаются только в profiles/<profile>/runners.env. Подготовка
# проекта остаётся обязанностью профиля. Изолированный профиль создаёт рабочее окружение
# своим up.sh, shared-профиль использует только заранее существующие checkout и стенд.
set -uo pipefail

FACTORY_HOME="$(cd "$(dirname "$0")/.." && pwd)"
FACTORY_PROFILES_DIR="${FACTORY_PROFILES_DIR:-$(cd "$FACTORY_HOME/.." && pwd)/profiles}"
FACTORY_RUNNERS_DIR="${FACTORY_RUNNERS_DIR:-$FACTORY_HOME/lib/runners}"
export FACTORY_HOME FACTORY_PROFILES_DIR FACTORY_RUNNERS_DIR

usage() {
  cat <<'EOF'
Использование:
  factory check --profile PROFILE [--route ROUTE]
                   [--expected-catalog-hash SHA256]
                   [--routes-dir ABS]

  factory TASK start --profile PROFILE --route ROUTE --ticket-json ABS
                   [--routes-dir ABS]
                   [--state-dir ABS] [--control-dir ABS]
                   [--runner-primary RUNNER]
                   [--expected-catalog-hash SHA256]
                   [--queue-dispatch-id UUID]
                   [--instrumentation-file REPO:PATH]...
                   [--diagnosis-kind functional|performance|data|integration]
                   [--diagnosis-signal TEXT]
                   [--backend-base REF] [--frontend-base REF]
                   [--delivery-target repo=branch]...
                   [--task-comment]

  factory TASK resume --attempt a_<32hex> [те же общие пути]

  factory TASK gate --attempt a_<32hex> --node GATE
                   --decision approved|rejected [--comment TEXT]
                   [--commit-only] [те же общие пути]

  factory TASK abandon --attempt a_<32hex> --reason TEXT
                   [те же общие пути]

  factory TASK recover --attempt a_<32hex> --reason TEXT
                   --route ROUTE [те же общие пути]

  factory TASK goto --attempt a_<32hex> --node NODE --reason TEXT [--actor ID]
                   [те же общие пути]

  factory TASK work-time --attempt a_<32hex>
                   [те же общие пути]

--profile обязателен: движок не знает ни одного проекта. Профиль обязан заявить
capability "route-v2" в graph.json и реализовать route-хуки контракта
(см. PROFILE-CONTRACT). ROUTE — имя маршрута из current-каталога профиля.

По умолчанию:
  routes store:     ~/.factory/routes
  state:            ~/.factory/state
  trusted control:  ~/.factory/control

Маршрут с транзакционным узлом instrument требует хотя бы один
--instrumentation-file при start. Имя маршрута на этот контракт не влияет. В feature
тесты замораживаются после TESTS, а доверенный VERIFY проверяет неизменность тестов,
синтаксис и линтеры без отдельного модельного этапа. SHIP выполняет commit, push и PR
после approved GATE_ACCEPT; --task-comment дополнительно разрешает комментарий во
внешней задаче.

--runner-primary фиксирует исполнителя на весь прогон задачи: выбор пишется
task-level override в реестр и выигрывает у project policy профиля, а failover
берётся из PROJECT_RUNNER_FAILOVER профиля с убранным выбранным id. Без флага
цепочка исполнителей живёт только в runners.env профиля.

Abandon закрывает АКТИВНУЮ попытку терминалом abandoned (штатный выход из
заклинившего прогона). Recover создаёт из abandoned-терминала НОВУЮ попытку
с чистым bootstrap-состоянием и свежим pin текущего каталога; --route сразу
пинит маршрут новой попытки (без него она была бы тупиком: resume требует
route pin). Продолжение после recover — обычный resume с новым --attempt.
Обе операции берут lock оркестратора задачи и не трогают песочницу.

Gate по умолчанию не только фиксирует решение, но и ведёт маршрут дальше — то
есть держит оркестратор столько, сколько работает следующий узел. Вызывающему,
который ждёт ответа синхронно (кокпит — по HTTP), нужен --commit-only: решение
уходит в журнал попытки, команда выходит, а продолжение запускается отдельным
resume. Иначе фиксация упирается в чужой таймаут: TERM убивает оркестратор,
раннер остаётся сиротой, а человек видит «Command failed» на уже принятом
решении.

Goto — человеческий возврат курсора на ПРОЙДЕННЫЙ узел маршрута (эквивалент
кнопки «перейти сюда»): пройденные узлы сбрасываются, в журнал ложится событие
kind=human-rewind с причиной. Вперёд по маршруту прыгать нельзя: исход узла
получается только его исполнением. После goto продолжай обычным resume.

Resume после остановки «исчерпан бюджет повторов» (stop=human, исход exhausted)
делает такой же human-rewind сам, без goto: раннер результата не зафиксировал
(лежал провайдер или окружение), разбирать исход агента нечего, а бюджет
повторов заводится заново самим заходом в узел. Остановки rewind-limit/
no-progress и исход failed по-прежнему требуют goto с новой гипотезой.

Work-time — read-only сводка учтённого времени попытки: work_time_s (работа
узлов без ворот), gate_wait_s (ожидание решений на воротах) и last_event_at
(эпоха последнего события журнала). Журнал sealed (попытка терминальна) —
читается последняя проекция из реестра.

--reason у abandon, recover и goto и --comment у gate проходят один валидатор:
1..20000 символов, переводы строки РАЗРЕШЕНЫ. Текст идёт в доверенный журнал и
целиком цитируется в промпте следующего агента, поэтому развёрнутый разбор пишется
прямо в него, а не ссылкой на файл. Возврат каретки и прочие управляющие символы
отклоняются кодом 2 с названной позицией ДО локов и записи в журнал. В построчный
реестр многострочный текст не помещается: витрина GATE_*_COMMENT получает выжимку
до 300 символов, полный текст остаётся в журнале.
EOF
}

die() {
  printf 'factory: %s\n' "$*" >&2
  exit 78
}

canonical_existing_dir() {
  local value=${1:-} label=${2:-directory} canonical
  [[ -n "$value" && "$value" == /* && "$value" != *$'\n'* &&
     "$value" != *$'\t'* && -d "$value" && ! -L "$value" ]] ||
    die "$label: нужен существующий абсолютный каталог без symlink"
  canonical=$(realpath -e -- "$value" 2>/dev/null) ||
    die "$label: путь не разрешается"
  [[ "$canonical" == "$value" && "$canonical" != / ]] ||
    die "$label: путь должен быть каноническим и не корневым"
  printf '%s\n' "$canonical"
}

canonical_created_dir() {
  local value=${1:-} label=${2:-directory}
  [[ -n "$value" && "$value" == /* && "$value" != / &&
     "$value" != *$'\n'* && "$value" != *$'\t'* ]] ||
    die "$label: нужен абсолютный не корневой путь"
  [[ "$(realpath -m -- "$value" 2>/dev/null)" == "$value" ]] ||
    die "$label: путь должен быть нормализован"
  mkdir -p -- "$value" || die "$label: каталог не создан"
  chmod 700 "$value" 2>/dev/null || true
  canonical_existing_dir "$value" "$label"
}

canonical_file() {
  local value=${1:-} label=${2:-file} canonical
  [[ -n "$value" && "$value" == /* && "$value" != *$'\n'* &&
     "$value" != *$'\t'* && -f "$value" && ! -L "$value" ]] ||
    die "$label: нужен существующий абсолютный обычный файл"
  canonical=$(realpath -e -- "$value" 2>/dev/null) ||
    die "$label: путь не разрешается"
  [[ "$canonical" == "$value" ]] || die "$label: symlink-компоненты запрещены"
  printf '%s\n' "$canonical"
}

paths_disjoint() {
  local left=$1 right=$2
  [[ "$left" != "$right" && "$left" != "$right/"* && "$right" != "$left/"* ]]
}

profile_has_capability() {
  local file=$1 cap=$2
  python3 - "$file" "$cap" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as source:
        data = json.load(source)
except (OSError, ValueError):
    raise SystemExit(1)
caps = data.get("capabilities") if isinstance(data, dict) else None
raise SystemExit(0 if isinstance(caps, list) and sys.argv[2] in caps else 1)
PY
}

json_value() {
  local path=$1
  python3 -c '
import json, sys
value = json.load(sys.stdin)
for key in sys.argv[1].split("."):
    value = value[key]
if isinstance(value, (dict, list)):
    print(json.dumps(value, ensure_ascii=False, sort_keys=True))
else:
    print(value)
' "$path"
}

# Производные launch-контракты принадлежат машине маршрута, а не её изменяемому id.
# `instrument` открывает длинную явную транзакцию до `proof`; прочие исторические
# transactional-write узлы получают scope из уже сделанного diff непосредственно
# перед своим коротким transaction lifecycle.
route_machine_contract() {
  python3 -c '
import json
import sys

machine = json.load(sys.stdin)["machine"]
nodes = machine["nodes"]
delivery = "publish" if any(node.get("id") == "ship" for node in nodes) else "disabled"
transactional = [
    node for node in nodes
    if (node.get("policy") or {}).get("filesystem") == "transactional-write"
]
if any(node.get("id") == "instrument" for node in transactional):
    instrumentation = "explicit"
elif transactional:
    instrumentation = "derived"
else:
    instrumentation = "disabled"
print(f"{delivery}\t{instrumentation}")
'
}

# Из failover-цепочки профиля убирает выбранный primary: task override с цепочкой
# вида codex,codex routing отклонил бы как invalid, а дубль не несёт смысла.
runner_failover_without() {
  local chain=$1 drop=$2 item result=""
  local IFS=,
  for item in $chain; do
    [[ -n "$item" && "$item" != "$drop" ]] || continue
    result+="${result:+,}$item"
  done
  printf '%s\n' "$result"
}

TASK=""
MODE=""
PROFILE=""
ROUTE=""
FACTORY_USER_HOME="${HOME:-/nonexistent}"
# Имена без поколения принадлежат единственному route-движку после cutover.
ROUTES_DIR="$FACTORY_USER_HOME/.factory/routes"
V2_STATE="${STATE_DIR:-${FACTORY_STATE:-$FACTORY_USER_HOME/.factory/state}}"
CONTROL_ROOT="${FACTORY_CONTROL_ROOT:-$FACTORY_USER_HOME/.factory/control}"
TICKET_JSON=""
EXPECTED_ATTEMPT=""
REASON=""
ACTOR=""
DIAGNOSIS_KIND=""
DIAGNOSIS_SIGNAL=""
RUNNER_PRIMARY_OVERRIDE=""
RUNNER_FAILOVER_OVERRIDE=""
EXPECTED_CATALOG_HASH=""
QUEUE_DISPATCH_ID=""
GATE_NODE=""
GATE_DECISION=""
GATE_COMMENT=""
GATE_COMMIT_ONLY=0
BE_BASE_REF=""
FE_BASE_REF=""
TASK_COMMENT=0
declare -a INSTRUMENTATION_SPECS=()
declare -a DELIVERY_TARGETS=()

# Синхронный control-plane runner/profile/settings не является оркестрацией:
# он выполняется до разбора route-команд и никогда не запускает pipeline или модель.
if [[ "${1:-}" == runners || "${1:-}" == profile || "${1:-}" == settings ||
      "${2:-}" == runner || "${2:-}" == model || "${2:-}" == debug ]]; then
  export STATE_DIR="$V2_STATE" FACTORY_STATE="$V2_STATE"
  export FACTORY_CONFIG_ROOT="${FACTORY_CONFIG_ROOT:-$FACTORY_USER_HOME/.factory/config}"
  # shellcheck disable=SC1091
  source "$FACTORY_HOME/lib/runner-cli.sh"
  factory_runner_cli "$@"
  rc=$?
  (( rc == 2 )) && _runner_cli_usage >&2
  exit "$rc"
fi

if [[ "${1:-}" == list ]]; then
  [[ $# == 1 ]] || die "list не принимает аргументы"
  V2_STATE=$(canonical_created_dir "$V2_STATE" state-dir) || exit 78
  for pipeline in "$V2_STATE"/t*.pipeline; do
    [[ -f "$pipeline" && ! -L "$pipeline" ]] || continue
    task=${pipeline##*/t}; task=${task%.pipeline}
    profile=$(awk -F= '$1=="PROFILE"{value=$2} END{print value}' "$pipeline")
    route=$(awk -F= '$1=="ROUTE"{value=$2} END{print value}' "$pipeline")
    protocol=$(awk -F= '$1=="CATALOG_PROTOCOL"{value=$2} END{print value}' "$pipeline")
    [[ "$protocol" == route-v2 ]] || continue
    printf '#%s [%s] route=%s\n' "$task" "$profile" "$route"
  done
  exit 0
fi

if [[ "${1:-}" == slots ]]; then
  [[ $# == 3 && "${2:-}" == --profile && "${3:-}" =~ ^[a-z][a-z0-9_-]{0,40}$ ]] ||
    die "использование: factory slots --profile PROFILE"
  PROFILE=$3
  PF_FILE=$(canonical_file "$FACTORY_PROFILES_DIR/$PROFILE/profile.sh" profile) || exit 78
  V2_STATE=$(canonical_created_dir "$V2_STATE" state-dir) || exit 78
  export STATE_DIR="$V2_STATE" FACTORY_STATE="$V2_STATE"
  # shellcheck disable=SC1091
  source "$FACTORY_HOME/lib/core.sh" >/dev/null 2>&1
  # shellcheck disable=SC1090
  source "$PF_FILE" >/dev/null 2>&1
  if ! declare -F profile_slots >/dev/null; then
    printf '{"profile":"%s","supported":false,"used":[],"free":[]}\n' "$PROFILE"
    exit 0
  fi
  profile_slots | awk -v prof="$PROFILE" '
    /^ERROR/ { err=substr($0, 7); next }
    /^RANGE/ { lo=$2; hi=$3; have=1; next }
    /^USED/  { used[$2]=1; by[$2]=$3; why[$2]=$4; next }
    END {
      if (err != "" || !have) {
        printf "{\"profile\":\"%s\",\"error\":\"%s\"}\n", prof,
          (err != "" ? err : "профиль не вернул диапазон слотов")
        exit 3
      }
      printf "{\"profile\":\"%s\",\"range\":[%d,%d],\"used\":[", prof, lo, hi
      n=0
      for (k=lo; k<=hi; k++) if (k in used)
        printf "%s{\"k\":%d,\"by\":\"%s\",\"why\":\"%s\"}",
          (n++ ? "," : ""), k, by[k], why[k]
      printf "],\"free\":["
      n=0
      for (k=lo; k<=hi; k++) if (!(k in used))
        printf "%s%d", (n++ ? "," : ""), k
      printf "]}\n"
    }'
  exit ${PIPESTATUS[1]:-0}
fi

while (( $# > 0 )); do
  case "$1" in
    check|start|resume|gate|abandon|recover|goto|work-time)
      [[ -z "$MODE" ]] || die "режим указан повторно"
      MODE=$1
      shift
      ;;
    --profile)
      (( $# >= 2 )) || die "после --profile нужно значение"
      PROFILE=$2
      shift 2
      ;;
    --route)
      (( $# >= 2 )) || die "после --route нужно значение"
      ROUTE=$2
      shift 2
      ;;
    --routes-dir)
      (( $# >= 2 )) || die "после --routes-dir нужен путь"
      ROUTES_DIR=$2
      shift 2
      ;;
    --state-dir)
      (( $# >= 2 )) || die "после --state-dir нужен путь"
      V2_STATE=$2
      shift 2
      ;;
    --control-dir)
      (( $# >= 2 )) || die "после --control-dir нужен путь"
      CONTROL_ROOT=$2
      shift 2
      ;;
    --ticket-json)
      (( $# >= 2 )) || die "после --ticket-json нужен путь"
      TICKET_JSON=$2
      shift 2
      ;;
    --attempt)
      (( $# >= 2 )) || die "после --attempt нужен id"
      [[ -z "$EXPECTED_ATTEMPT" ]] || die "--attempt указан повторно"
      EXPECTED_ATTEMPT=$2
      shift 2
      ;;
    --reason)
      (( $# >= 2 )) || die "после --reason нужен текст"
      [[ -z "$REASON" ]] || die "--reason указан повторно"
      REASON=$2
      shift 2
      ;;
    --actor)
      (( $# >= 2 )) || die "после --actor нужен идентификатор"
      [[ -z "$ACTOR" ]] || die "--actor указан повторно"
      ACTOR=$2
      shift 2
      ;;
    --diagnosis-kind)
      (( $# >= 2 )) || die "после --diagnosis-kind нужно значение"
      DIAGNOSIS_KIND=$2
      shift 2
      ;;
    --diagnosis-signal)
      (( $# >= 2 )) || die "после --diagnosis-signal нужен текст"
      DIAGNOSIS_SIGNAL=$2
      shift 2
      ;;
    --runner-primary)
      (( $# >= 2 )) || die "после --runner-primary нужен id исполнителя"
      [[ -z "$RUNNER_PRIMARY_OVERRIDE" ]] || die "--runner-primary указан повторно"
      RUNNER_PRIMARY_OVERRIDE=$2
      shift 2
      ;;
    --expected-catalog-hash)
      (( $# >= 2 )) || die "после --expected-catalog-hash нужен sha256"
      [[ -z "$EXPECTED_CATALOG_HASH" ]] ||
        die "--expected-catalog-hash указан повторно"
      EXPECTED_CATALOG_HASH=$2
      shift 2
      ;;
    --queue-dispatch-id)
      (( $# >= 2 )) || die "после --queue-dispatch-id нужен UUID"
      [[ -z "$QUEUE_DISPATCH_ID" ]] || die "--queue-dispatch-id указан повторно"
      QUEUE_DISPATCH_ID=$2
      shift 2
      ;;
    --node|--gate)
      (( $# >= 2 )) || die "после $1 нужен gate id"
      [[ -z "$GATE_NODE" ]] || die "gate id указан повторно"
      GATE_NODE=$2
      shift 2
      ;;
    --decision)
      (( $# >= 2 )) || die "после --decision нужно approved|rejected"
      GATE_DECISION=$2
      shift 2
      ;;
    --comment)
      (( $# >= 2 )) || die "после --comment нужен текст"
      GATE_COMMENT=$2
      shift 2
      ;;
    --commit-only)
      GATE_COMMIT_ONLY=1
      shift
      ;;
    --instrumentation-file)
      (( $# >= 2 )) || die "после --instrumentation-file нужен repo:path"
      INSTRUMENTATION_SPECS+=("$2")
      shift 2
      ;;
    --backend-base)
      (( $# >= 2 )) || die "после --backend-base нужен commit/ref"
      BE_BASE_REF=$2
      shift 2
      ;;
    --frontend-base)
      (( $# >= 2 )) || die "после --frontend-base нужен commit/ref"
      FE_BASE_REF=$2
      shift 2
      ;;
    --delivery-target)
      (( $# >= 2 )) || die "после --delivery-target нужен repo=branch"
      DELIVERY_TARGETS+=("$2")
      shift 2
      ;;
    --task-comment)
      TASK_COMMENT=1
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      if [[ -z "$TASK" && "$1" =~ ^[1-9][0-9]{0,18}$ ]]; then
        TASK=$1
        shift
      else
        die "неизвестный аргумент: $1"
      fi
      ;;
  esac
done

[[ "$MODE" == check || "$MODE" == start || "$MODE" == resume ||
   "$MODE" == gate || "$MODE" == abandon || "$MODE" == recover ||
   "$MODE" == goto || "$MODE" == work-time ]] ||
  die "укажи check, start, resume, gate, abandon, recover, goto или work-time"
# Task-level override исполнителя рождается только вместе с новой попыткой;
# остальные режимы ведут immutable попытку с уже зафиксированной цепочкой.
[[ "$MODE" == start || -z "$RUNNER_PRIMARY_OVERRIDE" ]] ||
  die "--runner-primary допустим только при start"
[[ "$MODE" == check || "$MODE" == start || -z "$EXPECTED_CATALOG_HASH" ]] ||
  die "--expected-catalog-hash допустим только при check или start"
[[ "$MODE" == start || -z "$QUEUE_DISPATCH_ID" ]] ||
  die "--queue-dispatch-id допустим только при start"
[[ -z "$EXPECTED_CATALOG_HASH" || "$EXPECTED_CATALOG_HASH" =~ ^[a-f0-9]{64}$ ]] ||
  die "expected-catalog-hash: нужен sha256 в нижнем регистре"
[[ -z "$QUEUE_DISPATCH_ID" ||
   "$QUEUE_DISPATCH_ID" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]] ||
  die "queue-dispatch-id: нужен UUID в нижнем регистре"
[[ -z "$QUEUE_DISPATCH_ID" || -n "$EXPECTED_CATALOG_HASH" ]] ||
  die "--queue-dispatch-id требует --expected-catalog-hash"
# Движок не знает ни одного проекта: профиль обязателен, готовность к v2 он
# заявляет capability в graph.json, а конкретику отдаёт v2-хуками контракта.
[[ -n "$PROFILE" && "$PROFILE" =~ ^[a-z][a-z0-9_-]{0,40}$ ]] ||
  die "нужен --profile (движок не знает проектов)"
[[ -z "$ROUTE" || "$ROUTE" =~ ^[a-z][a-z0-9_-]{0,40}$ ]] ||
  die "route: недопустимое имя (маршрут валидируется по current-каталогу)"

ROUTES_DIR=$(canonical_existing_dir "$ROUTES_DIR" routes-dir) || exit 78
PF_FILE=$(canonical_file "$FACTORY_PROFILES_DIR/$PROFILE/profile.sh" profile) || exit 78
RUNNER_CONFIG_FILE=$(canonical_file "$FACTORY_PROFILES_DIR/$PROFILE/runners.env" runners-config) || exit 78
GRAPH_FILE=$(canonical_file "$FACTORY_PROFILES_DIR/$PROFILE/graph.json" graph) || exit 78
profile_has_capability "$GRAPH_FILE" route-v2 ||
  die "профиль $PROFILE не заявляет capability \"route-v2\" в graph.json"

# shellcheck disable=SC1091
source "$FACTORY_HOME/lib/profile-config.sh"
# shellcheck disable=SC1091
source "$FACTORY_HOME/lib/runners-catalog.sh"
profile_config_validate "$RUNNER_CONFIG_FILE" ||
  die "canonical runners.env не прошёл проверку"
[[ "$(profile_config_get "$RUNNER_CONFIG_FILE" RUNNERS_COVERAGE)" == required ]] ||
  die "runners.env обязан требовать coverage"

CURRENT_CATALOG=""
CURRENT_ROUTE_JSON=""
CURRENT_ROUTE_DELIVERY=""
CURRENT_ROUTE_INSTRUMENTATION=""
if [[ "$MODE" == check || "$MODE" == start ]]; then
  CURRENT_JSON=$(
    "$FACTORY_HOME/bin/factory-route" \
      --routes-dir "$ROUTES_DIR" --profile "$PROFILE" current
  ) || die "current catalog v2 не прошёл проверку"
  CURRENT_CATALOG=$(json_value catalogHash <<<"$CURRENT_JSON") ||
    die "catalog hash не прочитан"
  if [[ -n "$EXPECTED_CATALOG_HASH" &&
        "$CURRENT_CATALOG" != "$EXPECTED_CATALOG_HASH" ]]; then
    printf 'FACTORY_ERROR=catalog_changed EXPECTED=%s ACTUAL=%s\n' \
      "$EXPECTED_CATALOG_HASH" "$CURRENT_CATALOG" >&2
    exit 75
  fi
  if [[ -n "$ROUTE" ]]; then
    CURRENT_ROUTE_JSON=$(
      "$FACTORY_HOME/bin/factory-route" \
        --routes-dir "$ROUTES_DIR" --profile "$PROFILE" describe-route \
        --catalog-hash "$CURRENT_CATALOG" --route "$ROUTE"
    ) ||
      die "route=$ROUTE отсутствует в current catalog"
    CURRENT_ROUTE_CONTRACT=$(route_machine_contract <<<"$CURRENT_ROUTE_JSON") ||
      die "launch topology route=$ROUTE не прочитана"
    IFS=$'\t' read -r CURRENT_ROUTE_DELIVERY CURRENT_ROUTE_INSTRUMENTATION \
      <<<"$CURRENT_ROUTE_CONTRACT"
    [[ "$CURRENT_ROUTE_DELIVERY" =~ ^(publish|disabled)$ &&
       "$CURRENT_ROUTE_INSTRUMENTATION" =~ ^(explicit|derived|disabled)$ ]] ||
      die "launch topology route=$ROUTE недопустима"
  fi
fi

if [[ "$MODE" == check ]]; then
  [[ -z "$TASK" && -z "$EXPECTED_ATTEMPT" && -z "$TICKET_JSON" ]] ||
    die "check не принимает task, attempt или ticket"
  printf 'OK profile=%s catalog=%s' "$PROFILE" "$CURRENT_CATALOG"
  if [[ -n "$ROUTE" ]]; then
    printf ' route=%s delivery=%s instrumentation=%s' \
      "$ROUTE" "$CURRENT_ROUTE_DELIVERY" "$CURRENT_ROUTE_INSTRUMENTATION"
  fi
  printf '\n'
  exit 0
fi

if [[ "$MODE" == start && "$CURRENT_ROUTE_DELIVERY" == disabled ]] && {
     (( ${#DELIVERY_TARGETS[@]} > 0 )) || (( TASK_COMMENT != 0 ));
   }; then
  die "route=$ROUTE не имеет ship и не принимает delivery targets/actions"
fi

[[ "${FACTORY_FORBID_LIVE:-0}" != 1 ]] ||
  die "live lifecycle запрещён текущим окружением"
[[ "$TASK" =~ ^[1-9][0-9]{0,18}$ ]] || die "нужен положительный TASK"
if [[ "$MODE" == start ]]; then
  [[ -n "$ROUTE" ]] || die "start требует --route"
  [[ -n "$TICKET_JSON" ]] || die "start требует --ticket-json"
  TICKET_JSON=$(canonical_file "$TICKET_JSON" ticket-json) || exit 78
  [[ -z "$EXPECTED_ATTEMPT" && -z "$GATE_NODE" && -z "$GATE_DECISION" ]] ||
    die "start не принимает attempt или gate decision"
  if [[ "$CURRENT_ROUTE_INSTRUMENTATION" == explicit ]]; then
    (( ${#INSTRUMENTATION_SPECS[@]} > 0 )) ||
      die "route=$ROUTE требует --instrumentation-file repo:path"
  elif (( ${#INSTRUMENTATION_SPECS[@]} > 0 )); then
    die "route=$ROUTE не принимает явный --instrumentation-file"
  fi
  if [[ -n "$DIAGNOSIS_KIND" ]]; then
    [[ "$DIAGNOSIS_KIND" =~ ^(functional|performance|data|integration)$ ]] ||
      die "diagnosis-kind: functional|performance|data|integration"
  fi
  [[ ${#DIAGNOSIS_SIGNAL} -le 200 && "$DIAGNOSIS_SIGNAL" != *$'\n'* &&
     "$DIAGNOSIS_SIGNAL" != *$'\t'* ]] ||
    die "diagnosis-signal: до 200 символов одной строкой"
  if [[ -n "$RUNNER_PRIMARY_OVERRIDE" ]]; then
    [[ "$RUNNER_PRIMARY_OVERRIDE" =~ ^[a-z][a-z0-9_-]{0,63}$ ]] ||
      die "runner-primary: недопустимый id исполнителя"
    runners_catalog_list | grep -Fxq "$RUNNER_PRIMARY_OVERRIDE" ||
      die "runner-primary: исполнитель не установлен: $RUNNER_PRIMARY_OVERRIDE"
    # Failover задаётся парой с primary: routing при task override не подмешивает
    # профильный, поэтому переносим его сюда с убранным выбранным id.
    RUNNER_FAILOVER_OVERRIDE=$(
      runner_failover_without \
        "$(profile_config_get "$RUNNER_CONFIG_FILE" PROJECT_RUNNER_FAILOVER)" \
        "$RUNNER_PRIMARY_OVERRIDE"
    )
  fi
else
  [[ "$EXPECTED_ATTEMPT" =~ ^a_[a-f0-9]{32}$ ]] ||
    die "$MODE требует точный --attempt a_<32hex>"
  [[ -z "$TICKET_JSON" && ${#INSTRUMENTATION_SPECS[@]} -eq 0 &&
     ${#DELIVERY_TARGETS[@]} -eq 0 && "$TASK_COMMENT" == 0 &&
     -z "$BE_BASE_REF" && -z "$FE_BASE_REF" &&
     -z "$DIAGNOSIS_KIND" && -z "$DIAGNOSIS_SIGNAL" ]] ||
    die "$MODE использует immutable ticket, scope, diagnosis, sandbox и delivery попытки"
fi
if [[ "$MODE" == abandon || "$MODE" == recover || "$MODE" == goto ]]; then
  [[ -n "$REASON" ]] || die "$MODE требует --reason"
else
  [[ -z "$REASON" ]] || die "--reason допустим только в abandon, recover и goto"
fi
# Кто принял решение. Умолчание — человек, и тогда поле не пишется в событие вовсе.
# Нужно это для одной вещи: машинное решение, записанное как человеческое, создаёт в
# журнале ложь «это обдумал человек». Рубежом безопасности поле не является — кокпит
# работает от того же пользователя и мог бы назваться человеком; это запись аудита.
if [[ -n "$ACTOR" ]]; then
  [[ "$MODE" == goto ]] || die "--actor допустим только в goto"
  [[ "$ACTOR" =~ ^[a-z0-9][a-z0-9_-]{0,40}$ ]] || die "--actor: недопустимый идентификатор"
  [[ "$ACTOR" != human ]] || die "--actor human является умолчанием и не указывается"
fi
if [[ "$MODE" == goto ]]; then
  [[ "$GATE_NODE" =~ ^[a-z0-9][a-z0-9_-]{0,40}$ ]] ||
    die "goto требует --node с узлом маршрута"
fi
if [[ "$MODE" == recover ]]; then
  [[ -n "$ROUTE" ]] || die "recover требует --route для новой попытки"
elif [[ "$MODE" == abandon ]]; then
  [[ -z "$ROUTE" ]] || die "--route не используется в abandon"
fi
if [[ "$MODE" == gate ]]; then
  [[ "$GATE_NODE" =~ ^[a-z0-9][a-z0-9_-]{0,40}$ ]] ||
    die "gate требует --node"
  [[ "$GATE_DECISION" == approved || "$GATE_DECISION" == rejected ]] ||
    die "gate требует --decision approved|rejected"
elif [[ -n "$GATE_DECISION" || -n "$GATE_COMMENT" || "$GATE_COMMIT_ONLY" == 1 ]] ||
     { [[ -n "$GATE_NODE" && "$MODE" != goto ]]; }; then
  die "gate arguments допустимы только в режиме gate"
fi

V2_STATE=$(canonical_created_dir "$V2_STATE" state-dir) || exit 78
CONTROL_ROOT=$(canonical_created_dir "$CONTROL_ROOT" control-dir) || exit 78
paths_disjoint "$V2_STATE" "$CONTROL_ROOT" ||
  die "provider-writable state и trusted control должны быть непересекающимися"

export STATE_DIR="$V2_STATE"
export FACTORY_STATE="$V2_STATE"
export FACTORY_ROUTE_STATE_DIR="$V2_STATE"
export FACTORY_CONTROL_ROOT="$CONTROL_ROOT"
export PROFILE_NAME="$PROFILE"
