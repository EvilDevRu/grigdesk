# Форму причины проверяем СРАЗУ после загрузки ledger-библиотеки: до локов, до
# профиля и до единой строки в журнале. Иначе человек узнаёт о лишних символах
# только из «код 2» в конце разбора попытки. Правило живёт ровно в одном месте —
# _attempt_state_reason, здесь именно её вызов, а не вторая копия границ.
if [[ "$MODE" == abandon || "$MODE" == recover || "$MODE" == goto ]]; then
  _attempt_state_reason "$REASON" || exit $?
fi
# Границы общие с reason: rejected-комментарий ворот — доверенное указание следующему
# агенту, а не подпись к решению. Схлопывание переводов строки убрано: замечание на
# несколько абзацев склеивалось в одну простыню, и разметка (списки, таблица замеров)
# переставала читаться ровно там, где она и нужна.
if [[ "$MODE" == gate && -n "$GATE_COMMENT" ]]; then
  _attempt_state_reason "$GATE_COMMENT" || exit $?
fi

# Read-only сводка учтённого времени: журнал попытки и pinned describe-route,
# без песочницы и runner-контрактов. Sealed-попытку журнал не отдаёт (75) —
# тогда читаем последнюю проекцию из реестра.
if [[ "$MODE" == work-time ]]; then
  wt_work="" wt_gate="" wt_since=""
  wt_summary=$(route_v2_work_time "$TASK" "$EXPECTED_ATTEMPT") &&
    IFS=$'\t' read -r wt_work wt_gate wt_since <<<"$wt_summary"
  if [[ ! "$wt_work" =~ ^[0-9]+$ ]]; then
    wt_work=$(get "$TASK" WORK_TIME_S)
    wt_gate=$(get "$TASK" GATE_WAIT_S)
    wt_since=$(get "$TASK" WORK_TIMER_SINCE)
  fi
  [[ "$wt_work" =~ ^[0-9]+$ ]] ||
    die "нет данных о времени: журнал попытки sealed и проекция в реестре не построена"
  printf 'work_time_s=%s\ngate_wait_s=%s\nlast_event_at=%s\n' \
    "$wt_work" "${wt_gate:-0}" "${wt_since:-0}"
  exit 0
fi

# Все проектные величины приходят из route-хуков профиля (PROFILE-CONTRACT);
# движок только fail-closed валидирует форму. В isolated пути workspace могут ещё
# не существовать (их создаст up.sh); в shared они обязаны быть основным checkout.
v2_hook_path_shape() {
  local value=${1:-} label=${2:-path}
  [[ -n "$value" && "$value" == /* && "$value" != / &&
     "$value" != *$'\n'* && "$value" != *$'\t'* ]] ||
    die "$label: хук профиля вернул не абсолютный путь"
  [[ "$(realpath -m -- "$value" 2>/dev/null)" == "$value" ]] ||
    die "$label: путь должен быть нормализован"
  printf '%s\n' "$value"
}

declare -a V2_REPO_NAMES=()
declare -a V2_REPO_SOURCES=()
declare -a V2_REPO_WORKTREES=()
declare -a V2_REPO_BRANCHES=()

declare -F profile_workspace_mode >/dev/null ||
  die "профиль $PROFILE не реализует profile_workspace_mode"
V2_WORKSPACE_MODE=$(profile_workspace_mode) ||
  die "profile_workspace_mode отказал"
[[ "$V2_WORKSPACE_MODE" == isolated || "$V2_WORKSPACE_MODE" == shared ]] ||
  die "profile_workspace_mode: допускается только isolated или shared"

v2_repo_seen() {
  local requested=$1 known
  for known in "${V2_REPO_NAMES[@]}"; do
    [[ "$known" == "$requested" ]] && return 0
  done
  return 1
}

v2_add_repository() {
  local name=$1 source=$2 worktree=$3 known
  [[ "$name" =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]] ||
    die "repositories: недопустимое имя $name"
  case "$name" in
    generation|repos|stateDir|containerName)
      die "repositories: имя $name зарезервировано typed context"
      ;;
  esac
  [[ "$source" != *:* && "$worktree" != *:* &&
     "$source" != *[[:space:]]* && "$worktree" != *[[:space:]]* &&
     "$source" != *\"* && "$worktree" != *\"* &&
     "$source" != *\\* && "$worktree" != *\\* ]] ||
    die "repositories: путь содержит символ, не поддерживаемый transport контекста"
  ! v2_repo_seen "$name" || die "repositories: имя $name повторяется"
  source=$(canonical_existing_dir "$source" "repository-$name-source") || exit 78
  worktree=$(v2_hook_path_shape "$worktree" "repository-$name-worktree") || exit 78
  if [[ "$V2_WORKSPACE_MODE" == shared ]]; then
    [[ "$worktree" == "$source" ]] ||
      die "shared workspace $name обязан совпадать с source checkout"
  else
    paths_disjoint "$worktree" "$source" ||
      die "isolated workspace $name не должен пересекаться с source checkout"
  fi
  for known in "${V2_REPO_WORKTREES[@]}"; do
    paths_disjoint "$worktree" "$known" ||
      die "worktree репозиториев должны быть непересекающимися"
  done
  V2_REPO_NAMES+=("$name")
  V2_REPO_SOURCES+=("$source")
  V2_REPO_WORKTREES+=("$worktree")
  (( ${#V2_REPO_NAMES[@]} <= 16 )) ||
    die "repositories: допускается не больше 16 репозиториев"
}

v2_load_repositories() {
  local output line name source worktree rest
  declare -F profile_repositories >/dev/null ||
    die "профиль $PROFILE не реализует profile_repositories"
  output=$(profile_repositories "$TASK") || die "profile_repositories отказал"
  [[ -n "$output" ]] || die "profile_repositories вернул пустой список"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" && "$line" == *$'\t'* ]] ||
      die "profile_repositories: ожидалось имя<TAB>source<TAB>workspace"
    name=${line%%$'\t'*}
    rest=${line#*$'\t'}
    [[ "$rest" == *$'\t'* ]] ||
      die "profile_repositories: не хватает пути workspace"
    source=${rest%%$'\t'*}
    worktree=${rest#*$'\t'}
    [[ -n "$source" && -n "$worktree" && "$worktree" != *$'\t'* ]] ||
      die "profile_repositories: в строке должно быть ровно три поля"
    v2_add_repository "$name" "$source" "$worktree"
  done <<<"$output"
  (( ${#V2_REPO_NAMES[@]} > 0 )) || die "профиль не объявил ни одного репозитория"
}

for v2_hook in profile_source_branch profile_container profile_stand_alive; do
  declare -F "$v2_hook" >/dev/null ||
    die "профиль $PROFILE не реализует route-хук $v2_hook (см. PROFILE-CONTRACT)"
done
unset v2_hook

v2_load_repositories
for v2_index in "${!V2_REPO_WORKTREES[@]}"; do
  for v2_source_index in "${!V2_REPO_SOURCES[@]}"; do
    if [[ "$V2_WORKSPACE_MODE" == shared && "$v2_index" == "$v2_source_index" ]]; then
      continue
    fi
    paths_disjoint "${V2_REPO_WORKTREES[$v2_index]}" "${V2_REPO_SOURCES[$v2_source_index]}" ||
      die "workspace задачи не должен пересекаться с чужим source-репозиторием"
  done
done
unset v2_index v2_source_index
V2_PRIMARY_WORKTREE=${V2_REPO_WORKTREES[0]}
printf -v V2_AGENT_DIRS '%s ' "${V2_REPO_WORKTREES[@]}"
V2_AGENT_DIRS=${V2_AGENT_DIRS% }
# Ветка закрепляется НА РЕПОЗИТОРИЙ, а не на профиль: у проекта из нескольких
# репозиториев каноничные ветки могут не совпадать (parser стоит на main, ag — на
# master). Профиль, который игнорирует второй аргумент, отдаёт одно значение на всех
# и продолжает работать как раньше.
for v2_index in "${!V2_REPO_NAMES[@]}"; do
  v2_branch=$(profile_source_branch "$TASK" "${V2_REPO_NAMES[$v2_index]}") ||
    die "profile_source_branch отказал на репозитории ${V2_REPO_NAMES[$v2_index]}"
  [[ "$v2_branch" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,79}$ && "$v2_branch" != *..* ]] ||
    die "source-branch: недопустимое имя ветки у репозитория ${V2_REPO_NAMES[$v2_index]}"
  V2_REPO_BRANCHES+=("$v2_branch")
done
# В isolated это имя ВНОВЬ СОЗДАВАЕМОЙ ветки задачи (route-task-<TASK>) — одной на всю
# попытку: разные значения разъехались бы с worktree и доставкой. Расхождение осмысленно
# только в shared, где ветка описывает уже существующий checkout человека.
if [[ "$V2_WORKSPACE_MODE" != shared ]]; then
  for v2_branch in "${V2_REPO_BRANCHES[@]}"; do
    [[ "$v2_branch" == "${V2_REPO_BRANCHES[0]}" ]] ||
      die "isolated-профиль обязан закрепить одну ветку на все репозитории"
  done
fi
V2_SOURCE_BRANCH=${V2_REPO_BRANCHES[0]}
unset v2_index v2_branch
V2_CONTAINER=$(profile_container "$TASK") || die "profile_container отказал"
[[ "$V2_CONTAINER" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$ ]] ||
  die "container: недопустимое имя"
declare -F profile_project_context >/dev/null ||
  die "профиль $PROFILE не реализует profile_project_context"
V2_PROJECT_CONTEXT_JSON=$(profile_project_context) || die "profile_project_context отказал"
V2_PROJECT_CONTEXT_JSON=$(python3 -c '
import json
import sys

try:
    raw = sys.argv[1]
    if len(raw.encode("utf-8")) > 32768:
        raise SystemExit(1)
    value = json.loads(raw)
except (TypeError, ValueError):
    raise SystemExit(1)
if not isinstance(value, dict) or set(value) != {"stack", "guardrails"}:
    raise SystemExit(1)
stack = value["stack"]
guardrails = value["guardrails"]
valid = (
    isinstance(stack, list) and 1 <= len(stack) <= 64
    and isinstance(guardrails, list) and len(guardrails) <= 100
    and all(isinstance(item, str) and 1 <= len(item) <= 500 for item in stack)
    and all(isinstance(item, str) and 1 <= len(item) <= 2000 for item in guardrails)
)
if not valid:
    raise SystemExit(1)
print(json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")))
' "$V2_PROJECT_CONTEXT_JSON") ||
  die "profile_project_context вернул недопустимую схему JSON"
V2_SERVICE_HOST=${PROFILE_SERVICE_HOST:-127.0.0.1}
[[ "$V2_SERVICE_HOST" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,61}[A-Za-z0-9])?$ ]] ||
  die "PROFILE_SERVICE_HOST: нужно имя хоста или адрес без схемы, порта и слэшей"

declare -a V2_SHARED_RESOURCES=()
V2_SHARED_LEASE_BOUND=0
V2_SHARED_LEASE_CLAIMED=0
if [[ "$V2_WORKSPACE_MODE" == shared ]]; then
  declare -F profile_service_ports >/dev/null ||
    die "shared-профиль обязан реализовать profile_service_ports"
  v2_ports=$(profile_service_ports "$TASK") || die "profile_service_ports отказал"
  IFS=$'\t' read -r V2_FE_PORT V2_API_PORT v2_extra <<<"$v2_ports"
  [[ -z "$v2_extra" && "$V2_FE_PORT" =~ ^[1-9][0-9]{3,4}$ &&
     "$V2_API_PORT" =~ ^[1-9][0-9]{3,4}$ &&
     "$V2_FE_PORT" -le 65535 && "$V2_API_PORT" -le 65535 ]] ||
    die "profile_service_ports: ожидалось FE_PORT<TAB>API_PORT"
  unset v2_extra

  declare -F profile_exclusive_resources >/dev/null ||
    die "shared-профиль обязан реализовать profile_exclusive_resources"
  v2_resources=$(profile_exclusive_resources "$TASK") ||
    die "profile_exclusive_resources отказал"
  mapfile -t V2_SHARED_RESOURCES <<<"$v2_resources"
  (( ${#V2_SHARED_RESOURCES[@]} > 0 && ${#V2_SHARED_RESOURCES[@]} <= 32 )) ||
    die "profile_exclusive_resources: нужно от 1 до 32 ресурсов"
  mapfile -t V2_SHARED_RESOURCES < <(printf '%s\n' "${V2_SHARED_RESOURCES[@]}" | LC_ALL=C sort -u)
  for v2_resource in "${V2_SHARED_RESOURCES[@]}"; do
    [[ "$v2_resource" =~ ^[a-z][a-z0-9_-]{0,31}:.{1,480}$ &&
       "$v2_resource" != *$'\n'* && "$v2_resource" != *$'\t'* ]] ||
      die "profile_exclusive_resources: недопустимый ресурс"
  done
  for v2_index in "${!V2_REPO_WORKTREES[@]}"; do
    v2_worktree=${V2_REPO_WORKTREES[$v2_index]}
    printf '%s\n' "${V2_SHARED_RESOURCES[@]}" | grep -Fxq "workspace:$v2_worktree" ||
      die "shared-профиль обязан арендовать workspace:$v2_worktree"
    v2_git_dir=$(git -C "$v2_worktree" rev-parse --path-format=absolute --git-dir 2>/dev/null) ||
      die "shared workspace не является Git checkout: $v2_worktree"
    v2_common_dir=$(git -C "$v2_worktree" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
      die "shared workspace не имеет Git common dir: $v2_worktree"
    v2_git_dir=$(realpath -e -- "$v2_git_dir") || exit 78
    v2_common_dir=$(realpath -e -- "$v2_common_dir") || exit 78
    [[ "$v2_git_dir" == "$v2_common_dir" ]] ||
      die "shared workspace обязан быть основным checkout, а не linked worktree"
    v2_head=$(git -C "$v2_worktree" symbolic-ref --quiet --short HEAD 2>/dev/null)
    [[ "$v2_head" == "${V2_REPO_BRANCHES[$v2_index]}" ]] ||
      die "shared checkout ${V2_REPO_NAMES[$v2_index]} стоит на ветке ${v2_head:-(detached HEAD)}, а закреплена ${V2_REPO_BRANCHES[$v2_index]}"
  done
  printf '%s\n' "${V2_SHARED_RESOURCES[@]}" | grep -Fxq "stand:$V2_CONTAINER" ||
    die "shared-профиль обязан арендовать stand:$V2_CONTAINER"
  unset v2_ports v2_resources v2_resource v2_index v2_worktree v2_head v2_git_dir v2_common_dir
else
  V2_FE_PORT=""
  V2_API_PORT=""
fi

V2_SANDBOX_ENV="$STATE_DIR/t${TASK}.env"
V2_SCOPE_FILE="$STATE_DIR/t${TASK}.instrumentation-scope.list"
V2_ATTEMPT=""
V2_ATTEMPT_SCHEMA=""
V2_ATTEMPT_CATALOG_HASH=""
V2_ATTEMPT_QUEUE_DISPATCH_ID=""
V2_ATTEMPT_RUNNER_PRIMARY_OVERRIDE=""
V2_TRUSTED_TICKET=""
V2_SCOPE_SPEC=""
V2_DELIVERY_SPEC=""
V2_HAS_SHIP=""
V2_DELIVERY_MODE=""
V2_INSTRUMENTATION_MODE=""
V2_SCOPE_EXPECTED_HASH=""

# Агент всегда получает workspace из точного route-контракта профиля.
profile_agent_cwd() {
  [[ -d "$V2_PRIMARY_WORKTREE" ]] && printf '%s\n' "$V2_PRIMARY_WORKTREE"
}

v2_log() {
  flog "$TASK" "route: $*"
}

v2_lock() {
  local lock_dir
  lock_dir="$(factory_control_root)/protocol-v2/orchestrators"
  mkdir -p -- "$lock_dir" || return 1
  [[ -d "$lock_dir" && ! -L "$lock_dir" ]] || return 78
  exec {V2_LOCK_FD}>"$lock_dir/t${TASK}.lock" || return 1
  flock -n "$V2_LOCK_FD" || return 73
}

v2_shared_lease_dir() {
  printf '%s/protocol-v2/shared-leases\n' "$(factory_control_root)"
}

v2_shared_owner_path() {
  local resource=$1 digest
  digest=$(printf '%s' "$resource" | sha256sum | awk '{print $1}') || return 1
  [[ "$digest" =~ ^[a-f0-9]{64}$ ]] || return 78
  printf '%s/%s.owner\n' "$(v2_shared_lease_dir)" "$digest"
}

v2_shared_owner_get() {
  local file=$1 key=$2
  awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); value=$0} END {print value}' \
    "$file" 2>/dev/null
}

v2_shared_lease_lock() {
  local output_var=$1 dir lock_fd
  dir=$(v2_shared_lease_dir) || return
  mkdir -p -- "$dir" || return 1
  chmod 700 "$dir" 2>/dev/null || true
  [[ -d "$dir" && ! -L "$dir" ]] || return 78
  exec {lock_fd}>"$dir/.claim.lock" || return 1
  flock -n "$lock_fd" || {
    eval "exec ${lock_fd}>&-"
    return 73
  }
  printf -v "$output_var" '%s' "$lock_fd"
}

v2_shared_lease_unlock() {
  local fd=$1
  flock -u "$fd" 2>/dev/null || true
  eval "exec ${fd}>&-"
}

v2_shared_owner_valid() {
  local file=$1 resource=$2 expected_attempt=$3 encoded decoded digest
  [[ -f "$file" && ! -L "$file" &&
     "$(stat -c '%a:%h' "$file" 2>/dev/null)" == 600:1 ]] || return 78
  digest=$(printf '%s' "$resource" | sha256sum | awk '{print $1}') || return 1
  encoded=$(v2_shared_owner_get "$file" RESOURCE_B64)
  decoded=$(printf '%s' "$encoded" | base64 -d 2>/dev/null) || return 78
  [[ "$decoded" == "$resource" &&
     "$(v2_shared_owner_get "$file" SCHEMA)" == 1 &&
     "$(v2_shared_owner_get "$file" PROFILE)" == "$PROFILE" &&
     "$(v2_shared_owner_get "$file" TASK)" == "$TASK" &&
     "$(v2_shared_owner_get "$file" ATTEMPT)" == "$expected_attempt" &&
     "$(v2_shared_owner_get "$file" RESOURCE_HASH)" == "$digest" ]] || return 75
}

v2_shared_owner_write() {
  local resource=$1 attempt=$2 file dir tmp digest encoded
  file=$(v2_shared_owner_path "$resource") || return
  dir=${file%/*}
  digest=${file##*/}; digest=${digest%.owner}
  encoded=$(printf '%s' "$resource" | base64 -w0) || return 1
  tmp=$(mktemp "$dir/.owner.XXXXXX") || return 1
  {
    printf 'SCHEMA=1\nPROFILE=%s\nTASK=%s\nATTEMPT=%s\n' \
      "$PROFILE" "$TASK" "$attempt"
    printf 'RESOURCE_HASH=%s\nRESOURCE_B64=%s\n' "$digest" "$encoded"
  } >"$tmp" || {
    rm -f -- "$tmp"
    return 1
  }
  chmod 600 "$tmp" || {
    rm -f -- "$tmp"
    return 1
  }
  mv -f -- "$tmp" "$file"
}

# Durable lease остаётся на диске между foreground-командами и human gates. Короткий
# flock сериализует CAS всех ресурсов, но владельцем является exact task/attempt.
v2_shared_lease_claim() {
  [[ "$V2_WORKSPACE_MODE" == shared ]] || return 0
  local fd resource file created_file
  local -a created=()
  v2_shared_lease_lock fd || return
  for resource in "${V2_SHARED_RESOURCES[@]}"; do
    file=$(v2_shared_owner_path "$resource") || {
      v2_shared_lease_unlock "$fd"
      return 78
    }
    if [[ -e "$file" || -L "$file" ]]; then
      # SIGKILL до создания attempt мог оставить только pending owner. Per-task
      # flock уже наш, а start выше доказал отсутствие active-attempt; такой CAS
      # безопасно подхватывается тем же task/profile.
      v2_shared_owner_valid "$file" "$resource" pending || {
        v2_shared_lease_unlock "$fd"
        return 73
      }
    fi
  done
  for resource in "${V2_SHARED_RESOURCES[@]}"; do
    file=$(v2_shared_owner_path "$resource") || {
      v2_shared_lease_unlock "$fd"
      return 78
    }
    [[ -e "$file" || -L "$file" ]] && continue
    v2_shared_owner_write "$resource" pending || {
      for created_file in "${created[@]}"; do rm -f -- "$created_file"; done
      v2_shared_lease_unlock "$fd"
      return 1
    }
    file=$(v2_shared_owner_path "$resource") || {
      v2_shared_lease_unlock "$fd"
      return 78
    }
    created+=("$file")
  done
  v2_shared_lease_unlock "$fd"
  V2_SHARED_LEASE_CLAIMED=1
}

v2_shared_lease_require() {
  local expected_attempt=$1 fd resource file rc=0
  [[ "$V2_WORKSPACE_MODE" == shared ]] || return 0
  v2_shared_lease_lock fd || return
  for resource in "${V2_SHARED_RESOURCES[@]}"; do
    file=$(v2_shared_owner_path "$resource") || { rc=78; break; }
    v2_shared_owner_valid "$file" "$resource" "$expected_attempt" || {
      rc=$?
      break
    }
  done
  v2_shared_lease_unlock "$fd"
  return "$rc"
}

v2_shared_lease_bind() {
  local attempt=$1 fd resource rc=0
  [[ "$V2_WORKSPACE_MODE" == shared ]] || return 0
  [[ "$attempt" =~ ^a_[a-f0-9]{32}$ ]] || return 78
  v2_shared_lease_lock fd || return
  for resource in "${V2_SHARED_RESOURCES[@]}"; do
    v2_shared_owner_valid "$(v2_shared_owner_path "$resource")" "$resource" pending || {
      rc=$?
      break
    }
  done
  if (( rc == 0 )); then
    for resource in "${V2_SHARED_RESOURCES[@]}"; do
      v2_shared_owner_write "$resource" "$attempt" || { rc=$?; break; }
    done
  fi
  v2_shared_lease_unlock "$fd"
  (( rc == 0 )) || return "$rc"
  V2_SHARED_LEASE_BOUND=1
}

v2_shared_lease_release() {
  local expected_attempt=$1 fd resource file rc=0 lifecycle_rc=0 event_rc
  local cleanup_hash="" lifecycle_active=0 released=0 total=${#V2_SHARED_RESOURCES[@]}
  local -a released_resources=()
  [[ "$V2_WORKSPACE_MODE" == shared ]] || return 0
  if runtime_lifecycle_enabled_v2; then
    cleanup_hash=$(printf '%s\n' "${V2_SHARED_RESOURCES[@]}" | sha256sum | awk '{print $1}') || return
    runtime_lifecycle_cleanup_begin_v2 shared_leases "$cleanup_hash" >/dev/null || return
    lifecycle_active=1
  fi
  v2_shared_lease_lock fd || {
    rc=$?
    if (( lifecycle_active )); then
      runtime_lifecycle_cleanup_finish_v2 shared_leases failed cleanup_failed \
        0 "$total" "$cleanup_hash" >/dev/null || true
    fi
    return "$rc"
  }
  for resource in "${V2_SHARED_RESOURCES[@]}"; do
    file=$(v2_shared_owner_path "$resource") || { rc=78; break; }
    v2_shared_owner_valid "$file" "$resource" "$expected_attempt" || {
      rc=$?
      break
    }
  done
  if (( rc == 0 )); then
    for resource in "${V2_SHARED_RESOURCES[@]}"; do
      file=$(v2_shared_owner_path "$resource") || { rc=78; break; }
      runtime_analytics_durable_unlink_v2 "$file" || { rc=$?; break; }
      released_resources+=("$resource")
      ((released += 1))
    done
  fi
  v2_shared_lease_unlock "$fd"
  if (( lifecycle_active )); then
    for resource in "${released_resources[@]}"; do
      runtime_lifecycle_shared_lease_released_v2 \
        "$resource" released "$cleanup_hash" >/dev/null || {
          event_rc=$?
          (( lifecycle_rc != 0 )) || lifecycle_rc=$event_rc
        }
    done
    if (( rc == 0 && lifecycle_rc == 0 )); then
      runtime_lifecycle_cleanup_finish_v2 shared_leases succeeded normal \
        "$released" 0 "$cleanup_hash" >/dev/null || lifecycle_rc=$?
    else
      runtime_lifecycle_cleanup_finish_v2 shared_leases failed cleanup_failed \
        "$released" "$((total - released))" "$cleanup_hash" >/dev/null || {
          event_rc=$?
          (( lifecycle_rc != 0 )) || lifecycle_rc=$event_rc
        }
    fi
  fi
  (( rc == 0 )) || return "$rc"
  (( lifecycle_rc == 0 )) || return "$lifecycle_rc"
  V2_SHARED_LEASE_CLAIMED=0
  V2_SHARED_LEASE_BOUND=0
}

v2_copy_once() {
  local source=$1 destination=$2 mode=$3 dir tmp source_hash existing_hash
  [[ -f "$source" && ! -L "$source" ]] || return 78
  dir=$(dirname "$destination")
  [[ -d "$dir" && ! -L "$dir" ]] || return 78
  source_hash=$(sha256sum -- "$source" | awk '{print $1}') || return 1
  if [[ -e "$destination" || -L "$destination" ]]; then
    [[ -f "$destination" && ! -L "$destination" ]] || return 75
    existing_hash=$(sha256sum -- "$destination" | awk '{print $1}') || return 1
    [[ "$existing_hash" == "$source_hash" ]] || return 75
    return 0
  fi
  tmp=$(mktemp "$dir/.v2-copy.XXXXXX") || return 1
  cp -- "$source" "$tmp" || {
    rm -f -- "$tmp"
    return 1
  }
  chmod "$mode" "$tmp" || {
    rm -f -- "$tmp"
    return 1
  }
  mv -- "$tmp" "$destination"
}

v2_attempt_artifacts() {
  local root
  root=$(attempt_state_v2_task_root "$TASK") || return
  printf '%s/attempts/%s/artifacts\n' "$root" "$V2_ATTEMPT"
}

# Queue dispatch и точный task-level runner override входят в trusted identity
# attempt schema 2. Старые schema 1 не содержат этих полей: queue тогда ещё не
# существовала, а runner override остаётся в совместимой pipeline-проекции.
v2_load_attempt_launch_identity() {
  local attempt=$1 file schema catalog queue="" runner=""
  file="$(attempt_state_v2_task_root "$TASK")/attempts/$attempt/attempt.json"
  schema=$(_attempt_state_json get "$file" schema) || return
  catalog=$(_attempt_state_json get "$file" catalogHash) || return
  case "$schema" in
    1)
      runner=$(get "$TASK" RUNNER_OVERRIDE_PRIMARY)
      ;;
    2)
      queue=$(_attempt_state_json get "$file" queueDispatchId) || return
      runner=$(_attempt_state_json get "$file" runnerPrimaryOverride) || return
      ;;
    *)
      return 78
      ;;
  esac
  _attempt_state_catalog_hash "$catalog" >/dev/null || return 78
  [[ -z "$queue" ]] || _attempt_state_dispatch_id "$queue" >/dev/null || return 78
  _attempt_state_runner_override "$runner" >/dev/null || return 78
  V2_ATTEMPT_SCHEMA=$schema
  V2_ATTEMPT_CATALOG_HASH=$catalog
  V2_ATTEMPT_QUEUE_DISPATCH_ID=$queue
  V2_ATTEMPT_RUNNER_PRIMARY_OVERRIDE=$runner
}

# Repo/project-часть профиля закрепляется рядом с route pins. Профиль остаётся
# локальным кодом и может быть отредактирован между командами, но resume не имеет
# права молча перенести активную попытку в другой worktree или подменить guardrails.
v2_profile_contract_repo_format() {
  local manifest=$1
  awk -F '\t' '
    $1 == "repo" {
      count++
      if (NF == 4) legacy++
      else if (NF == 5) current++
      else invalid = 1
    }
    END {
      if (count == 0 || invalid || (legacy && current)) exit 78
      print legacy ? "legacy" : "current"
    }
  ' "$manifest"
}

v2_materialize_profile_contract() {
  local manifest=$1 project_context=$2 repo_format=${3:-current} index resource
  [[ "$repo_format" == current || "$repo_format" == legacy ]] || return 78
  {
    printf 'schema\t1\n'
    printf 'repos-mode\tgeneric\n'
    printf 'workspace-mode\t%s\n' "$V2_WORKSPACE_MODE"
    printf 'stand-ownership\t%s\n' "$([[ "$V2_WORKSPACE_MODE" == shared ]] && printf external || printf task)"
    printf 'source-branch\t%s\n' "$V2_SOURCE_BRANCH"
    printf 'container\t%s\n' "$V2_CONTAINER"
    printf 'service-host\t%s\n' "$V2_SERVICE_HOST"
    if [[ "$V2_WORKSPACE_MODE" == shared ]]; then
      printf 'frontend-port\t%s\napi-port\t%s\n' "$V2_FE_PORT" "$V2_API_PORT"
      for resource in "${V2_SHARED_RESOURCES[@]}"; do
        printf 'exclusive-resource\t%s\n' "$resource"
      done
    fi
    for index in "${!V2_REPO_NAMES[@]}"; do
      if [[ "$repo_format" == legacy ]]; then
        printf 'repo\t%s\t%s\t%s\n' \
          "${V2_REPO_NAMES[$index]}" \
          "${V2_REPO_SOURCES[$index]}" \
          "${V2_REPO_WORKTREES[$index]}"
      else
        printf 'repo\t%s\t%s\t%s\t%s\n' \
          "${V2_REPO_NAMES[$index]}" \
          "${V2_REPO_SOURCES[$index]}" \
          "${V2_REPO_WORKTREES[$index]}" \
          "${V2_REPO_BRANCHES[$index]}"
      fi
    done
  } >"$manifest" || return 1
  printf '%s\n' "$V2_PROJECT_CONTEXT_JSON" >"$project_context" || return 1
}

v2_install_profile_contract() {
  local artifacts manifest project_context manifest_tmp project_tmp rc
  local repo_format=current pinned_source_branch branch
  artifacts=$(v2_attempt_artifacts) || return
  manifest="$artifacts/profile-contract.tsv"
  project_context="$artifacts/project-context.json"
  manifest_tmp=$(mktemp "$STATE_DIR/.v2-profile-contract.XXXXXX") || return 1
  project_tmp=$(mktemp "$STATE_DIR/.v2-project-context.XXXXXX") || {
    rm -f -- "$manifest_tmp"
    return 1
  }
  if [[ "$MODE" != start ]]; then
    [[ -f "$manifest" && ! -L "$manifest" &&
       "$(stat -c '%a:%h' "$manifest" 2>/dev/null)" == 400:1 &&
       -f "$project_context" && ! -L "$project_context" &&
       "$(stat -c '%a:%h' "$project_context" 2>/dev/null)" == 400:1 ]] || {
      rm -f -- "$manifest_tmp" "$project_tmp"
      return 78
    }
    repo_format=$(v2_profile_contract_repo_format "$manifest") || {
      rc=$?
      rm -f -- "$manifest_tmp" "$project_tmp"
      return "$rc"
    }
    if [[ "$repo_format" == legacy ]]; then
      pinned_source_branch=$(awk -F '\t' '
        $1 == "source-branch" { count++; value=$2; if (NF != 2) invalid=1 }
        END {
          if (count != 1 || invalid) exit 78
          print value
        }
      ' "$manifest") || {
        rc=$?
        rm -f -- "$manifest_tmp" "$project_tmp"
        return "$rc"
      }
      # Старый manifest закреплял одну общую ветку. Принимать его можно лишь пока
      # новый профиль всё ещё объявляет эту ветку для КАЖДОГО repo; иначе второй
      # repo незаметно сменил бы checkout, которого legacy-артефакт не описывает.
      for branch in "${V2_REPO_BRANCHES[@]}"; do
        [[ "$branch" == "$pinned_source_branch" ]] || {
          rm -f -- "$manifest_tmp" "$project_tmp"
          return 75
        }
      done
    fi
  fi
  v2_materialize_profile_contract "$manifest_tmp" "$project_tmp" "$repo_format" || {
    rc=$?
    rm -f -- "$manifest_tmp" "$project_tmp"
    return "$rc"
  }
  if [[ "$MODE" == start ]]; then
    v2_copy_once "$manifest_tmp" "$manifest" 400 &&
      v2_copy_once "$project_tmp" "$project_context" 400 || {
        rc=$?
        rm -f -- "$manifest_tmp" "$project_tmp"
        return "$rc"
      }
  fi
  [[ -f "$manifest" && ! -L "$manifest" &&
     "$(stat -c '%a:%h' "$manifest" 2>/dev/null)" == 400:1 &&
     -f "$project_context" && ! -L "$project_context" &&
     "$(stat -c '%a:%h' "$project_context" 2>/dev/null)" == 400:1 ]] || {
    rm -f -- "$manifest_tmp" "$project_tmp"
    return 78
  }
  cmp -s -- "$manifest_tmp" "$manifest" &&
    cmp -s -- "$project_tmp" "$project_context" || {
      # Расхождение называем полем: без адреса человек получает «нужен человек»
      # на каждом resume и не знает, что именно уехало в профиле, повторяя немые
      # попытки продолжить прогон.
      v2_log "контракт попытки разошёлся с профилем — $(attempt_state_contract_drift_v2 \
        "$manifest" "$manifest_tmp" "$project_context" "$project_tmp")"
      rm -f -- "$manifest_tmp" "$project_tmp"
      return 75
    }
  rm -f -- "$manifest_tmp" "$project_tmp"
  V2_PROJECT_CONTEXT_JSON=$(<"$project_context") || return 78
}

# Проверенные записи журнала попытки (node:outcome:sequence) для evidence
# контекста: цепочка событий только что переверифицирована чтением курсора,
# сами файлы событий immutable (0400). init и паузы без исхода пропускаются.
v2_ledger_stage_results() {
  local task=$1 attempt=$2 root
  root=$(attempt_state_v2_task_root "$task") || return
  python3 - "$root/attempts/$attempt/stage-results" <<'PY'
import json
import os
import re
import stat
import sys

directory = sys.argv[1]
name_re = re.compile(r"^event\.[0-9]{20}\.[a-f0-9]{64}\.json$")
node_re = re.compile(r"^[a-z0-9][a-z0-9_-]{0,40}$")
outcome_re = re.compile(r"^[a-z][a-z-]{0,20}$")
rows = []
try:
    names = sorted(os.listdir(directory))
except FileNotFoundError:
    names = []
except OSError:
    raise SystemExit(78)
for name in names:
    if not name_re.fullmatch(name):
        continue
    path = os.path.join(directory, name)
    try:
        info = os.lstat(path)
        if not stat.S_ISREG(info.st_mode):
            raise SystemExit(78)
        with open(path, encoding="utf-8") as source:
            event = json.load(source)
    except (OSError, ValueError):
        raise SystemExit(78)
    if not isinstance(event, dict) or event.get("kind") == "init":
        continue
    outcome = event.get("outcome")
    if outcome in (None, ""):
        continue
    node = event.get("node")
    sequence = event.get("sequence")
    if (
        not isinstance(node, str) or not node_re.fullmatch(node)
        or not isinstance(outcome, str) or not outcome_re.fullmatch(outcome)
        or not isinstance(sequence, int) or isinstance(sequence, bool)
        or not 1 <= sequence <= 999_999
    ):
        raise SystemExit(78)
    rows.append((sequence, node, outcome))
rows.sort()
for sequence, node, outcome in rows:
    print(f"{node}:{outcome}:{sequence}")
PY
}

v2_install_ticket() {
  local destination
  destination="$(v2_attempt_artifacts)/ticket.json"
  if [[ "$MODE" == start ]]; then
    v2_copy_once "$TICKET_JSON" "$destination" 400 || return
  fi
  [[ -f "$destination" && ! -L "$destination" &&
     "$(stat -c '%a:%h' "$destination" 2>/dev/null)" == 400:1 ]] || return 78
  V2_TRUSTED_TICKET=$destination
}

# Диагноз попытки immutable, как ticket: заданный на start сохраняется в артефактах
# и переживает resume/gate. Без файла контекст держит честные дефолты
# (functional/unspecified) — молчаливой потери заданных значений быть не может.
v2_install_diagnosis() {
  local destination tmp
  destination="$(v2_attempt_artifacts)/diagnosis.env"
  if [[ "$MODE" == start && ( -n "$DIAGNOSIS_KIND" || -n "$DIAGNOSIS_SIGNAL" ) ]]; then
    tmp=$(mktemp "$STATE_DIR/.v2-diagnosis.XXXXXX") || return 1
    printf 'KIND=%s\nSIGNAL=%s\n' \
      "${DIAGNOSIS_KIND:-functional}" "${DIAGNOSIS_SIGNAL:-unspecified}" >"$tmp" || {
      rm -f -- "$tmp"
      return 1
    }
    v2_copy_once "$tmp" "$destination" 400 || {
      rm -f -- "$tmp"
      return 75
    }
    rm -f -- "$tmp"
  fi
  if [[ -e "$destination" || -L "$destination" ]]; then
    [[ -f "$destination" && ! -L "$destination" &&
       "$(stat -c '%a:%h' "$destination" 2>/dev/null)" == 400:1 ]] || return 78
    DIAGNOSIS_KIND=$(sed -n 's/^KIND=//p' "$destination" | head -1)
    DIAGNOSIS_SIGNAL=$(sed -n 's/^SIGNAL=//p' "$destination" | head -1)
    [[ "$DIAGNOSIS_KIND" =~ ^(functional|performance|data|integration)$ &&
       ${#DIAGNOSIS_SIGNAL} -le 200 ]] || return 78
  fi
}

v2_parse_scope_spec() {
  local value=$1 repo rel part
  [[ "$value" == *:* && "$value" != *$'\n'* && "$value" != *$'\t'* &&
     "$value" != *\\* ]] || return 2
  repo=${value%%:*}
  rel=${value#*:}
  [[ "$repo" =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]] || return 2
  v2_repo_seen "$repo" || return 2
  [[ -n "$rel" && "$rel" != /* && "$rel" != */ &&
     "$rel" != . && "$rel" != .. ]] || return 2
  IFS=/ read -r -a parts <<<"$rel"
  for part in "${parts[@]}"; do
    [[ -n "$part" && "$part" != . && "$part" != .. ]] || return 2
  done
  case "$rel" in
    .git|.git/*|.env|.env.*|*/.env|*/.env.*|.slot|*/.slot) return 2 ;;
  esac
  printf '%s\t%s\n' "$repo" "$rel"
}

v2_install_scope_spec() {
  local destination tmp spec parsed
  destination="$(v2_attempt_artifacts)/instrumentation-scope.tsv"
  # Артефакт создаётся только для топологии с явным scope. Остальные маршруты не
  # должны получать пустой или неуместный instrumentation contract.
  if [[ "$MODE" == start && ${#INSTRUMENTATION_SPECS[@]} -gt 0 ]]; then
    tmp=$(mktemp "$(dirname "$destination")/.scope-spec.XXXXXX") || return 1
    for spec in "${INSTRUMENTATION_SPECS[@]}"; do
      parsed=$(v2_parse_scope_spec "$spec") || {
        rm -f -- "$tmp"
        return 2
      }
      printf '%s\n' "$parsed" >>"$tmp"
    done
    LC_ALL=C sort -u -o "$tmp" "$tmp" || {
      rm -f -- "$tmp"
      return 1
    }
    [[ -s "$tmp" ]] || {
      rm -f -- "$tmp"
      return 2
    }
    chmod 400 "$tmp" || return 1
    mv -- "$tmp" "$destination" || return 1
  fi
  case "$V2_INSTRUMENTATION_MODE" in
    explicit)
      [[ -f "$destination" && ! -L "$destination" &&
         "$(stat -c '%a:%h' "$destination" 2>/dev/null)" == 400:1 ]] || return 78
      V2_SCOPE_SPEC=$destination
      ;;
    derived|disabled)
      [[ ! -e "$destination" && ! -L "$destination" ]] || return 78
      V2_SCOPE_SPEC=""
      ;;
    *) return 78 ;;
  esac
}

v2_delivery_target_valid() {
  local value=$1 repo branch
  [[ "$value" == *=* && "$value" != *$'\n'* && "$value" != *$'\t'* ]] || return 2
  repo=${value%%=*}
  branch=${value#*=}
  [[ "$repo" =~ ^[a-z0-9][a-z0-9_-]{0,63}$ &&
     "$branch" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,254}$ &&
     "$branch" != *..* && "$branch" != *//* && "$branch" != *"@{"* &&
     "$branch" != */ && "$branch" != *. && "$branch" != *.lock ]] || return 2
  v2_repo_seen "$repo" || return 2
  printf '%s\t%s\n' "$repo" "$branch"
}

# Источник истины — закреплённая машина попытки, а не имя маршрута. Так новый
# read-only маршрут автоматически получает disabled, переименованный диагностический
# маршрут сохраняет explicit scope, а исторический одиночный transactional-write —
# derived scope без отдельных case в launcher.
v2_detect_delivery_contract() {
  local contract delivery instrumentation
  contract=$("$FACTORY_HOME/bin/factory-route" \
    --routes-dir "$ROUTES_DIR" --profile "$PROFILE" describe-route \
    --catalog-hash "$ROUTE_V2_CATALOG" --route "$ROUTE_V2_ROUTE" |
    route_machine_contract) || return 78
  IFS=$'\t' read -r delivery instrumentation <<<"$contract"
  case "$delivery" in
    publish)
      V2_HAS_SHIP=1
      V2_DELIVERY_MODE=publish
      ;;
    disabled)
      V2_HAS_SHIP=0
      V2_DELIVERY_MODE=disabled
      ;;
    *) return 78 ;;
  esac
  case "$instrumentation" in
    explicit|derived|disabled) V2_INSTRUMENTATION_MODE=$instrumentation ;;
    *) return 78 ;;
  esac
}

v2_install_delivery_spec() {
  local destination tmp action target parsed
  destination="$(v2_attempt_artifacts)/delivery.tsv"
  if [[ "$V2_HAS_SHIP" == 0 ]]; then
    # У no-ship маршрута нет даже пустого delivery-контракта: отсутствие файла,
    # actions и targets является частью проверяемой границы.
    if [[ "$MODE" == start ]] && {
         (( ${#DELIVERY_TARGETS[@]} > 0 )) || (( TASK_COMMENT != 0 ));
       }; then
      return 2
    fi
    [[ ! -e "$destination" && ! -L "$destination" ]] || return 78
    V2_DELIVERY_SPEC=""
    DELIVERY_TARGETS=()
    TASK_COMMENT=0
    return 0
  fi
  [[ "$V2_HAS_SHIP" == 1 ]] || return 78
  if [[ "$MODE" == start ]]; then
    if (( ${#DELIVERY_TARGETS[@]} == 0 )); then
      # У произвольного набора репозиториев движок не угадывает ни имена,
      # ни целевые ветки. Их обязан явно закрепить вызывающий start.
      return 2
    fi
    tmp=$(mktemp "$(dirname "$destination")/.delivery.XXXXXX") || return 1
    for action in commit push pull-request; do
      printf 'action\t%s\n' "$action" >>"$tmp"
    done
    (( TASK_COMMENT == 0 )) || printf 'action\ttask-comment\n' >>"$tmp"
    for target in "${DELIVERY_TARGETS[@]}"; do
      parsed=$(v2_delivery_target_valid "$target") || {
        rm -f -- "$tmp"
        return 2
      }
      printf 'target\t%s\n' "${parsed//$'\t'/=}" >>"$tmp"
    done
    LC_ALL=C sort -u -o "$tmp" "$tmp" || {
      rm -f -- "$tmp"
      return 1
    }
    chmod 400 "$tmp" || return 1
    mv -- "$tmp" "$destination" || return 1
  fi
  [[ -f "$destination" && ! -L "$destination" &&
     "$(stat -c '%a:%h' "$destination" 2>/dev/null)" == 400:1 ]] || return 78
  V2_DELIVERY_SPEC=$destination
  DELIVERY_TARGETS=()
  TASK_COMMENT=0
  while IFS=$'\t' read -r action target; do
    case "$action:$target" in
      action:commit|action:push|action:pull-request) ;;
      action:task-comment) TASK_COMMENT=1 ;;
      target:*)
        parsed=$(v2_delivery_target_valid "$target") || return 78
        DELIVERY_TARGETS+=("${parsed//$'\t'/=}")
        ;;
      *)
        return 78
        ;;
    esac
  done <"$destination"
  (( ${#DELIVERY_TARGETS[@]} > 0 )) || return 78
  grep -Fxq $'action\tcommit' "$destination" &&
    grep -Fxq $'action\tpush' "$destination" &&
    grep -Fxq $'action\tpull-request' "$destination"
}

v2_sandbox_state() {
  local count=0 expected=1 worktree
  if [[ "$V2_WORKSPACE_MODE" == shared ]]; then
    if [[ ! -e "$V2_SANDBOX_ENV" && ! -L "$V2_SANDBOX_ENV" ]]; then
      printf 'absent\n'
    elif [[ -f "$V2_SANDBOX_ENV" && ! -L "$V2_SANDBOX_ENV" ]]; then
      printf 'ready\n'
    else
      printf 'partial\n'
    fi
    return 0
  fi
  [[ -e "$V2_SANDBOX_ENV" || -L "$V2_SANDBOX_ENV" ]] && count=$((count + 1))
  for worktree in "${V2_REPO_WORKTREES[@]}"; do
    expected=$((expected + 1))
    [[ -e "$worktree" || -L "$worktree" ]] && count=$((count + 1))
  done
  if (( count == 0 )); then
    printf 'absent\n'
  elif (( count == expected )) &&
       [[ -f "$V2_SANDBOX_ENV" && ! -L "$V2_SANDBOX_ENV" ]]; then
    for worktree in "${V2_REPO_WORKTREES[@]}"; do
      [[ -d "$worktree" && ! -L "$worktree" ]] || {
        printf 'partial\n'
        return 0
      }
    done
    printf 'ready\n'
  else
    printf 'partial\n'
  fi
}

v2_materialize_shared_env() {
  local output=$1 index
  {
    printf 'TASK=%s\nPROTOCOL=route-v2\nWORKSPACE_MODE=shared\n' "$TASK"
    printf 'STAND_OWNERSHIP=external\nCONTAINER=%s\nSERVICE_HOST=%s\n' \
      "$V2_CONTAINER" "$V2_SERVICE_HOST"
    printf 'SB_K=0\nAPI_PORT=%s\nFE_PORT=%s\nSOURCE_BRANCH=%s\n' \
      "$V2_API_PORT" "$V2_FE_PORT" "$V2_SOURCE_BRANCH"
    printf 'REPO_COUNT=%s\n' "${#V2_REPO_NAMES[@]}"
    for index in "${!V2_REPO_NAMES[@]}"; do
      printf 'REPO_%s_NAME=%s\nREPO_%s_SOURCE=%s\nREPO_%s_WT=%s\nREPO_%s_BRANCH=%s\n' \
        "$index" "${V2_REPO_NAMES[$index]}" \
        "$index" "${V2_REPO_SOURCES[$index]}" \
        "$index" "${V2_REPO_WORKTREES[$index]}" \
        "$index" "${V2_REPO_BRANCHES[$index]}"
    done
  } >"$output"
}

v2_write_shared_env() {
  local tmp existing_hash expected_hash
  tmp=$(mktemp "$STATE_DIR/.route-env.XXXXXX") || return 1
  v2_materialize_shared_env "$tmp" || {
    rm -f -- "$tmp"
    return 1
  }
  chmod 600 "$tmp" || {
    rm -f -- "$tmp"
    return 1
  }
  if [[ -e "$V2_SANDBOX_ENV" || -L "$V2_SANDBOX_ENV" ]]; then
    [[ -f "$V2_SANDBOX_ENV" && ! -L "$V2_SANDBOX_ENV" ]] || {
      rm -f -- "$tmp"
      return 78
    }
    existing_hash=$(sha256sum -- "$V2_SANDBOX_ENV" | awk '{print $1}') || return 1
    expected_hash=$(sha256sum -- "$tmp" | awk '{print $1}') || return 1
    rm -f -- "$tmp"
    [[ "$existing_hash" == "$expected_hash" ]] || return 75
    return 0
  fi
  [[ "$MODE" == start || "$MODE" == recover ]] || {
    rm -f -- "$tmp"
    return 73
  }
  mv -- "$tmp" "$V2_SANDBOX_ENV"
}

v2_env_get() {
  local key=$1
  awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); value=$0} END {print value}' \
    "$V2_SANDBOX_ENV"
}

v2_read_sandbox() {
  local readiness=${1:-stand} V2_SANDBOX_ENV=${2:-$V2_SANDBOX_ENV}
  local task sb_k source_branch repo_count workspace_mode protocol ownership
  local index name source worktree branch container service_host actual_branch
  [[ "$readiness" == stand ||
     ( "$readiness" == workspace && "$V2_WORKSPACE_MODE" == isolated ) ]] || return 78
  [[ -f "$V2_SANDBOX_ENV" && ! -L "$V2_SANDBOX_ENV" ]] || return 78
  task=$(v2_env_get TASK)
  sb_k=$(v2_env_get SB_K)
  V2_API_PORT=$(v2_env_get API_PORT)
  V2_FE_PORT=$(v2_env_get FE_PORT)
  [[ "$task" == "$TASK" && "$sb_k" =~ ^[0-9]+$ &&
     "$V2_API_PORT" =~ ^[1-9][0-9]{3,4}$ &&
     "$V2_FE_PORT" =~ ^[1-9][0-9]{3,4}$ ]] || return 78
  if [[ "$V2_WORKSPACE_MODE" == shared ]]; then
    protocol=$(v2_env_get PROTOCOL)
    workspace_mode=$(v2_env_get WORKSPACE_MODE)
    ownership=$(v2_env_get STAND_OWNERSHIP)
    container=$(v2_env_get CONTAINER)
    service_host=$(v2_env_get SERVICE_HOST)
    [[ "$protocol" == route-v2 && "$workspace_mode" == shared &&
       "$ownership" == external && "$container" == "$V2_CONTAINER" &&
       "$service_host" == "$V2_SERVICE_HOST" ]] || return 78
  else
    workspace_mode=$(v2_env_get WORKSPACE_MODE)
    ownership=$(v2_env_get STAND_OWNERSHIP)
    [[ "$workspace_mode" == isolated && "$ownership" == task ]] || return 78
  fi
  source_branch=$(v2_env_get SOURCE_BRANCH)
  repo_count=$(v2_env_get REPO_COUNT)
  [[ "$source_branch" == "$V2_SOURCE_BRANCH" &&
     "$repo_count" == "${#V2_REPO_NAMES[@]}" ]] || return 78
  for index in "${!V2_REPO_NAMES[@]}"; do
    name=$(v2_env_get "REPO_${index}_NAME")
    source=$(v2_env_get "REPO_${index}_SOURCE")
    worktree=$(v2_env_get "REPO_${index}_WT")
    branch=$(v2_env_get "REPO_${index}_BRANCH")
    [[ "$name" == "${V2_REPO_NAMES[$index]}" &&
       "$source" == "${V2_REPO_SOURCES[$index]}" &&
       "$worktree" == "${V2_REPO_WORKTREES[$index]}" &&
       "$branch" == "${V2_REPO_BRANCHES[$index]}" ]] || return 78
  done
  # Цикл идёт по индексам, а не по путям: ветка теперь своя у каждого репозитория,
  # и по одному только пути её не сопоставить.
  for index in "${!V2_REPO_WORKTREES[@]}"; do
    worktree=${V2_REPO_WORKTREES[$index]}
    git -C "$worktree" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 78
    if [[ "$V2_WORKSPACE_MODE" == shared ]]; then
      actual_branch=$(git -C "$worktree" symbolic-ref --quiet --short HEAD 2>/dev/null) ||
        return 75
      [[ "$actual_branch" == "${V2_REPO_BRANCHES[$index]}" ]] || return 75
    fi
  done
  # Только health: решение о start/create shared-стенда движок никогда не принимает.
  if [[ "$readiness" == stand ]]; then
    profile_stand_alive "$TASK" || return 73
  fi
  set_st "$TASK" FE_PORT "$V2_FE_PORT" API_PORT "$V2_API_PORT" SB_K "$sb_k" \
    WORKSPACE_MODE "$V2_WORKSPACE_MODE" \
    STAND_OWNERSHIP "$([[ "$V2_WORKSPACE_MODE" == shared ]] && printf external || printf task)" \
    CONTAINER "$V2_CONTAINER"
}

v2_sandbox_up() {
  local state
  if [[ "$V2_WORKSPACE_MODE" == shared ]]; then
    v2_write_shared_env || return
    v2_read_sandbox
    return
  fi
  state=$(v2_sandbox_state) || return
  case "$state" in
    ready)
      ;;
    absent)
      [[ "$MODE" == start ]] || return 73
      STATE_DIR="$STATE_DIR" \
        FACTORY_WORKSPACE_MODE=isolated \
        FACTORY_REQUIRE_NEW_SANDBOX=1 \
        FACTORY_BE_BASE_REF="$BE_BASE_REF" \
        FACTORY_FE_BASE_REF="$FE_BASE_REF" \
        bash "$FACTORY_PROFILES_DIR/$PROFILE/up.sh" "$TASK" \
        >>"$LOGDIR/t${TASK}.orch.log" 2>&1 || return
      ;;
    partial)
      v2_log "обнаружена частично созданная песочница; автоматическое удаление запрещено"
      return 75
      ;;
    *)
      return 78
      ;;
  esac
  v2_read_sandbox
}

v2_sandbox_up_lifecycle() {
  local rc=0
  v2_sandbox_span_begin || return
  v2_sandbox_up || rc=$?
  v2_sandbox_span_finish "$rc"
}

route_v2_workspace_roots() {
  printf '%s\n' "${V2_REPO_WORKTREES[@]}"
}

route_v2_instrumentation_isolation() {
  if [[ "$V2_WORKSPACE_MODE" == shared ]]; then
    printf 'exclusive-shared-checkout-v1\n'
  else
    printf 'exclusive-worktree-v1\n'
  fi
}

# instrumentation-transaction.sh принимает primary checkout только с этой trusted
# аттестацией: exact lease активной попытки и exact набор закреплённых roots.
instrumentation_tx_shared_lease_invariant() {
  local roots_file=$1 expected actual
  [[ "$V2_WORKSPACE_MODE" == shared && -n "$V2_ATTEMPT" ]] || return 78
  v2_shared_lease_require "$V2_ATTEMPT" || return 75
  expected=$(printf '%s\n' "${V2_REPO_WORKTREES[@]}" | LC_ALL=C sort -u) || return 1
  actual=$(LC_ALL=C sort -u -- "$roots_file") || return 1
  [[ "$actual" == "$expected" ]] || return 75
}

route_v2_instrumentation_restored() {
  local task=$1 scope_file=$2
  [[ "$task" == "$TASK" && -f "$scope_file" && ! -L "$scope_file" ]] || return 78
  if [[ "$V2_WORKSPACE_MODE" == shared ]]; then
    v2_shared_lease_require "$V2_ATTEMPT" || return 75
    declare -F profile_instrumentation_restored >/dev/null ||
      return 78
    profile_instrumentation_restored "$TASK" "$scope_file"
  fi
}

route_v2_sensitive_files() {
  local root suffix candidate
  for root in "${V2_REPO_WORKTREES[@]}"; do
    for suffix in .env .env.testing .slot; do
      candidate="$root/$suffix"
      [[ -e "$candidate" || -L "$candidate" ]] && printf '%s\n' "$candidate"
    done
  done
  return 0
}

# Runtime-пути проверочного инструментария (PROFILE-CONTRACT, `profile_route_volatile_paths`):
# профиль печатает `имя-репозитория<TAB>относительный-путь`, движок разрешает имя в
# закреплённый worktree задачи. Строка с неизвестным репозиторием, абсолютным путём или `..`
# — ошибка профиля, и весь список отвергается (78): сторож state-only тогда работает без
# послаблений, а не с частью объявлений. Без хука список пуст — прежнее поведение.
route_v2_volatile_paths() {
  local output line name rel index worktree
  declare -F profile_route_volatile_paths >/dev/null || return 0
  output=$(profile_route_volatile_paths "$TASK") || return 78
  [[ -n "$output" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    [[ "$line" == *$'\t'* ]] || return 78
    name=${line%%$'\t'*}
    rel=${line#*$'\t'}
    [[ -n "$rel" && "$rel" != *$'\t'* && "$rel" != /* && "$rel" != */ &&
       "$rel" != .. && "$rel" != ../* && "$rel" != */.. && "$rel" != */../* &&
       "$rel" != .git && "$rel" != .git/* ]] || return 78
    worktree=""
    for index in "${!V2_REPO_NAMES[@]}"; do
      if [[ "${V2_REPO_NAMES[$index]}" == "$name" ]]; then
        worktree=${V2_REPO_WORKTREES[$index]}
        break
      fi
    done
    [[ -n "$worktree" ]] || return 78
    printf '%s/%s\n' "$worktree" "$rel"
  done <<<"$output"
}

v2_scope_candidate() {
  local root=$1 rel=$2 absolute parent canonical_parent
  [[ -n "$rel" && "$rel" != /* && "$rel" != *$'\n'* && "$rel" != *$'\t'* ]] ||
    return 2
  case "$rel" in
    .git|.git/*|.env|.env.*|*/.env|*/.env.*|.slot|*/.slot) return 3 ;;
  esac
  absolute="$root/$rel"
  parent=$(dirname "$absolute")
  [[ -d "$parent" && ! -L "$parent" ]] || return 2
  canonical_parent=$(realpath -e -- "$parent" 2>/dev/null) || return 2
  [[ "$canonical_parent/$(basename "$absolute")" == "$absolute" &&
     "$absolute" == "$root/"* && ! -L "$absolute" && ! -d "$absolute" ]] || return 2
  printf '%s\n' "$absolute"
}

v2_publish_scope_tmp() {
  local tmp=$1
  LC_ALL=C sort -u -o "$tmp" "$tmp" || return 1
  [[ -s "$tmp" ]] || return 73
  chmod 600 "$tmp" || return 1
  mv -f -- "$tmp" "$V2_SCOPE_FILE" || return 1
  V2_SCOPE_EXPECTED_HASH=$(sha256sum -- "$V2_SCOPE_FILE" | awk '{print $1}') ||
    return 1
}

v2_scope_from_spec() {
  local tmp repo rel root candidate index
  tmp=$(mktemp "$STATE_DIR/.scope.XXXXXX") || return 1
  while IFS=$'\t' read -r repo rel; do
    root=""
    for index in "${!V2_REPO_NAMES[@]}"; do
      [[ "${V2_REPO_NAMES[$index]}" == "$repo" ]] && {
        root=${V2_REPO_WORKTREES[$index]}
        break
      }
    done
    [[ -n "$root" ]] || { rm -f -- "$tmp"; return 78; }
    candidate=$(v2_scope_candidate "$root" "$rel")
    case "$?" in
      0) printf '%s\n' "$candidate" >>"$tmp" ;;
      *) rm -f -- "$tmp"; return 78 ;;
    esac
  done <"$V2_SCOPE_SPEC"
  v2_publish_scope_tmp "$tmp"
}

v2_scope_from_diff() {
  local tmp root rel candidate rc
  tmp=$(mktemp "$STATE_DIR/.scope.XXXXXX") || return 1
  for root in "${V2_REPO_WORKTREES[@]}"; do
    while IFS= read -r -d '' rel; do
      candidate=$(v2_scope_candidate "$root" "$rel")
      rc=$?
      case "$rc" in
        0) printf '%s\n' "$candidate" >>"$tmp" ;;
        3) ;;
        *) rm -f -- "$tmp"; return 78 ;;
      esac
    done < <(
      {
        git -C "$root" diff --name-only -z HEAD --
        git -C "$root" ls-files --others --exclude-standard -z
      } | sort -zu
    )
  done
  v2_publish_scope_tmp "$tmp"
}

v2_prepare_scope() {
  case "$V2_INSTRUMENTATION_MODE" in
    explicit) v2_scope_from_spec ;;
    derived) v2_scope_from_diff ;;
    *) return 78 ;;
  esac
}

route_v2_instrumentation_scope_invariant() {
  local invariant_task=$1 invariant_attempt=$2 scope=$3 hash
  [[ "$invariant_task" == "$TASK" && "$invariant_attempt" == "$V2_ATTEMPT" &&
     "$scope" == "$V2_SCOPE_FILE" && -f "$scope" && ! -L "$scope" &&
     "$(stat -c '%a:%h' "$scope" 2>/dev/null)" == 600:1 &&
     "$V2_SCOPE_EXPECTED_HASH" =~ ^[a-f0-9]{64}$ ]] || return 75
  hash=$(sha256sum -- "$scope" | awk '{print $1}') || return 75
  [[ "$hash" == "$V2_SCOPE_EXPECTED_HASH" ]]
}

v2_decision() {
  local key=$1 value
  value=$(get "$TASK" "$key")
  case "$value" in
    approved|rejected) printf '%s\n' "$value" ;;
    *) printf 'pending\n' ;;
  esac
}

v2_review_decision() {
  local value
  value=$(get "$TASK" REVIEW)
  case "$value" in
    done) printf 'approved\n' ;;
    failed) printf 'rejected\n' ;;
    *) printf 'pending\n' ;;
  esac
}

route_v2_context_for_node() {
  local context_task=$1 context_attempt=$2 context_node=$3
  local context_run_key=$4 context_output=$5 cursor event_count=0
  local transaction_id="" instrumentation_phase=not-started scope_arg=""
  local cause review acceptance allowed action target index
  local ledger_results ledger_line findings_file rc
  local -a args=()

  cursor=$(attempt_stage_state_read_v2 "$context_task" "$context_attempt" 2>/dev/null || true)
  if [[ -n "$cursor" ]]; then
    event_count=$(json_value eventSequence <<<"$cursor" 2>/dev/null || printf '0')
  fi
  [[ "$event_count" =~ ^[0-9]+$ ]] || return 78
  ledger_results=$(v2_ledger_stage_results "$context_task" "$context_attempt") || return 78

  if [[ "$context_node" == instrument || "$context_node" == trace ]]; then
    v2_prepare_scope || return
    transaction_id="v2-${context_attempt#*_}-s${event_count}"
    instrumentation_phase=active
  elif [[ -f "$V2_SCOPE_FILE" && ! -L "$V2_SCOPE_FILE" ]]; then
    V2_SCOPE_EXPECTED_HASH=$(sha256sum -- "$V2_SCOPE_FILE" | awk '{print $1}') ||
      return 1
    transaction_id=$(_route_v2_transaction_active_id "$context_task" 2>/dev/null || true)
    case "$context_node" in
      diagnose|hyposkeptic|proof)
        [[ -n "$transaction_id" ]] && instrumentation_phase=active
        ;;
      *)
        instrumentation_phase=cleaned
        ;;
    esac
  fi
  [[ -n "$transaction_id" ]] || transaction_id=not-open

  cause=$(v2_decision CAUSE_DECISION)
  review=$(v2_review_decision)
  acceptance=$(v2_decision ACCEPTANCE_DECISION)
  args=(
    "$FACTORY_HOME/bin/factory-context"
    --task "$context_task"
    --profile "$PROFILE"
    --attempt "$context_attempt"
    --catalog-hash "$ROUTE_V2_CATALOG"
    --route "$ROUTE_V2_ROUTE"
    --route-hash "$ROUTE_V2_ROUTE_HASH"
    --node "$context_node"
    --run-key "$context_run_key"
    --ticket-json "$V2_TRUSTED_TICKET"
    --project-context-json "$V2_PROJECT_CONTEXT_JSON"
    --state-dir "$STATE_DIR"
    --workspace-mode "$V2_WORKSPACE_MODE"
    --container-name "$V2_CONTAINER"
    --frontend-port "$V2_FE_PORT"
    --api-port "$V2_API_PORT"
    # Имя хоста стенда — слово профиля. Порт свой у каждой песочницы, а вот петля
    # это или localhost, знает только проект: приложение вправе выбирать ветку
    # авторизации по window.location.hostname.
    --service-host "$V2_SERVICE_HOST"
    --transaction-id "$transaction_id"
    --instrumentation-phase "$instrumentation_phase"
    --event-count "$event_count"
    --cause-decision "$cause"
    --cause-comment "$(get "$TASK" CAUSE_DECISION_COMMENT)"
    --review-decision "$review"
    --review-comment "$(get "$TASK" REVIEW_COMMENT)"
    --acceptance-decision "$acceptance"
    --acceptance-comment "$(get "$TASK" ACCEPTANCE_DECISION_COMMENT)"
    --delivery-mode "$V2_DELIVERY_MODE"
    --source-branch "$V2_SOURCE_BRANCH"
    --diagnosis-kind "${DIAGNOSIS_KIND:-functional}"
    --diagnosis-signal "${DIAGNOSIS_SIGNAL:-unspecified}"
  )
  for index in "${!V2_REPO_NAMES[@]}"; do
    args+=(
      --repo
      "${V2_REPO_NAMES[$index]}:${V2_REPO_WORKTREES[$index]}:${V2_REPO_SOURCES[$index]}:${V2_REPO_BRANCHES[$index]}"
    )
  done
  # Инструментация обязательна, когда контракт scope попытки непустой
  # (explicit start с --instrumentation-file); признак переживает resume вместе
  # с immutable-артефактом scope.
  [[ ! -s "$V2_SCOPE_SPEC" ]] || args+=(--instrumentation-required)
  while IFS= read -r ledger_line; do
    [[ -n "$ledger_line" ]] && args+=(--stage-result "$ledger_line")
  done <<<"$ledger_results"
  # Режим «цикл»: круг, этап, потолок профиля и свой отчёт на каждый круг. У обычного
  # маршрута аргумента нет, и контекст побайтно прежний.
  if [[ "$context_node" != scout ]]; then
    local loop_state loop_max
    loop_state=$(attempt_stage_state_loop_state_v2 "$context_task" "$context_attempt") ||
      return 78
    if [[ "$(json_value loop <<<"$loop_state")" != None ]]; then
      loop_max=$(route_v2_loop_max_rounds) || return 78
      args+=(--loop-state-json "$loop_state" --loop-max-rounds "$loop_max")
    fi
  fi
  if [[ -f "$V2_SCOPE_FILE" && ! -L "$V2_SCOPE_FILE" ]]; then
    args+=(--scope-file "$V2_SCOPE_FILE")
    while IFS= read -r allowed || [[ -n "$allowed" ]]; do
      [[ -n "$allowed" ]] && args+=(--allowed-file "$allowed")
    done <"$V2_SCOPE_FILE"
  fi
  if [[ "$V2_HAS_SHIP" == 1 ]]; then
    for action in commit push pull-request; do
      args+=(--delivery-action "$action")
    done
    (( TASK_COMMENT == 0 )) || args+=(--delivery-action task-comment)
    for target in "${DELIVERY_TARGETS[@]}"; do
      args+=(--delivery-target "$target")
    done
  fi
  # Проекция находок — файлом в control root: история цикла растёт с каждым этапом, а
  # одна строка argv в Linux не длиннее 128 КиБ (MAX_ARG_STRLEN). Bootstrap исполняется
  # до рождения stage-ledger и находок иметь не может; остальные узлы получают проекцию
  # только после полной проверки уже инициализированного hash-chain.
  findings_file=$(mktemp "$(factory_control_root)/.route-findings.XXXXXX") || return 1
  if [[ "$context_node" == scout ]]; then
    printf '%s\n' '{"schema":1,"open":[],"closed":[],"deferred":[]}' >"$findings_file"
  else
    attempt_stage_state_findings_v2 "$context_task" "$context_attempt" >"$findings_file"
  fi || {
    rm -f -- "$findings_file"
    return 78
  }
  args+=(--findings-ledger-file "$findings_file")
  "${args[@]}" >"$context_output"
  rc=$?
  rm -f -- "$findings_file"
  return "$rc"
}

# Скелет этапных ключей реестра — из runKeys закреплённого бандла (bootstrap
# SCOUT, если требуется, + main + tail + status-узлы), а не из v1-списка: в реестре не должно
# быть узлов, которых нет в маршруте.
v2_registry_stage_keys() {
  # Каталог приходит параметром: на start он только что выбран (CURRENT_CATALOG),
  # на recovery берётся ЗАКРЕПЛЁННЫЙ пин новой попытки. Реестр обязан описывать
  # маршрут, по которому пойдёт диспетчер, а не тот, что опубликован прямо сейчас.
  local catalog=${1:-$CURRENT_CATALOG}
  "$FACTORY_HOME/bin/factory-route" \
    --routes-dir "$ROUTES_DIR" --profile "$PROFILE" describe-route \
    --catalog-hash "$catalog" --route "$ROUTE" | python3 -c '
import json
import sys

machine = json.load(sys.stdin)["machine"]
keys = [] if machine.get("bootstrap", "required") == "skip" else ["SCOUT"]
by_id = {n["id"]: n for n in machine["nodes"] if isinstance(n, dict)}
for phase in ("main", "tail"):
    for node_id in machine["sequence"][phase]:
        node = by_id.get(node_id) or {}
        key = node.get("key") if node.get("executor") == "status" else node.get("runKey")
        if isinstance(key, str) and key and key not in keys:
            keys.append(key)
print(" ".join(keys))
'
}

v2_gate_state_key() {
  case "$1" in
    gate_plan) printf 'PLAN_DECISION\n' ;;
    gate_cause) printf 'CAUSE_DECISION\n' ;;
    gate_accept) printf 'ACCEPTANCE_DECISION\n' ;;
    *) return 2 ;;
  esac
}

v2_gate_pipeline_key() {
  case "$1" in
    gate_plan) printf 'GATE_PLAN\n' ;;
    gate_cause) printf 'GATE_CAUSE\n' ;;
    gate_accept) printf 'GATE_ACCEPT\n' ;;
    *) return 2 ;;
  esac
}

# Отложенные находки на ворота. Смысл отложенной находки в том, что маршрут её не
# чинит, — значит единственный, кто о ней узнает, это человек на воротах. Без этой
# выгрузки хвост оставался бы только в immutable ledger, то есть был бы потерян:
# для человека это хуже, чем прежний блокирующий вердикт, который хотя бы кричал.
# Пишем человекочитаемый файл рядом с прочими артефактами задачи и возвращаем
# число находок, чтобы вызывающий назвал его в журнале.
v2_write_deferred_tail() {
  local task=$1 attempt=$2 target=$3 ledger
  ledger=$(attempt_stage_state_findings_v2 "$task" "$attempt") || return 1
  printf '%s' "$ledger" | python3 - "$target" "$task" <<'PY'
import json
import sys

target, task = sys.argv[1], sys.argv[2]
try:
    ledger = json.load(sys.stdin)
except (ValueError, json.JSONDecodeError):
    raise SystemExit(1)
items = ledger.get("deferred") or []
if not items:
    raise SystemExit(9)
lines = [
    f"# Отложенные находки задачи {task}",
    "",
    "Проверяющие узлы нашли это по пути, но признали вне цели задачи: маршрут их",
    "не чинил и не проверял. Решение — за человеком: принять как есть, завести",
    "отдельными задачами или вернуть маршрут с явным требованием починить.",
    "",
    "Строка находки — ярлык, а не разбор: развёрнутое доказательство лежит в отчёте",
    "узла-источника (он назван в скобках) среди артефактов задачи. Возвращая маршрут",
    "на доработку, назовите нужный id дословно — по нему узел-автор поймёт, какая",
    "именно находка стала работой этого захода.",
    "",
]
for item in items:
    lines.append(f"- **{item['id']}** ({item['sourceNode']} → {item['owner']}): {item['summary']}")
lines.append("")
with open(target, "w", encoding="utf-8") as handle:
    handle.write("\n".join(lines))
print(len(items))
PY
}

# Подготовка диспетчера к режиму «цикл». Пара закреплённого маршрута читается один раз.
# У цикла — признак режима, потолок и состояние цикла ЭТОЙ попытки в реестре (кокпит не
# предлагает арбитра: этапы ведёт ведущая модель) и предел шагов, вмещающий весь потолок
# кругов: 3 * потолок + число исполняемых узлов + 2. У обычного маршрута — прежние 64,
# а признаки цикла, оставшиеся в реестре от прошлой попытки задачи (recover сохраняет
# посторонние поля), гасятся: иначе обычный маршрут терял бы арбитра.
# Неверный потолок здесь не отказ: первый же шаг диспетчера остановится fail-closed.
v2_prepare_dispatch() {
  local attempt=$1 description info lead nodes max_rounds rc key had_loop=""
  V2_DISPATCH_STEP_LIMIT=64
  _route_v2_load_attempt "$TASK" "$attempt" || return 0
  description=$(mktemp "$(factory_control_root)/.route-loop-info.XXXXXX") || return 0
  "$FACTORY_HOME/bin/factory-route" \
    --routes-dir "$ROUTE_V2_ROUTES_DIR" --profile "$ROUTE_V2_PROFILE" describe-route \
    --catalog-hash "$ROUTE_V2_CATALOG" --route "$ROUTE_V2_ROUTE" >"$description" 2>/dev/null
  rc=$?
  info=""
  if (( rc == 0 )); then
    # Пустой первый столбец bash съел бы (TAB — пробельный IFS): у обычного маршрута
    # число узлов попадало в `lead`. Поэтому узлы идут первыми, а отсутствие ведущего
    # выражено явным «-».
    info=$(python3 - "$description" <<'PY'
import json
import sys

machine = json.load(open(sys.argv[1], encoding="utf-8"))["machine"]
pair = machine.get("loop") or {}
nodes = len(machine["sequence"]["main"]) + len(machine["sequence"]["tail"])
print(nodes, pair.get("lead") or "-")
PY
    ) || info=""
  fi
  rm -f -- "$description"
  # Описание не прочитано — реестр не трогаем: снять признак цикла по сбою чтения значило
  # бы отдать попытку цикла арбитру. Первый шаг диспетчера сам остановится fail-closed.
  [[ -n "$info" ]] || return 0
  read -r nodes lead <<<"$info"
  if [[ -z "$lead" || "$lead" == - ]]; then
    [[ -f "$STATE_DIR/t${TASK}.pipeline" ]] || return 0
    for key in LOOP_MODE LOOP_MAX_ROUNDS LOOP_ROUND LOOP_STAGE LOOP_REPORT; do
      [[ -z "$(get "$TASK" "$key")" ]] || had_loop=1
    done
    [[ -z "$had_loop" ]] || set_st "$TASK" LOOP_MODE "" LOOP_MAX_ROUNDS "" LOOP_ROUND "" \
      LOOP_STAGE "" LOOP_REPORT "" || v2_log "признаки прошлого цикла в реестре не сняты"
    return 0
  fi
  max_rounds=$(route_v2_loop_max_rounds 2>/dev/null) || max_rounds=""
  if [[ -f "$STATE_DIR/t${TASK}.pipeline" ]]; then
    set_st "$TASK" LOOP_MODE 1 LOOP_MAX_ROUNDS "$max_rounds" ||
      v2_log "признак режима «цикл» в реестр не записан"
    route_v2_project_loop "$TASK" "$attempt" "" "" ||
      v2_log "состояние цикла в реестр не записано"
  fi
  [[ "$max_rounds" =~ ^[1-9][0-9]*$ && "$nodes" =~ ^[0-9]+$ ]] || return 0
  V2_DISPATCH_STEP_LIMIT=$(( 3 * max_rounds + nodes + 2 ))
}

# Витрина цикла в реестре задачи: круг, этап, действующий потолок и последний сданный
# отчёт исполнителя (его показывают ворота приёмки). После terminal-результата
# исполнителя отчёт этого визита закрывается на запись: следующий визит пишет в свой
# файл, а прежний остаётся доказательством ровно в том виде, в каком его читал ведущий.
# `exhausted` результатом не считается: повтор продолжает тот же незаконченный отчёт.
route_v2_project_loop() {
  local task=$1 attempt=$2 node=${3:-} outcome=${4:-} state round stage worker last report
  local max_rounds
  state=$(attempt_stage_state_loop_state_v2 "$task" "$attempt") || return
  worker=$(json_value loop.worker <<<"$state" 2>/dev/null) || return 0
  round=$(json_value loop.rounds <<<"$state") || return
  stage=$(json_value loop.stage <<<"$state") || return
  last=$(json_value loop.lastReport <<<"$state") || return
  [[ "$last" != None ]] || last=""
  max_rounds=$(route_v2_loop_max_rounds 2>/dev/null) || max_rounds=""
  [[ "$round" =~ ^[0-9]+$ && "$stage" =~ ^[0-9]+$ ]] || return 78
  [[ -z "$last" || "$last" =~ ^report\.r[0-9]{1,3}(\.v[0-9]{1,4})?\.md$ ]] || return 78
  set_st "$task" LOOP_ROUND "$round" LOOP_STAGE "$stage" LOOP_MAX_ROUNDS "$max_rounds" \
    LOOP_REPORT "${last:+t${task}.$last}" || return
  [[ "$node" == "$worker" && -n "$last" ]] || return 0
  case "$outcome" in
    done|failed|skipped) ;;
    *) return 0 ;;
  esac
  report="$STATE_DIR/t${task}.$last"
  if [[ -f "$report" && ! -L "$report" ]]; then
    chmod a-w -- "$report" || return
  else
    v2_log "${worker^^}: отчёт визита не записан (${report##*/}) — ведущий увидит отсутствие"
  fi
}

# Переводит exact reset из закреплённого route ledger в вторичный реестр Cockpit.
# Ни фиксированного списка стадий, ни семантики --replan/--reject-accept здесь нет:
# набор узлов берётся из immutable event, а runKey — из pinned machine.
route_v2_project_latest_reset() {
  local task=$1 attempt=$2 event_tmp description_tmp projection_tmp rc
  local node executor run_key decision_key
  local -a updates=()
  _route_v2_load_attempt "$task" "$attempt" || return
  event_tmp=$(mktemp "$(factory_control_root)/.route-event.XXXXXX") || return 1
  description_tmp=$(mktemp "$(factory_control_root)/.route-description.XXXXXX") || {
    rm -f -- "$event_tmp"
    return 1
  }
  projection_tmp=$(mktemp "$(factory_control_root)/.route-projection.XXXXXX") || {
    rm -f -- "$event_tmp" "$description_tmp"
    return 1
  }
  attempt_stage_state_latest_event_v2 "$task" "$attempt" >"$event_tmp" || {
    rc=$?
    rm -f -- "$event_tmp" "$description_tmp" "$projection_tmp"
    return "$rc"
  }
  "$FACTORY_HOME/bin/factory-route" \
    --routes-dir "$ROUTE_V2_ROUTES_DIR" \
    --profile "$ROUTE_V2_PROFILE" \
    describe-route \
    --catalog-hash "$ROUTE_V2_CATALOG" \
    --route "$ROUTE_V2_ROUTE" >"$description_tmp" || {
      rc=$?
      rm -f -- "$event_tmp" "$description_tmp" "$projection_tmp"
      return "$rc"
    }
  python3 - "$event_tmp" "$description_tmp" >"$projection_tmp" <<'PY'
import json
import re
import sys

with open(sys.argv[1], encoding="utf-8") as source:
    event = json.load(source)
with open(sys.argv[2], encoding="utf-8") as source:
    description = json.load(source)

if event.get("kind") not in {"commit", "human-rewind", "loop-continue"}:
    raise SystemExit(3)
action = event.get("action")
if not isinstance(action, dict) or set(action) != {"rewind", "reset"}:
    raise SystemExit(3)
reset = action.get("reset")
if (
    not isinstance(reset, list)
    or not reset
    or reset[0] != action.get("rewind")
    or len(reset) != len(set(reset))
):
    raise SystemExit(78)
machine = description.get("machine")
nodes = machine.get("nodes") if isinstance(machine, dict) else None
if not isinstance(nodes, list):
    raise SystemExit(78)
by_id = {}
for item in nodes:
    if not isinstance(item, dict) or not isinstance(item.get("id"), str):
        raise SystemExit(78)
    if item["id"] in by_id:
        raise SystemExit(78)
    by_id[item["id"]] = item
for node_id in reset:
    item = by_id.get(node_id)
    if not isinstance(item, dict) or item.get("executor") not in {"agent", "command", "gate"}:
        raise SystemExit(78)
    run_key = item.get("runKey")
    if not isinstance(run_key, str) or not re.fullmatch(r"[A-Z][A-Z0-9_]{0,63}", run_key):
        raise SystemExit(78)
    print(node_id, item["executor"], run_key, sep="\t")
PY
  rc=$?
  if (( rc == 3 )); then
    rm -f -- "$event_tmp" "$description_tmp" "$projection_tmp"
    return 0
  fi
  if (( rc != 0 )); then
    rm -f -- "$event_tmp" "$description_tmp" "$projection_tmp"
    return "$rc"
  fi
  while IFS=$'\t' read -r node executor run_key || [[ -n "$node" ]]; do
    [[ -n "$node" && -n "$run_key" ]] || continue
    updates+=("$run_key" pending "${run_key}_COMMENT" "")
    if [[ "$executor" == gate ]]; then
      decision_key=$(v2_gate_state_key "$node") || {
        rm -f -- "$event_tmp" "$description_tmp" "$projection_tmp"
        return 78
      }
      updates+=("$decision_key" pending "${decision_key}_COMMENT" "")
    fi
  done <"$projection_tmp"
  rm -f -- "$event_tmp" "$description_tmp" "$projection_tmp"
  (( ${#updates[@]} > 0 )) || return 78
  set_st "$task" "${updates[@]}"
}

# Проекция учтённого времени из route ledger в вторичный реестр: работа узлов
# без ворот (WORK_TIME_S), ожидание ворот (GATE_WAIT_S) и эпоха последнего
# события журнала (WORK_TIMER_SINCE) — по ней доска дотикивает живой интервал
# текущего узла. Витрина: падение здесь не отменяет уже записанный ledger event.
route_v2_project_work_time() {
  local task=$1 attempt=$2 summary work_s gate_s since
  summary=$(route_v2_work_time "$task" "$attempt") || return
  IFS=$'\t' read -r work_s gate_s since <<<"$summary"
  [[ "$work_s" =~ ^[0-9]+$ && "$gate_s" =~ ^[0-9]+$ && "$since" =~ ^[0-9]+$ ]] ||
    return 78
  set_st "$task" WORK_TIME_S "$work_s" GATE_WAIT_S "$gate_s" WORK_TIMER_SINCE "$since"
}

# Фиксация решения ворот: CAS в журнале попытки плюс проекция в реестр, по
# которой кокпит рисует ворота. Продолжение маршрута сюда не входит намеренно —
# см. --commit-only в справке.
v2_gate_commit() {
  local attempt=$1 gate_key pipeline_gate_key rc digest
  gate_key=$(v2_gate_state_key "$GATE_NODE") ||
    die "неизвестный gate node для профиля: $GATE_NODE"
  pipeline_gate_key=$(v2_gate_pipeline_key "$GATE_NODE") ||
    die "нет UI-проекции для gate node: $GATE_NODE"
  route_v2_gate_decide \
    "$TASK" "$attempt" "$GATE_NODE" "$GATE_DECISION" "$GATE_COMMENT" >/dev/null || {
    rc=$?
    v2_log "gate CAS не принят (код $rc)"
    return "$rc"
  }
  # В реестр едет ВЫЖИМКА, а не весь комментарий: формат реестра построчный
  # (`KEY=value`, разбор awk), многострочный текст там всё равно схлопнется в
  # простыню, а 20 КБ в одной строке раздуют файл, который перечитывается на каждый
  # тик кокпита. Источник истины для агента — immutable-событие журнала, реестр же
  # рисует человеку карточку ворот, и первых строк там достаточно.
  digest=$(_gate_comment_digest "$GATE_COMMENT")
  set_st "$TASK" "$gate_key" "$GATE_DECISION" \
    "${gate_key}_COMMENT" "$digest" \
    "$pipeline_gate_key" "$GATE_DECISION" \
    "${pipeline_gate_key}_COMMENT" "$digest"
  v2_log "gate $GATE_NODE=$GATE_DECISION зафиксирован"
}

# Выжимка комментария ворот для витрины реестра: одна строка, до 300 символов,
# с многоточием, если текст длиннее. Символы считает python3 — bash режет байтами
# и рвёт кириллицу пополам.
_gate_comment_digest() {
  local value=${1-}
  [[ -n "$value" ]] || return 0
  python3 - "$value" <<'PY'
import re
import sys

LIMIT = 300
value = re.sub(r"\s+", " ", sys.argv[1]).strip()
if len(value) > LIMIT:
    value = value[: LIMIT - 1].rstrip() + "…"
sys.stdout.write(value)
PY
}

V2_LIFECYCLE_SESSION_OPEN=0
V2_LIFECYCLE_EXIT_STATUS=succeeded
V2_LIFECYCLE_EXIT_REASON=normal

v2_lifecycle_millisecond_instant() {
  local value=$1
  [[ "$value" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || return 78
  printf '%s.000Z\n' "${value%Z}"
}

# Пуст ли journal попытки: 0 — ни одного события, 3 — события есть, иначе код ошибки
# чтения. Различать обязательно: пустой журнал законен (попытка старше самой аналитики),
# а нечитаемый — это порча, и молчать о ней нельзя.
v2_lifecycle_ledger_empty() {
  local attempt=$1 root ledger rc
  root=$(factory_control_root) || return
  ledger=$(mktemp "$root/.lifecycle-empty-probe.XXXXXX") || return 1
  attempt_lifecycle_read_v2 "$TASK" "$attempt" >"$ledger"
  rc=$?
  if (( rc == 0 )) && [[ -s "$ledger" ]]; then
    rc=3
  fi
  rm -f -- "$ledger"
  return "$rc"
}

v2_lifecycle_begin_session() {
  local attempt=$1 mode=$2 route_id=${3:-} route_hash=${4:-}
  local previous="" previous_rc session_reason record record_hash origin previous_attempt
  local recovery recovery_hash="" root open_event="" open_rc=3 open_hash=""
  attempt_lifecycle_init_v2 "$TASK" "$attempt" || return
  previous=$(runtime_lifecycle_previous_session_v2 "$TASK" "$attempt" 2>/dev/null)
  previous_rc=$?
  (( previous_rc == 0 || previous_rc == 3 )) || return "$previous_rc"
  # Попытка, начатая до появления lifecycle-журнала, не имеет в нём ни одного события,
  # а первым обязан идти route_selected: без него валидатор схемы отвергает любое событие
  # со scoped route identity («scoped route identity appears before route_selected»).
  # Дописать этот route_selected задним числом нечем — сессии и её времени в журнале не
  # было вовсе, — поэтому lifecycle такой попытке просто не ведётся. Иначе abandon, goto
  # и resume старой попытки падали кодом 78 детерминированно, то есть у человека
  # переставали работать «снести стенд», «продолжить прогон» и «перейти сюда».
  # Все события lifecycle стоят за `runtime_lifecycle_enabled_v2`, поэтому невыставленный
  # контекст означает «ничего не пишем», а не половину журнала.
  if [[ "$mode" == resume && -z "$previous" ]]; then
    v2_lifecycle_ledger_empty "$attempt"
    previous_rc=$?
    (( previous_rc == 0 || previous_rc == 3 )) || return "$previous_rc"
    (( previous_rc != 0 )) || return 0
  fi
  if [[ "$mode" == resume ]]; then
    root=$(factory_control_root) || return
    open_event=$(mktemp "$root/.lifecycle-open-session.XXXXXX") || return 1
    runtime_lifecycle_previous_open_session_v2 "$TASK" "$attempt" "$open_event"
    open_rc=$?
    if (( open_rc == 0 )); then
      open_hash=$(runtime_analytics_json_get_v2 "$open_event" eventHash) || {
        previous_rc=$?
        rm -f -- "$open_event"
        return "$previous_rc"
      }
    elif (( open_rc != 3 )); then
      rm -f -- "$open_event"
      return "$open_rc"
    fi
  fi
  runtime_lifecycle_set_context_v2 \
    "$TASK" "$attempt" "$PROFILE" "$route_id" "$route_hash" >/dev/null || {
      previous_rc=$?
      [[ -z "$open_event" ]] || rm -f -- "$open_event"
      return "$previous_rc"
    }
  case "$mode" in
    fresh) session_reason=initial ;;
    recovery) session_reason=recovery ;;
    resume)
      if [[ -n "$previous" ]]; then session_reason=resume; else session_reason=recovery; fi
      ;;
    *) return 2 ;;
  esac
  runtime_lifecycle_session_begin_v2 "$session_reason" "$previous" >/dev/null || {
    previous_rc=$?
    [[ -z "$open_event" ]] || rm -f -- "$open_event"
    return "$previous_rc"
  }
  V2_LIFECYCLE_SESSION_OPEN=1
  if (( open_rc == 0 )); then
    runtime_lifecycle_attempt_interrupted_v2 crash_detected "$open_hash" >/dev/null || {
      previous_rc=$?
      rm -f -- "$open_event"
      return "$previous_rc"
    }
  fi
  [[ -z "$open_event" ]] || rm -f -- "$open_event"
  if [[ "$mode" == fresh || "$mode" == recovery ]]; then
    record="$(attempt_state_v2_task_root "$TASK")/attempts/$attempt/attempt.json"
    record_hash=$(runtime_analytics_hash_file_v2 "$record") || return
    origin=$(_attempt_state_json get "$record" origin) || return
    previous_attempt=$(_attempt_state_json get "$record" previousAttemptId) || return
    recovery=$(_attempt_state_json get "$record" recoveryReason) || return
    [[ "$previous_attempt" != null ]] || previous_attempt=""
    [[ "$recovery" != null ]] || recovery=""
    [[ -z "$recovery" ]] || recovery_hash=$(runtime_analytics_hash_string_v2 "$recovery") || return
    runtime_lifecycle_attempt_started_v2 \
      "$origin" "$previous_attempt" "$recovery_hash" "$record_hash" >/dev/null || return
  elif [[ -n "$previous" ]]; then
    runtime_lifecycle_attempt_resumed_v2 "$previous" operator '' >/dev/null || return
  fi
  if [[ "$mode" == resume ]]; then
    runtime_lifecycle_reconcile_routing_v2 "$TASK" "$attempt" >/dev/null || return
    runtime_lifecycle_reconcile_usage_v2 "$TASK" "$attempt" >/dev/null || return
  fi
}

v2_lifecycle_route_selected() {
  local attempt=$1 selected_route_hash=$2 source=${3:-operator_override} root pin selected pin_hash
  local nullglob_was_off=0
  runtime_lifecycle_enabled_v2 || return 0
  root="$(attempt_state_v2_task_root "$TASK")/attempts/$attempt"
  shopt -q nullglob || nullglob_was_off=1
  shopt -s nullglob
  local -a pins=("$root"/route-pin.*.json)
  (( nullglob_was_off == 0 )) || shopt -u nullglob
  (( ${#pins[@]} == 1 )) || return 78
  pin=${pins[0]}
  [[ -f "$pin" && ! -L "$pin" ]] || return 78
  pin_hash=$(runtime_analytics_hash_file_v2 "$pin") || return
  selected=$(_attempt_state_json get "$pin" selectedAt) || return
  selected=$(v2_lifecycle_millisecond_instant "$selected") || return
  runtime_lifecycle_set_route_v2 "$ROUTE" "$selected_route_hash" || return
  runtime_lifecycle_route_selected_v2 \
    "$V2_ATTEMPT_CATALOG_HASH" "$pin_hash" "$selected" "$source" >/dev/null
}

v2_lifecycle_terminal_from_file() {
  local terminal=$1 reason_code=$2 state closed reason record_hash reason_hash=""
  runtime_lifecycle_enabled_v2 || return 0
  [[ -f "$terminal" && ! -L "$terminal" ]] || return 78
  state=$(_attempt_state_json get "$terminal" state) || return
  closed=$(_attempt_state_json get "$terminal" closedAt) || return
  closed=$(v2_lifecycle_millisecond_instant "$closed") || return
  reason=$(_attempt_state_json get "$terminal" reason) || return
  [[ "$reason" != null ]] || reason=""
  [[ -z "$reason" ]] || reason_hash=$(runtime_analytics_hash_string_v2 "$reason") || return
  record_hash=$(runtime_analytics_hash_file_v2 "$terminal") || return
  runtime_lifecycle_attempt_terminal_v2 \
    "$state" "$reason_code" "$reason_hash" "$record_hash" "$closed" >/dev/null
}

v2_lifecycle_latest_stage_hash() {
  local attempt=$1 root event hash rc
  root=$(factory_control_root) || return
  event=$(mktemp "$root/.lifecycle-stage-evidence.XXXXXX") || return 1
  attempt_stage_state_latest_event_v2 "$TASK" "$attempt" >"$event"
  rc=$?
  if (( rc == 0 )); then
    hash=$(runtime_analytics_hash_file_v2 "$event") || rc=$?
  fi
  rm -f -- "$event"
  (( rc == 0 )) || return "$rc"
  printf '%s\n' "$hash"
}

v2_lifecycle_resolve_human() {
  local resolution=$1 evidence
  runtime_lifecycle_enabled_v2 || return 0
  evidence=$(runtime_analytics_hash_string_v2 \
    "$resolution:$FACTORY_LIFECYCLE_ATTEMPT_ID:$FACTORY_LIFECYCLE_SESSION_ID") || return
  runtime_lifecycle_resolve_open_human_v2 "$resolution" "$evidence" >/dev/null
}

v2_lifecycle_begin_human_for_stop() {
  local attempt=$1 stop=$2 reason evidence
  runtime_lifecycle_enabled_v2 || return 0
  case "$stop" in
    # Потолок кругов цикла — тот же исчерпанный бюджет автоматических возвратов:
    # закрытый словарь аналитики не расширяется ради синонима.
    rewind-limit|loop-ceiling) reason=rewind_limit ;;
    no-progress) reason=no_progress ;;
    human) reason=manual_resume_required ;;
    *) reason=operator_requested ;;
  esac
  evidence=$(v2_lifecycle_latest_stage_hash "$attempt") || return
  runtime_lifecycle_human_begin_v2 "$reason" "$evidence" >/dev/null
}

v2_on_signal() {
  local signal=$1 rc=130 stop_rc cleanup_rc
  [[ "$signal" == TERM ]] && rc=143
  trap - TERM INT
  if runtime_lifecycle_enabled_v2; then
    runtime_lifecycle_attempt_interrupted_v2 signal '' >/dev/null || true
    V2_LIFECYCLE_EXIT_STATUS=interrupted
    V2_LIFECYCLE_EXIT_REASON=signal
  fi
  v2_log "получен $signal; останавливаю exact active runner"
  runtime_interrupt_trusted_active "$TASK" "" "" "" \
    "${FACTORY_TERM_GRACE_SECONDS:-5}"
  stop_rc=$?
  if (( stop_rc == 0 )) && [[ -n "$V2_ATTEMPT" ]]; then
    route_v2_cleanup_active_instrumentation "$TASK" "$V2_ATTEMPT"
    cleanup_rc=$?
    (( cleanup_rc == 0 || cleanup_rc == 3 )) || {
      set_st "$TASK" STALLED_HUMAN 1
      v2_log "instrumentation cleanup требует человека (код $cleanup_rc)"
    }
  else
    set_st "$TASK" STALLED_HUMAN 1
    v2_log "quiescence runner не доказана; baseline не изменён (код $stop_rc)"
  fi
  exit "$rc"
}

v2_on_exit() {
  local rc=$? lifecycle_rc=0
  trap - EXIT TERM INT
  v2_sandbox_bootstrap_cancel || {
    set_st "$TASK" STALLED_HUMAN 1
    (( rc != 0 )) || rc=73
  }
  if [[ "$V2_LIFECYCLE_SESSION_OPEN" == 1 ]]; then
    if (( rc != 0 )) && [[ "$V2_LIFECYCLE_EXIT_STATUS" == succeeded ]]; then
      V2_LIFECYCLE_EXIT_STATUS=failed
      V2_LIFECYCLE_EXIT_REASON=unavailable
    fi
    runtime_lifecycle_session_finish_v2 \
      "$V2_LIFECYCLE_EXIT_STATUS" "$V2_LIFECYCLE_EXIT_REASON" '' \
      >/dev/null || lifecycle_rc=$?
    V2_LIFECYCLE_SESSION_OPEN=0
    (( lifecycle_rc == 0 || rc != 0 )) || rc=76
  fi
  if [[ "$(get "$TASK" ORCH_PID)" == "$$" ]]; then
    set_st "$TASK" ORCH_PID ""
  fi
  if [[ "$V2_WORKSPACE_MODE" == shared && "$V2_SHARED_LEASE_CLAIMED" == 1 &&
        "$V2_SHARED_LEASE_BOUND" == 0 ]]; then
    v2_shared_lease_release pending >/dev/null 2>&1 || true
  fi
  exit "$rc"
}

v2_main() {
  local attempt route_hash rc pinned_profile pinned_route pinned_routes route_task_root
  local unavailable_runners preflight_message
  local gate_key pipeline_gate_key gate_node cursor stop stop_node rewind_node continue_node
  local stop_reason stop_suffix deferred_file deferred_count terminal_file
  mkdir -p "$STATE_DIR/logs" "$STATE_DIR/archive"
  v2_lock || die "оркестратор t${TASK} уже работает или lock небезопасен"
  trap 'v2_on_signal TERM' TERM
  trap 'v2_on_signal INT' INT
  trap v2_on_exit EXIT

  if [[ "$MODE" == start ]]; then
    [[ ! -e "$STATE_DIR/t${TASK}.pipeline" &&
       ! -L "$STATE_DIR/t${TASK}.pipeline" &&
       ! -e "$STATE_DIR/t${TASK}.env" &&
       ! -L "$STATE_DIR/t${TASK}.env" ]] ||
      die "t${TASK} уже занята существующим route или историческим состоянием"
    route_task_root=$(attempt_state_v2_task_root "$TASK") || return 78
    [[ ! -e "$route_task_root/active-attempt.json" &&
       ! -L "$route_task_root/active-attempt.json" ]] ||
      die "t${TASK} уже имеет active immutable attempt"
  fi

  # Решение человека на воротах в режиме --commit-only не запускает ни одного
  # агента: это CAS в журнале попытки плюс проекция в реестр. Требовать от него
  # готовности ВСЕХ раннеров хоста означало запирать стоящий маршрут при любом
  # отказе чужого CLI: preflight отдавал код 1 — и человек не мог ни принять
  # ворота, ни отклонить их. Обновление одного из CLI уже проявляло эту связанность.
  # Продолжение маршрута идёт отдельным resume — там preflight на месте, и
  # недоступный раннер по-прежнему не пустит агентов в работу.
  if [[ "$MODE" != gate || "$GATE_COMMIT_ONLY" != 1 ]]; then
    profile_runner_host_preflight "$PROFILE" || {
      rc=$?
      unavailable_runners=""
      # Только rc=1 означает свежий полноценный preflight с недоступным runner.
      # При storage/contract-ошибке старый host.env нельзя выдавать за причину.
      if (( rc == 1 )); then
        unavailable_runners=$(coverage_artifact_get \
          "$STATE_DIR/coverage/$PROFILE/host.env" UNAVAILABLE_RUNNERS)
      fi
      if [[ -n "$unavailable_runners" ]]; then
        preflight_message="runner preflight не пройден: недоступны $unavailable_runners"
        v2_log "$preflight_message [FACTORY_ERROR=runner_preflight_unavailable RUNNERS=$unavailable_runners] (код $rc)"
        printf '%s [FACTORY_ERROR=runner_preflight_unavailable RUNNERS=%s]\n' \
          "$preflight_message" "$unavailable_runners" >&2
      else
        preflight_message="runner preflight не пройден"
        v2_log "$preflight_message [FACTORY_ERROR=runner_preflight_failed] (код $rc)"
        printf '%s [FACTORY_ERROR=runner_preflight_failed]\n' "$preflight_message" >&2
      fi
      return "$rc"
    }
  fi

  if [[ "$V2_WORKSPACE_MODE" == shared ]]; then
    if [[ "$MODE" == start ]]; then
      v2_shared_lease_claim || {
        rc=$?
        v2_log "shared resources уже заняты или lease повреждён (код $rc)"
        return "$rc"
      }
      profile_stand_alive "$TASK" || {
        rc=73
        v2_log "внешний shared-стенд не прошёл health; lifecycle не запускался"
        return "$rc"
      }
    else
      v2_shared_lease_require "$EXPECTED_ATTEMPT" || {
        rc=$?
        v2_log "shared lease не принадлежит exact attempt (код $rc)"
        return "$rc"
      }
      V2_SHARED_LEASE_CLAIMED=1
      V2_SHARED_LEASE_BOUND=1
    fi
  fi

  if [[ "$MODE" == start ]]; then
    # Авторитетная catalog CAS и публикация trusted identity происходят ДО
    # вторичной registry-проекции. Ранний `factory check` остаётся fast-fail:
    # current мог смениться после него. При mismatch begin не публикует attempt,
    # а pending shared lease снимает EXIT-cleanup, поэтому task остаётся чистой.
    attempt=$(attempt_state_begin_v2 \
      "$TASK" "$PROFILE" "$ROUTES_DIR" "$EXPECTED_CATALOG_HASH" \
      "$QUEUE_DISPATCH_ID" "$RUNNER_PRIMARY_OVERRIDE") || {
      rc=$?
      v2_log "attempt не создан (код $rc)"
      return "$rc"
    }
    V2_ATTEMPT=$attempt
    v2_lifecycle_begin_session "$attempt" fresh '' '' || {
      rc=$?
      v2_log "lifecycle новой attempt не инициализирован (код $rc)"
      return "$rc"
    }
    v2_load_attempt_launch_identity "$attempt" || {
      rc=$?
      v2_log "launch identity новой attempt не прочитана (код $rc)"
      return "$rc"
    }
    set_st "$TASK" --init --stages "$(v2_registry_stage_keys)" \
      PROFILE "$PROFILE" \
      ROUTE "$ROUTE" ROUTE_BY human DELIVERY_MODE pending \
      ORCH_PID "$$" STALLED_HUMAN 0 WORKSPACE_MODE "$V2_WORKSPACE_MODE" \
      CATALOG_HASH "$V2_ATTEMPT_CATALOG_HASH" \
      QUEUE_DISPATCH_ID "$V2_ATTEMPT_QUEUE_DISPATCH_ID" \
      RUNNER_OVERRIDE_PRIMARY "$V2_ATTEMPT_RUNNER_PRIMARY_OVERRIDE" \
      RUNNER_OVERRIDE_FAILOVER "$RUNNER_FAILOVER_OVERRIDE" \
      PLAN_DECISION pending CAUSE_DECISION pending ACCEPTANCE_DECISION pending || return
    # Черновики ходов принадлежат попытке: новая начинает с чистого листа, иначе первый же
    # этап прочитал бы заметки прошлого, брошенного прогона как свои.
    declare -F _stage_checkpoint_clear_task >/dev/null &&
      _stage_checkpoint_clear_task "$TASK"
    v2_shared_lease_bind "$attempt" || {
      rc=$?
      v2_log "shared lease не закреплён за attempt (код $rc)"
      return "$rc"
    }
    route_hash=$(attempt_state_select_route_v2 "$TASK" "$attempt" "$ROUTE") || {
      rc=$?
      v2_log "route pin не создан (код $rc)"
      return "$rc"
    }
    v2_lifecycle_route_selected "$attempt" "$route_hash" \
      "$([[ -n "$V2_ATTEMPT_QUEUE_DISPATCH_ID" ]] && printf queue_override || printf operator_override)" || {
        rc=$?
        v2_log "route lifecycle pin не записан (код $rc)"
        return "$rc"
      }
  else
    attempt=$EXPECTED_ATTEMPT
    V2_ATTEMPT=$attempt
    _route_v2_load_attempt "$TASK" "$attempt" || {
      rc=$?
      v2_log "active attempt/pins не прошли exact resume (код $rc)"
      return "$rc"
    }
    pinned_profile=$ROUTE_V2_PROFILE
    pinned_route=$ROUTE_V2_ROUTE
    pinned_routes=$ROUTE_V2_ROUTES_DIR
    [[ "$pinned_profile" == "$PROFILE" && "$pinned_routes" == "$ROUTES_DIR" ]] ||
      die "resume-параметры расходятся с immutable pins"
    [[ -z "$ROUTE" || "$ROUTE" == "$pinned_route" ]] ||
      die "--route расходится с immutable pin"
    ROUTE=$pinned_route
    route_hash=$ROUTE_V2_ROUTE_HASH
    if [[ "$MODE" == resume ]]; then
      # Остановка по потолку кругов без поднятого потолка: отказ до сессии lifecycle,
      # закрытия вмешательства человека и снятия STALLED_HUMAN — журнал, реестр и
      # lifecycle продолжают согласованно говорить «ждёт человека». Подсказка — в журнале.
      route_v2_loop_ceiling_held "$TASK" "$attempt"
      rc=$?
      if (( rc == 11 )); then
        return 0
      elif (( rc != 0 )); then
        return "$rc"
      fi
    fi
    v2_lifecycle_begin_session \
      "$attempt" resume "$ROUTE" "$route_hash" || {
        rc=$?
        v2_log "lifecycle resume не открыт (код $rc)"
        return "$rc"
      }
    v2_lifecycle_resolve_human "$([[ "$MODE" == gate ]] && printf operator_override || printf resume)" || {
      rc=$?
      v2_log "human intervention lifecycle не закрыт (код $rc)"
      return "$rc"
    }
  fi

  # Для start pins появились только что; resume уже загрузил их выше. Проверяем
  # один и тот же immutable bundle перед любым context/delivery действием.
  if [[ "$MODE" == start ]]; then
    _route_v2_load_attempt "$TASK" "$attempt" || return
  fi
  v2_load_attempt_launch_identity "$attempt" || {
    rc=$?
    v2_log "launch identity attempt не прочитана (код $rc)"
    return "$rc"
  }
  v2_detect_delivery_contract || {
    rc=$?
    v2_log "delivery topology закреплённого маршрута не прочитана (код $rc)"
    return "$rc"
  }
  # Решению ворот не нужны ни стенд, ни bootstrap, ни восстановление
  # инструментации: это запись в журнал попытки. --commit-only фиксирует её и
  # выходит, поэтому синхронный вызов остаётся коротким и предсказуемым; весь
  # прогон дальше по маршруту поднимает отдельный resume.
  # STALLED_HUMAN для commit-only снимается ТОЛЬКО после успешного CAS: упавший
  # gate (устаревший узел ворот, код 75) иначе стирал маркер остановки у стоящего
  # маршрута — кокпит терял «ждёт человека» и дорисовывал ложную паузу на воротах,
  # если решение относилось не к узлу под текущим курсором.
  if [[ "$MODE" == gate && "$GATE_COMMIT_ONLY" == 1 ]]; then
    set_st "$TASK" ORCH_PID "$$" DELIVERY_MODE "$V2_DELIVERY_MODE" \
      INSTRUMENTATION_MODE "$V2_INSTRUMENTATION_MODE"

    set_st "$TASK" ATTEMPT_ID "$attempt" CATALOG_PROTOCOL route-v2 \
      CATALOG_HASH "$V2_ATTEMPT_CATALOG_HASH" \
      ROUTE "$ROUTE" ROUTE_HASH "$route_hash" \
      QUEUE_DISPATCH_ID "$V2_ATTEMPT_QUEUE_DISPATCH_ID" \
      RUNNER_OVERRIDE_PRIMARY "$V2_ATTEMPT_RUNNER_PRIMARY_OVERRIDE"

    v2_install_profile_contract || {
      rc=$?
      v2_log "repo/project contract попытки изменился или повреждён (код $rc)"
      return "$rc"
    }

    v2_gate_commit "$attempt" || return
    set_st "$TASK" STALLED_HUMAN 0 || return
    return 0
  fi

  set_st "$TASK" ORCH_PID "$$" STALLED_HUMAN 0 DELIVERY_MODE "$V2_DELIVERY_MODE" \
    INSTRUMENTATION_MODE "$V2_INSTRUMENTATION_MODE"

  set_st "$TASK" ATTEMPT_ID "$attempt" CATALOG_PROTOCOL route-v2 \
    CATALOG_HASH "$V2_ATTEMPT_CATALOG_HASH" \
    ROUTE "$ROUTE" ROUTE_HASH "$route_hash" \
    QUEUE_DISPATCH_ID "$V2_ATTEMPT_QUEUE_DISPATCH_ID" \
    RUNNER_OVERRIDE_PRIMARY "$V2_ATTEMPT_RUNNER_PRIMARY_OVERRIDE"

  v2_install_profile_contract || {
    rc=$?
    v2_log "repo/project contract попытки изменился или повреждён (код $rc)"
    return "$rc"
  }

  v2_install_ticket || {
    rc=$?
    v2_log "immutable ticket не установлен (код $rc)"
    return "$rc"
  }
  v2_install_diagnosis || {
    rc=$?
    v2_log "immutable diagnosis не установлен (код $rc)"
    return "$rc"
  }
  v2_install_scope_spec || {
    rc=$?
    v2_log "instrumentation scope contract не установлен (код $rc)"
    return "$rc"
  }
  v2_install_delivery_spec || {
    rc=$?
    v2_log "delivery contract не установлен (код $rc)"
    return "$rc"
  }

  v2_sandbox_bootstrap_prepare || {
    rc=$?
    set_st "$TASK" STALLED_HUMAN 1
    v2_log "среда профиля не готова (код $rc)"
    return "$rc"
  }
  export PROFILE_AGENT_CWD="$V2_PRIMARY_WORKTREE"
  export PROFILE_AGENT_DIRS="$V2_AGENT_DIRS"
  export ROUTE_V2_INSTRUMENTATION_SCOPE_FILE="$V2_SCOPE_FILE"

  _route_v2_load_attempt "$TASK" "$attempt" || return
  route_v2_dispatch_bootstrap "$TASK" "$attempt" >/dev/null || {
    rc=$?
    set_st "$TASK" STALLED_HUMAN 1
    v2_log "bootstrap не подтверждён (код $rc)"
    return "$rc"
  }
  v2_sandbox_bootstrap_wait || {
    rc=$?
    set_st "$TASK" STALLED_HUMAN 1
    v2_log "среда профиля не готова после разведки (код $rc)"
    return "$rc"
  }
  attempt_stage_state_init_v2 "$TASK" "$attempt" "$ROUTE" >/dev/null || {
    rc=$?
    v2_log "route cursor не инициализирован (код $rc)"
    return "$rc"
  }
  if [[ "$MODE" == resume ]]; then
    # Остановка «исчерпан бюджет повторов» (stop=human, исход exhausted): раннер
    # результата не зафиксировал — чаще всего лежал провайдер — и разбирать исход
    # агента нечего. Бюджет повторов локален заходу в узел, поэтому «продолжить»
    # обнуляет его: доверенный human-rewind возвращает курсор на узел без отдельного
    # goto. Остановки rewind-limit/no-progress и исход failed по-прежнему ждут
    # явного решения человека с новой гипотезой.
    rewind_node=$(route_v2_rewind_exhausted_stop "$TASK" "$attempt") || {
      rc=$?
      v2_log "resume: возврат после исчерпанного бюджета повторов не принят (код $rc)"
      return "$rc"
    }
    if [[ -n "$rewind_node" ]]; then
      [[ ! -f "$STATE_DIR/t${TASK}.pipeline" ]] ||
        set_st "$TASK" RESULT human-rewind || return
      v2_log "$rewind_node: продолжение после исчерпанного бюджета повторов — узел переигрывается"
    fi
    # Остановка по потолку кругов цикла: человек поднял PROFILE_LOOP_MAX_ROUNDS и
    # нажал «продолжить» — исполняется тот же кандидат ведущего, круг списывается.
    # Потолок не поднят — остановка остаётся, модель не запускается.
    continue_node=$(route_v2_continue_loop_ceiling "$TASK" "$attempt")
    rc=$?
    if (( rc == 11 )); then
      # Страховка: ранняя проверка resume уже отказывает без побочных эффектов, но если
      # потолок не поднят и здесь, остановка возвращается в реестр и lifecycle так же,
      # как её ставит диспетчер, — модель не запускается.
      set_st "$TASK" STALLED_HUMAN 1 RESULT stopped-loop-ceiling || return
      v2_lifecycle_begin_human_for_stop "$attempt" loop-ceiling || return
      return 0
    elif (( rc != 0 )); then
      v2_log "resume: продолжение цикла после потолка кругов не принято (код $rc)"
      return "$rc"
    fi
    if [[ -n "$continue_node" ]]; then
      [[ ! -f "$STATE_DIR/t${TASK}.pipeline" ]] ||
        set_st "$TASK" RESULT loop-continue || return
      v2_log "${continue_node^^}: цикл продолжен после поднятого потолка кругов"
    fi
  fi
  if [[ "$MODE" != start ]]; then
    # Если предыдущий процесс умер после ledger CAS, но до UI reset, immutable
    # последнее событие остаётся повторяемым источником проекции.
    route_v2_project_latest_reset "$TASK" "$attempt" || {
      rc=$?
      v2_log "route reset projection не восстановлена (код $rc)"
      return "$rc"
    }
    route_v2_recover_instrumentation "$TASK" "$attempt" || {
      rc=$?
      v2_log "instrumentation recovery не завершён (код $rc)"
      return "$rc"
    }
  fi
  if [[ "$MODE" == gate ]]; then
    v2_gate_commit "$attempt" || return
  fi

  v2_prepare_dispatch "$attempt"
  route_v2_dispatch_until_pause "$TASK" "$attempt" "$V2_DISPATCH_STEP_LIMIT"
  rc=$?
  case "$rc" in
    20)
      cursor=$(attempt_stage_state_read_v2 "$TASK" "$attempt") || return
      gate_node=$(json_value currentNode <<<"$cursor") || return 78
      pipeline_gate_key=$(v2_gate_pipeline_key "$gate_node") || {
        set_st "$TASK" STALLED_HUMAN 1
        v2_log "human gate $gate_node не имеет UI-проекции"
        return 78
      }
      set_st "$TASK" "$pipeline_gate_key" waiting STALLED_HUMAN 1
      v2_log "пауза на human gate $gate_node"
      deferred_file="$STATE_DIR/t${TASK}.deferred.md"
      deferred_count=$(v2_write_deferred_tail "$TASK" "$attempt" "$deferred_file") &&
        [[ "$deferred_count" =~ ^[1-9][0-9]*$ ]] &&
        v2_log "$gate_node: отложено находок: $deferred_count — список в t${TASK}.deferred.md"
      return 0
      ;;
    21)
      cursor=$(attempt_stage_state_read_v2 "$TASK" "$attempt") || return
      stop=$(json_value stop <<<"$cursor") || return 78
      if [[ "$stop" == done ]]; then
        terminal_file=$(attempt_state_finish_v2 "$TASK" "$attempt") || return
        v2_lifecycle_terminal_from_file "$terminal_file" completed || return
        v2_shared_lease_release "$attempt" || {
          rc=$?
          set_st "$TASK" STALLED_HUMAN 1 RESULT lease-release-failed
          v2_log "маршрут завершён, но shared lease не освобождён (код $rc)"
          return "$rc"
        }
        set_st "$TASK" STALLED_HUMAN 0 RESULT completed
        v2_log "маршрут завершён; хвост маршрута подтверждён"
        deferred_file="$STATE_DIR/t${TASK}.deferred.md"
        deferred_count=$(v2_write_deferred_tail "$TASK" "$attempt" "$deferred_file") &&
          [[ "$deferred_count" =~ ^[1-9][0-9]*$ ]] &&
          v2_log "отложено находок: $deferred_count — список в t${TASK}.deferred.md"
        return 0
      fi
      set_st "$TASK" STALLED_HUMAN 1 RESULT "stopped-$stop"
      v2_lifecycle_begin_human_for_stop "$attempt" "$stop" || return
      if [[ "$stop" == no-progress || "$stop" == rewind-limit || "$stop" == loop-ceiling ]]; then
        stop_node=$(json_value lastCommit.node <<<"$cursor") || return 78
        [[ "$stop_node" =~ ^[a-z0-9][a-z0-9_]{0,40}$ ]] || return 78
        # Движок уже вычислил, ЧЕМ именно кончился автоматический цикл (повтор
        # набора, осцилляция, расширение области), и положил это в reason события.
        # Без протяжки в журнал причина оставалась только в immutable ledger, а
        # человек читал generic «маршрут остановлен» и шёл раскапывать руками.
        stop_reason=$(attempt_stage_state_latest_event_v2 "$TASK" "$attempt" |
          json_value reason 2>/dev/null) || stop_reason=""
        stop_reason=${stop_reason//$'\n'/ }
        if [[ -n "$stop_reason" ]]; then
          v2_log "${stop_node^^}: маршрут остановлен: $stop — $stop_reason"
        else
          v2_log "${stop_node^^}: маршрут остановлен: $stop"
        fi
      else
        # Остальные объявленные маршрутом остановки (на деле это `human`: замер по всем
        # опубликованным каталогам — 2785 таких переходов против 184 `done`). До
        # 28.08.2026 они уходили голой строкой без узла, а кокпит разбирает журнал
        # правилами с префиксом этапа — значит не совпадало ни одно, и карточка
        # отвечала «причина не нашлась в журнале» поверх остановки, у которой и узел,
        # и вердикт уже лежали в журнале попытки. Имя узла берём тем же способом, что
        # и ветка выше, но отсутствие имени здесь не отказ: терять остановку из-за
        # неназванного узла дороже, чем показать её без него.
        stop_node=$(json_value lastCommit.node <<<"$cursor" 2>/dev/null) || stop_node=""
        # Два `human`, у которых причина есть и лежит не в вердикте агента, а у runtime
        # узла: отказ evidence-хука (агент отчитался done) и исчерпанный бюджет повторов
        # (результата не было ни у одного захода — комментарий узла пишет route-runtime).
        # Кокпит читает причину остановки из ПОСЛЕДНЕЙ строки окна, поэтому она едет в
        # самой строке остановки, а не строкой выше, где её перекрыла бы общая
        # формулировка. Без суффикса исчерпание показывалось как «узел вернул решение
        # человеку» с советом прочитать замечание, которого агент не писал (t7989).
        stop_suffix=""
        [[ -z "${ROUTE_V2_EVIDENCE_STOP_REASON:-}" ]] ||
          stop_suffix=" — $ROUTE_V2_EVIDENCE_STOP_REASON"
        if [[ -z "$stop_suffix" ]]; then
          stop_suffix=$(route_v2_stop_line_suffix "$TASK" "$attempt") || stop_suffix=""
        fi
        if [[ "$stop_node" =~ ^[a-z0-9][a-z0-9_]{0,40}$ ]]; then
          v2_log "${stop_node^^}: маршрут остановлен: ${stop}${stop_suffix}"
        else
          v2_log "маршрут остановлен: ${stop}${stop_suffix}"
        fi
      fi
      return 0
      ;;
    0)
      return 0
      ;;
    *)
      set_st "$TASK" STALLED_HUMAN 1
      v2_log "dispatcher остановлен fail-closed (код $rc)"
      return "$rc"
      ;;
  esac
}

# Выходы этапов предшественницы уносим с диска (см. attempt-state.sh): иначе новая
# попытка принимает их за свои. Список унесённого — в журнал, чтобы человек знал,
# где искать, если понадобится сравнить с прошлым заходом.
v2_quarantine_state_artifacts() {
  local from_attempt=$1 moved base rc
  # Именно подстановка, а не пайп: у process substitution код возврата не забрать,
  # а молча пройти мимо неубранного артефакта — ровно та ошибка, от которой чиним.
  moved=$(attempt_state_quarantine_artifacts_v2 "$TASK" "$from_attempt" "$STATE_DIR")
  rc=$?
  if (( rc != 0 )); then
    v2_log "recovery: артефакты предшественницы не убраны (код $rc)"
    return "$rc"
  fi
  while IFS= read -r base || [[ -n "$base" ]]; do
    [[ -n "$base" ]] || continue
    v2_log "recovery: артефакт $base убран в архив попытки $from_attempt"
  done <<<"$moved"
  return 0
}

# Административные операции над attempt state: без песочницы, каталога маршрутов
# и диспетчеризации. Lock оркестратора берём тот же, что у start/resume, — abandon
# под живым foreground-прогоном обязан получить отказ, а не резать попытку под ним.
v2_admin_main() {
  local rc out recovery_runner recovery_failover terminal_file stage_hash transition
  mkdir -p "$STATE_DIR/logs"
  v2_lock || die "оркестратор t${TASK} уже работает или lock небезопасен"
  trap v2_on_exit EXIT
  if [[ "$V2_WORKSPACE_MODE" == shared ]]; then
    case "$MODE" in
      abandon|goto)
        v2_shared_lease_require "$EXPECTED_ATTEMPT" || {
          rc=$?
          v2_log "$MODE: exact shared lease не подтверждён (код $rc)"
          return "$rc"
        }
        ;;
      recover)
        v2_shared_lease_claim || {
          rc=$?
          v2_log "recover: shared resources заняты (код $rc)"
          return "$rc"
        }
        ;;
    esac
  fi
  if [[ "$MODE" == goto || "$MODE" == abandon ]]; then
    # Возврат курсора работает по ЗАКРЕПЛЁННОМУ маршруту попытки, поэтому pins
    # загружаем так же, как перед диспетчеризацией. Abandon нужна та же immutable
    # route identity для host-owned lifecycle terminal/cleanup событий.
    _route_v2_load_attempt "$TASK" "$EXPECTED_ATTEMPT" || return
    V2_ATTEMPT=$EXPECTED_ATTEMPT
    v2_lifecycle_begin_session \
      "$EXPECTED_ATTEMPT" resume "$ROUTE_V2_ROUTE" "$ROUTE_V2_ROUTE_HASH" || {
        rc=$?
        v2_log "$MODE: lifecycle session не открыта (код $rc)"
        return "$rc"
      }
  fi
  if [[ "$MODE" == abandon ]]; then
    runtime_interrupt_trusted_active "$TASK" "" "" "" \
      "${FACTORY_TERM_GRACE_SECONDS:-5}"
    rc=$?
    (( rc == 0 || rc == 3 )) || {
      v2_log "abandon: runner quiescence не доказана (код $rc)"
      return "$rc"
    }
    route_v2_cleanup_active_instrumentation "$TASK" "$EXPECTED_ATTEMPT"
    rc=$?
    (( rc == 0 || rc == 3 )) || {
      v2_log "abandon: instrumentation cleanup не завершён (код $rc)"
      return "$rc"
    }
    v2_lifecycle_resolve_human abandon || {
      rc=$?
      v2_log "abandon: human intervention lifecycle не закрыт (код $rc)"
      return "$rc"
    }
    if [[ -n "${FACTORY_LIFECYCLE_NODE_VISIT_ID:-}" ]]; then
      runtime_lifecycle_node_visit_finish_v2 \
        abandoned attempt_terminal attempt_terminal '' '' >/dev/null || return
    fi
    runtime_lifecycle_attempt_interrupted_v2 operator_abandon '' >/dev/null || return
    terminal_file=$(attempt_state_abandon_v2 \
      "$TASK" "$EXPECTED_ATTEMPT" "$REASON") || {
      rc=$?
      v2_log "abandon $EXPECTED_ATTEMPT не принят (код $rc)"
      return "$rc"
    }
    v2_lifecycle_terminal_from_file "$terminal_file" operator_abandon || return
    # Pipeline-проекция для кокпита — только если реестр v2 уже существует:
    # abandon законен и для попытки, упавшей до первой записи реестра.
    v2_shared_lease_release "$EXPECTED_ATTEMPT" || {
      rc=$?
      v2_log "abandon: shared lease не освобождён (код $rc)"
      return "$rc"
    }
    [[ ! -f "$STATE_DIR/t${TASK}.pipeline" ]] ||
      set_st "$TASK" STALLED_HUMAN 1 RESULT abandoned
    v2_log "attempt $EXPECTED_ATTEMPT закрыт терминалом abandoned: $REASON"
    printf 'abandoned %s\n' "$EXPECTED_ATTEMPT"
    return 0
  fi
  local route_hash old_artifacts new_artifacts name new_catalog
  if [[ "$MODE" == goto ]]; then
    local reset guard_message=""
    # Отказ раньше работы: возврат в зону instrument→proof при закрытой транзакции
    # оставил бы маршрут неисполнимым, а узнал бы об этом человек только по падению
    # proof — после того, как промежуточные узлы отработали вхолостую.
    _route_v2_goto_transaction_guard "$TASK" "$GATE_NODE" guard_message || {
      v2_log "goto $GATE_NODE отклонён: $guard_message"
      printf '%s\n' "$guard_message" >&2
      return 75
    }
    # Сбрасываем целевой узел и всё, что идёт после него по последовательности
    # маршрута: возврат назад обязан снять результаты пройденного хвоста.
    reset=$(_route_v2_reset_chain "$GATE_NODE") || {
      v2_log "goto: узел $GATE_NODE отсутствует в маршруте"
      return 2
    }
    attempt_stage_state_human_rewind_v2 \
      "$TASK" "$EXPECTED_ATTEMPT" "$GATE_NODE" "$reset" "$REASON" "${ACTOR:-human}" || {
      rc=$?
      v2_log "goto $GATE_NODE не принят (код $rc)"
      return "$rc"
    }
    v2_lifecycle_resolve_human goto || {
      rc=$?
      v2_log "goto: human intervention lifecycle не закрыт (код $rc)"
      return "$rc"
    }
    # Телеметрия визита узла идёт ПОСЛЕ решения и не вправе его отменить: событие
    # human-rewind уже лежит в immutable журнале попытки, курсор сдвинут, lifecycle
    # человека закрыт. Прежние молчаливые `return` роняли goto после успешной записи —
    # человек получал отказ поверх сделанной работы, проекция реестра оставалась
    # старой, и прогон выглядел непродолженным (случай 28.08.2026).
    # Отказ аналитики называем в журнале и идём дальше: потерянная строка телеметрии
    # дешевле потерянного решения человека.
    if [[ -n "${FACTORY_LIFECYCLE_NODE_VISIT_ID:-}" ]]; then
      stage_hash=$(v2_lifecycle_latest_stage_hash "$EXPECTED_ATTEMPT")
      rc=$?
      if (( rc == 0 )) && [[ -n "$stage_hash" ]]; then
        transition="tr_${stage_hash:0:32}"
        runtime_lifecycle_node_visit_finish_v2 \
          succeeded manual_resume human_rewind "$transition" "$stage_hash" \
          >/dev/null || {
            rc=$?
            v2_log "goto $GATE_NODE записан; визит узла не закрыт в телеметрии (код $rc)"
          }
      else
        v2_log "goto $GATE_NODE записан; hash последнего события этапа не прочитан (код $rc)"
      fi
    fi
    route_v2_project_latest_reset "$TASK" "$EXPECTED_ATTEMPT" || {
      rc=$?
      v2_log "goto $GATE_NODE записан, но reset-проекция не завершена (код $rc)"
      return "$rc"
    }
    # Витрина таймера: метка последнего события сдвинулась на human-rewind.
    route_v2_project_work_time "$TASK" "$EXPECTED_ATTEMPT" || true
    [[ ! -f "$STATE_DIR/t${TASK}.pipeline" ]] ||
      set_st "$TASK" STALLED_HUMAN 0 RESULT human-rewind
    v2_log "курсор возвращён человеком на узел $GATE_NODE: $REASON"
    printf 'rewound %s\n' "$GATE_NODE"
    return 0
  fi
  # У schema 1 runner override существовал только в registry. Schema 2 берёт
  # trusted значение предшественницы внутри attempt_state_recover_v2 и не
  # доверяет этой fallback-проекции. Queue dispatch не передаётся никогда.
  recovery_runner=$(get "$TASK" RUNNER_OVERRIDE_PRIMARY)
  out=$(attempt_state_recover_v2 \
    "$TASK" "$EXPECTED_ATTEMPT" "$REASON" "$recovery_runner") || {
    rc=$?
    [[ "$V2_WORKSPACE_MODE" != shared ]] || v2_shared_lease_release pending || true
    v2_log "recover из $EXPECTED_ATTEMPT не принят (код $rc)"
    return "$rc"
  }
  v2_shared_lease_bind "$out" || {
    rc=$?
    v2_log "recovery attempt создан, но shared lease не закреплён (код $rc)"
    return "$rc"
  }
  route_hash=$(attempt_state_select_route_v2 "$TASK" "$out" "$ROUTE") || {
    rc=$?
    v2_log "route pin для recovery $out не создан (код $rc)"
    return "$rc"
  }
  v2_load_attempt_launch_identity "$out" || {
    rc=$?
    v2_log "recovery launch identity не прочитана (код $rc)"
    return "$rc"
  }
  V2_ATTEMPT=$out
  v2_lifecycle_begin_session "$out" recovery '' '' || {
    rc=$?
    v2_log "recovery $out: lifecycle session не открыта (код $rc)"
    return "$rc"
  }
  v2_lifecycle_route_selected "$out" "$route_hash" operator_override || {
    rc=$?
    v2_log "recovery $out: route lifecycle pin не записан (код $rc)"
    return "$rc"
  }
  # Recovery наследует ВХОДНЫЕ immutable-контракты предшественницы (ticket,
  # delivery, scope, diagnosis) — иначе попытка тупиковая: resume только
  # проверяет артефакты и создавать их не имеет права. Результаты работы
  # (bootstrap.json) намеренно не переносятся: recovery = чистый bootstrap.
  old_artifacts="$(attempt_state_v2_task_root "$TASK")/attempts/$EXPECTED_ATTEMPT/artifacts"
  new_artifacts=$(v2_attempt_artifacts) || return 78
  [[ -d "$new_artifacts" && ! -L "$new_artifacts" ]] || return 78
  for name in ticket.json delivery.tsv instrumentation-scope.tsv diagnosis.env \
    profile-contract.tsv project-context.json; do
    [[ -f "$old_artifacts/$name" && ! -L "$old_artifacts/$name" ]] || continue
    v2_copy_once "$old_artifacts/$name" "$new_artifacts/$name" 400 || {
      rc=$?
      v2_log "recovery: артефакт $name не перенесён (код $rc)"
      return "$rc"
    }
  done
  v2_quarantine_state_artifacts "$EXPECTED_ATTEMPT" || return
  # Реестр — проекция для кокпита, но его читают и агенты: PLAN может увидеть в нём
  # TESTS=done/TCRITIC=done от отменённой попытки и полезть искать
  # несуществующие тесты. Новая попытка обязана начинать с pending по всем узлам
  # своего маршрута, иначе «чистый bootstrap» врёт и человеку, и агентам.
  if [[ -f "$STATE_DIR/t${TASK}.pipeline" ]]; then
    new_catalog=$(_attempt_state_json get \
      "$(attempt_state_v2_task_root "$TASK")/attempts/$out/attempt.json" catalogHash) ||
      return 78
    if [[ -n "$V2_ATTEMPT_RUNNER_PRIMARY_OVERRIDE" ]]; then
      recovery_failover=$(get "$TASK" RUNNER_OVERRIDE_FAILOVER)
    else
      recovery_failover=""
    fi
    # Витрина цикла принадлежит попытке: новая начинает без кругов, а признак режима
    # проставит её собственный диспетчер — иначе recover в обычный маршрут оставил бы
    # LOOP_MODE прежней попытки, и кокпит не пускал бы к ней арбитра. Реестр без
    # признаков цикла остаётся побайтно прежним.
    local key
    local -a loop_reset=()
    for key in LOOP_MODE LOOP_MAX_ROUNDS LOOP_ROUND LOOP_STAGE LOOP_REPORT; do
      [[ -z "$(get "$TASK" "$key")" ]] ||
        loop_reset=(LOOP_MODE "" LOOP_MAX_ROUNDS "" LOOP_ROUND "" LOOP_STAGE "" LOOP_REPORT "")
    done
    set_st "$TASK" --init --stages "$(v2_registry_stage_keys "$new_catalog")" \
      STALLED_HUMAN 0 RESULT recovered ATTEMPT_ID "$out" \
      CATALOG_HASH "$V2_ATTEMPT_CATALOG_HASH" \
      ROUTE "$ROUTE" ROUTE_HASH "$route_hash" ORCH_PID "" \
      QUEUE_DISPATCH_ID "" \
      RUNNER_OVERRIDE_PRIMARY "$V2_ATTEMPT_RUNNER_PRIMARY_OVERRIDE" \
      RUNNER_OVERRIDE_FAILOVER "$recovery_failover" \
      PLAN_DECISION pending CAUSE_DECISION pending ACCEPTANCE_DECISION pending \
      "${loop_reset[@]}"
  fi
  v2_log "recovery attempt $out создан из $EXPECTED_ATTEMPT: $REASON"
  printf '%s\n' "$out"
}

if [[ "$MODE" == abandon || "$MODE" == recover || "$MODE" == goto ]]; then
  v2_admin_main
else
  v2_main
fi
