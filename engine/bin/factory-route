#!/usr/bin/env python3
"""Офлайн-чтение и рендеринг неизменяемых бандлов маршрутов v2.

Сервер публикует bundles, но runtime не доверяет одному факту их наличия: перед pin/render
этот инструмент заново проверяет manifest, hashes, набор файлов и исполняемые инварианты.
Сетевых вызовов и model call здесь нет.
"""

from __future__ import annotations

import argparse
import json
import os
import stat
import sys
from pathlib import Path, PurePosixPath
from typing import Any

# Общая чистая логика используется и для immutable bundle, и для stdin редактора.
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from route_model import (
    ENTITY_RE,
    FAILURE_OWNERS,
    PROFILE_RE,
    RouteV2Error,
    assert_exact_keys,
    assert_hash,
    assert_identifier,
    assert_no_execution_policy,
    assert_route_id,
    built_in_editor_capabilities,
    canonical_json,
    check_editor_catalog,
    fail,
    parse_canonical_json_bytes,
    parse_json_bytes,
    render_node,
    render_editor_catalog,
    step_editor_catalog,
    select_node_transition,
    safe_bundle_path,
    sha256_bytes,
    validate_catalog_route_references,
    validate_machine,
)


def read_regular(path: Path) -> bytes:
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
        )
    except OSError as error:
        fail(f"{path}: файл недоступен: {error}")
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode):
            fail(f"{path}: ожидался обычный файл без symlink")
        with os.fdopen(descriptor, "rb", closefd=True) as source:
            descriptor = -1
            return source.read()
    except OSError as error:
        fail(f"{path}: файл не читается: {error}")
    finally:
        if descriptor >= 0:
            os.close(descriptor)


class BundleReader:
    def __init__(self, routes_dir: Path, profile: str):
        self.routes_dir = self._routes_root(routes_dir)
        self.profile = assert_identifier(profile, PROFILE_RE, "profile")

    @staticmethod
    def _routes_root(routes_dir: Path) -> Path:
        # resolve() скрыл бы сам факт symlink. Runtime сначала проверяет каждый
        # лексический компонент и только после этого использует корень хранилища.
        lexical = Path(os.path.abspath(os.fspath(routes_dir)))
        current = Path(lexical.anchor)
        for part in lexical.parts[1:]:
            current /= part
            try:
                info = current.lstat()
            except OSError as error:
                fail(f"{current}: routes root недоступен: {error}")
            if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
                fail(f"{current}: symlink/не-каталог в routes root")
        return lexical

    def _directory(self, *parts: str) -> Path:
        current = self.routes_dir
        try:
            base_info = current.lstat()
        except OSError as error:
            fail(f"{current}: routes root недоступен: {error}")
        if stat.S_ISLNK(base_info.st_mode) or not stat.S_ISDIR(base_info.st_mode):
            fail(f"{current}: routes root не является обычным каталогом")
        for part in parts:
            current = current / part
            try:
                info = current.lstat()
            except OSError as error:
                fail(f"{current}: каталог bundle недоступен: {error}")
            if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
                fail(f"{current}: symlink/не-каталог в адресе bundle")
        return current

    def _expected_files(self, root: Path, kind: str) -> set[str]:
        found: set[str] = set()
        found_directories: set[str] = set()
        allowed_directories = (
            {"prompts"}
            if kind == "route"
            else {"bootstrap", "bootstrap/prompts"}
        )
        try:
            root_info = root.lstat()
        except OSError as error:
            fail(f"{root}: bundle не найден: {error}")
        if stat.S_ISLNK(root_info.st_mode) or not stat.S_ISDIR(root_info.st_mode):
            fail(f"{root}: bundle не является обычным каталогом")
        for directory, dir_names, file_names in os.walk(root, followlinks=False):
            directory_path = Path(directory)
            for name in list(dir_names):
                child = directory_path / name
                info = child.lstat()
                if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
                    fail(f"{child}: небезопасный компонент bundle")
                relative = child.relative_to(root).as_posix()
                if relative not in allowed_directories:
                    fail(f"{relative}: лишний каталог bundle")
                found_directories.add(relative)
            for name in file_names:
                child = directory_path / name
                info = child.lstat()
                if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
                    fail(f"{child}: bundle содержит не обычный файл")
                found.add(child.relative_to(root).as_posix())
        for directory in found_directories:
            if not any(file.startswith(f"{directory}/") for file in found):
                fail(f"{directory}: лишний пустой каталог bundle")
        return found

    def _verify_bundle(
        self,
        root: Path,
        expected_hash: str,
        kind: str,
        route_id: str | None = None,
    ) -> tuple[dict[str, Any], dict[str, bytes]]:
        assert_hash(expected_hash, "revision hash")
        manifest_bytes = read_regular(root / "manifest.json")
        if sha256_bytes(manifest_bytes) != expected_hash:
            fail(f"{root}: hash manifest не совпадает с именем ревизии")
        manifest = parse_canonical_json_bytes(manifest_bytes, "manifest.json")
        required = {"schema", "kind", "profile", "algorithm", "files"}
        if kind == "route":
            required.add("id")
        assert_exact_keys(manifest, required, set(), "manifest")
        if (
            manifest["schema"] != 2
            or manifest["kind"] != kind
            or manifest["profile"] != self.profile
            or manifest["algorithm"] != "sha256"
            or (kind == "route" and manifest["id"] != route_id)
        ):
            fail("manifest: адрес и метаданные bundle не совпадают")
        entries = manifest["files"]
        if not isinstance(entries, list) or not entries:
            fail("manifest.files: нужен непустой массив")
        declared: list[str] = []
        files: dict[str, bytes] = {}
        for index, entry in enumerate(entries):
            assert_exact_keys(entry, {"path", "sha256", "size"}, set(), f"manifest.files[{index}]")
            relative = entry["path"]
            if (
                not isinstance(relative, str)
                or not safe_bundle_path(kind, relative)
                or relative == "manifest.json"
            ):
                fail(f"manifest.files[{index}].path: небезопасный путь")
            if declared and relative <= declared[-1]:
                fail("manifest.files: пути должны быть уникальны и отсортированы")
            assert_hash(entry["sha256"], f"manifest.files[{index}].sha256")
            if not isinstance(entry["size"], int) or isinstance(entry["size"], bool) or entry["size"] < 0:
                fail(f"manifest.files[{index}].size: недопустимый размер")
            value = read_regular(root.joinpath(*PurePosixPath(relative).parts))
            if len(value) != entry["size"] or sha256_bytes(value) != entry["sha256"]:
                fail(f"{relative}: содержимое не совпадает с manifest")
            declared.append(relative)
            files[relative] = value
        required_files = {"route.json"} if kind == "route" else {
            "catalog.json",
            "bootstrap/scout.json",
        }
        if not required_files.issubset(files):
            fail(f"bundle: отсутствуют обязательные файлы {sorted(required_files - set(files))}")
        actual = self._expected_files(root, kind)
        if actual != set(declared) | {"manifest.json"}:
            fail("bundle: фактический набор файлов не совпадает с manifest")
        return manifest, files

    def read_route(self, route_id: str, route_hash: str) -> dict[str, Any]:
        route_id = assert_route_id(route_id, "route")
        route_hash = assert_hash(route_hash, "route hash")
        root = self._directory(
            self.profile,
            route_id,
            "revisions",
            route_hash,
        )
        manifest, files = self._verify_bundle(root, route_hash, "route", route_id)
        # Exact bytes уже закреплены manifest hash. Повторная сериализация Python
        # не является валидатором канонического JSON сервера: JS и Python по-разному
        # печатают некоторые конечные числа (например 1e-7).
        route = parse_json_bytes(files["route.json"], "route.json")
        try:
            prompts = {
                name: value.decode("utf-8")
                for name, value in files.items()
                if name.endswith(".md")
            }
        except UnicodeDecodeError as error:
            fail(f"route prompts: не UTF-8: {error}")
        validate_machine(route, self.profile, route_id, "route", set(prompts))
        return {
            "hash": route_hash,
            "root": root,
            "manifest": manifest,
            "machine": route,
            "prompts": prompts,
        }

    def read_catalog(self, catalog_hash: str, verify_routes: bool = True) -> dict[str, Any]:
        catalog_hash = assert_hash(catalog_hash, "catalog hash")
        root = self._directory(
            self.profile,
            "catalog",
            "revisions",
            catalog_hash,
        )
        manifest, files = self._verify_bundle(root, catalog_hash, "catalog")
        catalog = parse_canonical_json_bytes(files["catalog.json"], "catalog.json")
        bootstrap = parse_json_bytes(
            files["bootstrap/scout.json"],
            "bootstrap/scout.json",
        )
        assert_exact_keys(catalog, {"schema", "profile", "routes", "bootstrap"}, set(), "catalog")
        assert_no_execution_policy(catalog, "catalog")
        if catalog["schema"] != 2 or catalog["profile"] != self.profile:
            fail("catalog: schema/profile не совпадают")
        if catalog["bootstrap"] != {"file": "bootstrap/scout.json"}:
            fail("catalog.bootstrap: разрешён только bootstrap/scout.json")
        routes = catalog["routes"]
        if not isinstance(routes, dict) or not routes:
            fail("catalog.routes: нужен хотя бы один маршрут")
        for route_id, route_hash in routes.items():
            assert_route_id(route_id, f"catalog.routes.{route_id}")
            assert_hash(route_hash, f"catalog.routes.{route_id}")
        try:
            prompts = {
                name: value.decode("utf-8")
                for name, value in files.items()
                if name.endswith(".md")
            }
        except UnicodeDecodeError as error:
            fail(f"bootstrap prompts: не UTF-8: {error}")
        validate_machine(bootstrap, self.profile, "scout", "bootstrap", set(prompts))
        declared_routes = set(routes)
        validate_catalog_route_references(bootstrap, declared_routes, "bootstrap")
        if verify_routes:
            for route_id, route_hash in routes.items():
                route_bundle = self.read_route(route_id, route_hash)
                validate_catalog_route_references(
                    route_bundle["machine"],
                    declared_routes,
                    f"route.{route_id}",
                )
        return {
            "hash": catalog_hash,
            "root": root,
            "manifest": manifest,
            "catalog": catalog,
            "bootstrap": bootstrap,
            "prompts": prompts,
        }

    def read_current(self) -> dict[str, Any]:
        catalog_dir = self._directory(self.profile, "catalog")
        current_path = catalog_dir / "current.json"
        pointer = parse_canonical_json_bytes(read_regular(current_path), "current.json")
        assert_exact_keys(pointer, {"schema", "catalogHash"}, set(), "current")
        if pointer["schema"] != 2:
            fail("current.schema: поддерживается только v2")
        return self.read_catalog(assert_hash(pointer["catalogHash"], "current.catalogHash"))


def load_context(path_value: str) -> Any:
    return parse_json_bytes(read_regular(Path(path_value)), "context")


def output_json(value: Any) -> None:
    sys.stdout.write(canonical_json(value))


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Проверка и рендеринг route bundles v2")
    parser.add_argument("--routes-dir")
    parser.add_argument("--profile", required=True)
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("editor-check")
    sub.add_parser("editor-render")
    sub.add_parser("editor-step")
    sub.add_parser("editor-capabilities")
    sub.add_parser("current")

    catalog = sub.add_parser("catalog")
    catalog.add_argument("--catalog-hash", required=True)

    route_hash = sub.add_parser("route-hash")
    route_hash.add_argument("--catalog-hash", required=True)
    route_hash.add_argument("--route", required=True)

    describe_bootstrap = sub.add_parser("describe-bootstrap")
    describe_bootstrap.add_argument("--catalog-hash", required=True)

    describe_route = sub.add_parser("describe-route")
    describe_route.add_argument("--catalog-hash", required=True)
    describe_route.add_argument("--route", required=True)

    render_bootstrap = sub.add_parser("render-bootstrap")
    render_bootstrap.add_argument("--catalog-hash", required=True)
    render_bootstrap.add_argument("--node", default="scout")
    render_bootstrap.add_argument("--context", required=True)

    render_route = sub.add_parser("render-route")
    render_route.add_argument("--catalog-hash", required=True)
    render_route.add_argument("--route", required=True)
    render_route.add_argument("--node", required=True)
    render_route.add_argument("--context", required=True)

    transition_bootstrap = sub.add_parser("transition-bootstrap")
    transition_bootstrap.add_argument("--catalog-hash", required=True)
    transition_bootstrap.add_argument("--node", required=True)
    transition_bootstrap.add_argument("--outcome", required=True)
    transition_bootstrap.add_argument("--failure-owner", default="")

    transition = sub.add_parser("transition")
    transition.add_argument("--catalog-hash", required=True)
    transition.add_argument("--route", required=True)
    transition.add_argument("--node", required=True)
    transition.add_argument("--outcome", required=True)
    transition.add_argument("--failure-owner", default="")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    if args.command == "editor-capabilities":
        assert_identifier(args.profile, PROFILE_RE, "profile")
        output_json(built_in_editor_capabilities())
        return 0
    if args.command == "editor-check":
        try:
            payload = sys.stdin.buffer.read(64 * 1024 * 1024 + 1)
            if len(payload) > 64 * 1024 * 1024:
                fail("input: размер больше 64 MiB")
            value = parse_json_bytes(payload, "input")
        except RouteV2Error as error:
            output_json({
                "ok": False,
                "issues": [{"code": "invalid_json", "path": "", "message": str(error)}],
            })
            return 78
        result = check_editor_catalog(value, args.profile)
        output_json(result)
        return 0 if result["ok"] else 78
    if args.command == "editor-render":
        try:
            payload = sys.stdin.buffer.read(64 * 1024 * 1024 + 1)
            if len(payload) > 64 * 1024 * 1024:
                fail("input: размер больше 64 MiB")
            value = parse_json_bytes(payload, "input")
            result = render_editor_catalog(value, args.profile)
        except RouteV2Error:
            result = {"text": "", "includedBlocks": [], "excludedBlocks": [], "issues": [{
                "code": "preview_invalid", "path": "", "message": "Недопустимый запрос предпросмотра"
            }]}
        output_json(result)
        return 0 if result["text"] else 78
    if args.command == "editor-step":
        try:
            payload = sys.stdin.buffer.read(64 * 1024 * 1024 + 1)
            if len(payload) > 64 * 1024 * 1024:
                fail("input: размер больше 64 MiB")
            value = parse_json_bytes(payload, "input")
            result = step_editor_catalog(value, args.profile)
        except RouteV2Error as error:
            result = {"ok": False, "issues": [{"code": "simulation_invalid",
                       "path": "", "message": str(error)}]}
        output_json(result)
        return 0 if result["ok"] else 78
    if args.routes_dir is None:
        fail("--routes-dir обязателен для команд immutable bundle")
    reader = BundleReader(Path(args.routes_dir), args.profile)
    if args.command == "current":
        current = reader.read_current()
        output_json({
            "schema": 2,
            "profile": args.profile,
            "catalogHash": current["hash"],
            "routes": current["catalog"]["routes"],
        })
    elif args.command == "catalog":
        catalog = reader.read_catalog(args.catalog_hash)
        output_json({
            "schema": 2,
            "profile": args.profile,
            "catalogHash": catalog["hash"],
            "routes": catalog["catalog"]["routes"],
        })
    elif args.command == "route-hash":
        catalog = reader.read_catalog(args.catalog_hash)
        route_id = assert_route_id(args.route, "route")
        route_hash = catalog["catalog"]["routes"].get(route_id)
        if not route_hash:
            fail(f"route {route_id}: отсутствует в закреплённом каталоге")
        sys.stdout.write(f"{route_hash}\n")
    elif args.command == "describe-bootstrap":
        catalog = reader.read_catalog(args.catalog_hash)
        output_json({
            "schema": 2,
            "profile": args.profile,
            "catalogHash": catalog["hash"],
            "machine": catalog["bootstrap"],
        })
    elif args.command == "describe-route":
        catalog = reader.read_catalog(args.catalog_hash)
        route_id = assert_route_id(args.route, "route")
        route_hash = catalog["catalog"]["routes"].get(route_id)
        if not route_hash:
            fail(f"route {route_id}: отсутствует в закреплённом каталоге")
        route = reader.read_route(route_id, route_hash)
        output_json({
            "schema": 2,
            "profile": args.profile,
            "catalogHash": catalog["hash"],
            "route": route_id,
            "routeHash": route_hash,
            "machine": route["machine"],
        })
    elif args.command == "render-bootstrap":
        catalog = reader.read_catalog(args.catalog_hash)
        sys.stdout.write(render_node(
            catalog["bootstrap"],
            catalog["prompts"],
            assert_identifier(args.node, ENTITY_RE, "node"),
            load_context(args.context),
        ))
    elif args.command == "render-route":
        catalog = reader.read_catalog(args.catalog_hash)
        route_id = assert_route_id(args.route, "route")
        route_hash = catalog["catalog"]["routes"].get(route_id)
        if not route_hash:
            fail(f"route {route_id}: отсутствует в закреплённом каталоге")
        route = reader.read_route(route_id, route_hash)
        sys.stdout.write(render_node(
            route["machine"],
            route["prompts"],
            assert_identifier(args.node, ENTITY_RE, "node"),
            load_context(args.context),
        ))
    elif args.command == "transition-bootstrap":
        catalog = reader.read_catalog(args.catalog_hash)
        failure_owner = args.failure_owner
        if failure_owner and (args.outcome != "failed" or failure_owner not in FAILURE_OWNERS):
            fail("failure-owner допустим только для outcome failed")
        action, policy, node = select_node_transition(
            catalog["bootstrap"], args.node, args.outcome, failure_owner or None,
        )
        output_json({
            "schema": 2,
            "catalogHash": catalog["hash"],
            "phase": "bootstrap",
            "node": args.node,
            "outcome": args.outcome,
            "action": action,
            "retry": node.get("retry"),
            "escalationPolicy": policy,
        })
    elif args.command == "transition":
        catalog = reader.read_catalog(args.catalog_hash)
        route_id = assert_route_id(args.route, "route")
        route_hash = catalog["catalog"]["routes"].get(route_id)
        if not route_hash:
            fail(f"route {route_id}: отсутствует в закреплённом каталоге")
        route = reader.read_route(route_id, route_hash)
        failure_owner = args.failure_owner
        if failure_owner:
            if args.outcome != "failed" or failure_owner not in FAILURE_OWNERS:
                fail("failure-owner допустим только для outcome failed")
        action, policy, node = select_node_transition(
            route["machine"], args.node, args.outcome, failure_owner or None,
        )
        output_json({
            "schema": 2,
            "catalogHash": catalog["hash"],
            "route": route_id,
            "routeHash": route_hash,
            "node": args.node,
            "outcome": args.outcome,
            "failureOwner": failure_owner or None,
            "action": action,
            "retry": node.get("retry"),
            "escalationPolicy": policy,
        })
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except RouteV2Error as error:
        print(f"route v2: {error}", file=sys.stderr)
        raise SystemExit(78)
