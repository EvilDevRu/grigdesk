#!/usr/bin/env bash
# Provider-neutral foreground launcher for immutable route protocol v2.
#
# It deliberately does not daemonize, select a provider or weaken SHIP. Provider
# choice and failover come only from profiles/<profile>/runners.env. Project
# provisioning remains in the project profile; this wrapper only requests a
# fresh generation=v2 sandbox and never tears it down automatically.
set -uo pipefail

FACTORY_HOME="$(cd "$(dirname "$0")/.." && pwd)"
FACTORY_PROFILES_DIR="${FACTORY_PROFILES_DIR:-$(cd "$FACTORY_HOME/.." && pwd)/profiles}"
FACTORY_RUNNERS_DIR="${FACTORY_RUNNERS_DIR:-$FACTORY_HOME/lib/runners}"
export FACTORY_HOME FACTORY_PROFILES_DIR FACTORY_RUNNERS_DIR

usage() {
  cat <<'EOF'
Использование:
  factory-v2 check --profile PROFILE [--route ROUTE]
                   [--routes-dir ABS]

  factory-v2 TASK start --profile PROFILE --route ROUTE --ticket-json ABS
                   [--routes-dir ABS]
                   [--state-dir ABS] [--control-dir ABS]
                   [--legacy-state-dir ABS]
                   [--instrumentation-file be:PATH|fe:PATH]...
                   [--diagnosis-kind functional|performance|data|integration]
                   [--diagnosis-signal TEXT]
                   [--backend-base REF] [--frontend-base REF]
                   [--delivery-target repo=branch]...
                   [--task-comment]

  factory-v2 TASK resume --attempt a_<32hex> [те же общие пути]

  factory-v2 TASK gate --attempt a_<32hex> --node GATE
                   --decision approved|rejected [--comment TEXT]
                   [--commit-only] [те же общие пути]

  factory-v2 TASK abandon --attempt a_<32hex> --reason TEXT
                   [те же общие пути]

  factory-v2 TASK recover --attempt a_<32hex> --reason TEXT
                   --route ROUTE [те же общие пути]

  factory-v2 TASK goto --attempt a_<32hex> --node NODE --reason TEXT
                   [те же общие пути]

--profile обязателен: движок не знает ни одного проекта. Профиль обязан заявить
capability "route-v2" в graph.json и реализовать v2-хуки контракта
(см. PROFILE-CONTRACT). ROUTE — имя маршрута из current-каталога профиля.

По умолчанию:
  routes store:     ~/.factory/routes
  v2 state:         ~/.factory/state-v2
  trusted control:  ~/.factory/control
  legacy state:     ~/.factory/state

Debug требует хотя бы один --instrumentation-file при start. Feature формирует
scope TRACE из фактического diff непосредственно перед этапом. SHIP выполняет
commit, push и PR после approved GATE_ACCEPT; --task-comment дополнительно
разрешает комментарий во внешней задаче.

Abandon закрывает АКТИВНУЮ попытку терминалом abandoned (штатный выход из
заклинившего прогона). Recover создаёт из abandoned-терминала НОВУЮ попытку
с чистым bootstrap-состоянием и свежим pin текущего каталога; --route сразу
пинит маршрут новой попытки (без него она была бы тупиком: resume требует
route pin). Продолжение после recover — обычный resume с новым --attempt.
Обе операции берут lock оркестратора задачи и не трогают песочницу.

Gate по умолчанию не только фиксирует решение, но и ведёт маршрут дальше — то
есть держит оркестратор столько, сколько работает следующий узел. Вызывающему,
который ждёт ответа синхронно (кокпит — по HTTP), нужен --commit-only: решение
уходит в журнал попытки, команда выходит, а продолжение запускается отдельным
resume. Иначе фиксация упирается в чужой таймаут: TERM убивает оркестратор,
раннер остаётся сиротой, а человек видит «Command failed» на уже принятом
решении.

Goto — человеческий возврат курсора на ПРОЙДЕННЫЙ узел маршрута (эквивалент
кнопки «перейти сюда»): пройденные узлы сбрасываются, в журнал ложится событие
kind=human-rewind с причиной. Вперёд по маршруту прыгать нельзя: исход узла
получается только его исполнением. После goto продолжай обычным resume.
EOF
}

die() {
  printf 'factory-v2: %s\n' "$*" >&2
  exit 78
}

canonical_existing_dir() {
  local value=${1:-} label=${2:-directory} canonical
  [[ -n "$value" && "$value" == /* && "$value" != *$'\n'* &&
     "$value" != *$'\t'* && -d "$value" && ! -L "$value" ]] ||
    die "$label: нужен существующий абсолютный каталог без symlink"
  canonical=$(realpath -e -- "$value" 2>/dev/null) ||
    die "$label: путь не разрешается"
  [[ "$canonical" == "$value" && "$canonical" != / ]] ||
    die "$label: путь должен быть каноническим и не корневым"
  printf '%s\n' "$canonical"
}

canonical_created_dir() {
  local value=${1:-} label=${2:-directory}
  [[ -n "$value" && "$value" == /* && "$value" != / &&
     "$value" != *$'\n'* && "$value" != *$'\t'* ]] ||
    die "$label: нужен абсолютный не корневой путь"
  [[ "$(realpath -m -- "$value" 2>/dev/null)" == "$value" ]] ||
    die "$label: путь должен быть нормализован"
  mkdir -p -- "$value" || die "$label: каталог не создан"
  chmod 700 "$value" 2>/dev/null || true
  canonical_existing_dir "$value" "$label"
}

canonical_file() {
  local value=${1:-} label=${2:-file} canonical
  [[ -n "$value" && "$value" == /* && "$value" != *$'\n'* &&
     "$value" != *$'\t'* && -f "$value" && ! -L "$value" ]] ||
    die "$label: нужен существующий абсолютный обычный файл"
  canonical=$(realpath -e -- "$value" 2>/dev/null) ||
    die "$label: путь не разрешается"
  [[ "$canonical" == "$value" ]] || die "$label: symlink-компоненты запрещены"
  printf '%s\n' "$canonical"
}

paths_disjoint() {
  local left=$1 right=$2
  [[ "$left" != "$right" && "$left" != "$right/"* && "$right" != "$left/"* ]]
}

profile_has_capability() {
  local file=$1 cap=$2
  python3 - "$file" "$cap" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as source:
        data = json.load(source)
except (OSError, ValueError):
    raise SystemExit(1)
caps = data.get("capabilities") if isinstance(data, dict) else None
raise SystemExit(0 if isinstance(caps, list) and sys.argv[2] in caps else 1)
PY
}

json_value() {
  local path=$1
  python3 -c '
import json, sys
value = json.load(sys.stdin)
for key in sys.argv[1].split("."):
    value = value[key]
if isinstance(value, (dict, list)):
    print(json.dumps(value, ensure_ascii=False, sort_keys=True))
else:
    print(value)
' "$path"
}

TASK=""
MODE=""
PROFILE=""
ROUTE=""
FACTORY_USER_HOME="${HOME:-/nonexistent}"
# Имя без поколения намеренно: legacy никогда не хранил маршруты в ~/.factory,
# коллизий нет, а v2-стор — единственный владелец этого каталога.
ROUTES_DIR="$FACTORY_USER_HOME/.factory/routes"
V2_STATE="${STATE_DIR:-${FACTORY_STATE:-$FACTORY_USER_HOME/.factory/state-v2}}"
CONTROL_ROOT="${FACTORY_CONTROL_ROOT:-$FACTORY_USER_HOME/.factory/control}"
LEGACY_STATE="$FACTORY_USER_HOME/.factory/state"
TICKET_JSON=""
EXPECTED_ATTEMPT=""
REASON=""
DIAGNOSIS_KIND=""
DIAGNOSIS_SIGNAL=""
GATE_NODE=""
GATE_DECISION=""
GATE_COMMENT=""
GATE_COMMIT_ONLY=0
BE_BASE_REF=""
FE_BASE_REF=""
TASK_COMMENT=0
declare -a INSTRUMENTATION_SPECS=()
declare -a DELIVERY_TARGETS=()

while (( $# > 0 )); do
  case "$1" in
    check|start|resume|gate|abandon|recover|goto)
      [[ -z "$MODE" ]] || die "режим указан повторно"
      MODE=$1
      shift
      ;;
    --profile)
      (( $# >= 2 )) || die "после --profile нужно значение"
      PROFILE=$2
      shift 2
      ;;
    --route)
      (( $# >= 2 )) || die "после --route нужно значение"
      ROUTE=$2
      shift 2
      ;;
    --routes-dir)
      (( $# >= 2 )) || die "после --routes-dir нужен путь"
      ROUTES_DIR=$2
      shift 2
      ;;
    --state-dir)
      (( $# >= 2 )) || die "после --state-dir нужен путь"
      V2_STATE=$2
      shift 2
      ;;
    --control-dir)
      (( $# >= 2 )) || die "после --control-dir нужен путь"
      CONTROL_ROOT=$2
      shift 2
      ;;
    --legacy-state-dir)
      (( $# >= 2 )) || die "после --legacy-state-dir нужен путь"
      LEGACY_STATE=$2
      shift 2
      ;;
    --ticket-json)
      (( $# >= 2 )) || die "после --ticket-json нужен путь"
      TICKET_JSON=$2
      shift 2
      ;;
    --attempt)
      (( $# >= 2 )) || die "после --attempt нужен id"
      [[ -z "$EXPECTED_ATTEMPT" ]] || die "--attempt указан повторно"
      EXPECTED_ATTEMPT=$2
      shift 2
      ;;
    --reason)
      (( $# >= 2 )) || die "после --reason нужен текст"
      [[ -z "$REASON" ]] || die "--reason указан повторно"
      REASON=$2
      shift 2
      ;;
    --diagnosis-kind)
      (( $# >= 2 )) || die "после --diagnosis-kind нужно значение"
      DIAGNOSIS_KIND=$2
      shift 2
      ;;
    --diagnosis-signal)
      (( $# >= 2 )) || die "после --diagnosis-signal нужен текст"
      DIAGNOSIS_SIGNAL=$2
      shift 2
      ;;
    --node|--gate)
      (( $# >= 2 )) || die "после $1 нужен gate id"
      [[ -z "$GATE_NODE" ]] || die "gate id указан повторно"
      GATE_NODE=$2
      shift 2
      ;;
    --decision)
      (( $# >= 2 )) || die "после --decision нужно approved|rejected"
      GATE_DECISION=$2
      shift 2
      ;;
    --comment)
      (( $# >= 2 )) || die "после --comment нужен текст"
      GATE_COMMENT=$2
      shift 2
      ;;
    --commit-only)
      GATE_COMMIT_ONLY=1
      shift
      ;;
    --instrumentation-file)
      (( $# >= 2 )) || die "после --instrumentation-file нужен repo:path"
      INSTRUMENTATION_SPECS+=("$2")
      shift 2
      ;;
    --backend-base)
      (( $# >= 2 )) || die "после --backend-base нужен commit/ref"
      BE_BASE_REF=$2
      shift 2
      ;;
    --frontend-base)
      (( $# >= 2 )) || die "после --frontend-base нужен commit/ref"
      FE_BASE_REF=$2
      shift 2
      ;;
    --delivery-target)
      (( $# >= 2 )) || die "после --delivery-target нужен repo=branch"
      DELIVERY_TARGETS+=("$2")
      shift 2
      ;;
    --task-comment)
      TASK_COMMENT=1
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      if [[ -z "$TASK" && "$1" =~ ^[1-9][0-9]{0,18}$ ]]; then
        TASK=$1
        shift
      else
        die "неизвестный аргумент: $1"
      fi
      ;;
  esac
done

[[ "$MODE" == check || "$MODE" == start || "$MODE" == resume ||
   "$MODE" == gate || "$MODE" == abandon || "$MODE" == recover ||
   "$MODE" == goto ]] ||
  die "укажи check, start, resume, gate, abandon, recover или goto"
# Движок не знает ни одного проекта: профиль обязателен, готовность к v2 он
# заявляет capability в graph.json, а конкретику отдаёт v2-хуками контракта.
[[ -n "$PROFILE" && "$PROFILE" =~ ^[a-z][a-z0-9_-]{0,40}$ ]] ||
  die "нужен --profile (движок не знает проектов)"
[[ -z "$ROUTE" || "$ROUTE" =~ ^[a-z][a-z0-9_-]{0,40}$ ]] ||
  die "route: недопустимое имя (маршрут валидируется по current-каталогу)"

ROUTES_DIR=$(canonical_existing_dir "$ROUTES_DIR" routes-dir) || exit 78
PF_FILE=$(canonical_file "$FACTORY_PROFILES_DIR/$PROFILE/profile.sh" profile) || exit 78
RUNNER_CONFIG_FILE=$(canonical_file "$FACTORY_PROFILES_DIR/$PROFILE/runners.env" runners-config) || exit 78
GRAPH_FILE=$(canonical_file "$FACTORY_PROFILES_DIR/$PROFILE/graph.json" graph) || exit 78
profile_has_capability "$GRAPH_FILE" route-v2 ||
  die "профиль $PROFILE не заявляет capability \"route-v2\" в graph.json"

# shellcheck disable=SC1091
source "$FACTORY_HOME/lib/profile-config.sh"
profile_config_validate "$RUNNER_CONFIG_FILE" ||
  die "canonical runners.env не прошёл проверку"
[[ "$(profile_config_get "$RUNNER_CONFIG_FILE" RUNNERS_COVERAGE)" == required ]] ||
  die "runners.env обязан требовать coverage"

CURRENT_CATALOG=""
if [[ "$MODE" == check || "$MODE" == start ]]; then
  CURRENT_JSON=$(
    "$FACTORY_HOME/bin/factory-route-v2" \
      --routes-dir "$ROUTES_DIR" --profile "$PROFILE" current
  ) || die "current catalog v2 не прошёл проверку"
  CURRENT_CATALOG=$(json_value catalogHash <<<"$CURRENT_JSON") ||
    die "catalog hash не прочитан"
  if [[ -n "$ROUTE" ]]; then
    "$FACTORY_HOME/bin/factory-route-v2" \
      --routes-dir "$ROUTES_DIR" --profile "$PROFILE" route-hash \
      --catalog-hash "$CURRENT_CATALOG" --route "$ROUTE" >/dev/null ||
      die "route=$ROUTE отсутствует в current catalog"
  fi
fi

if [[ "$MODE" == check ]]; then
  [[ -z "$TASK" && -z "$EXPECTED_ATTEMPT" && -z "$TICKET_JSON" ]] ||
    die "check не принимает task, attempt или ticket"
  printf 'OK profile=%s catalog=%s' "$PROFILE" "$CURRENT_CATALOG"
  [[ -z "$ROUTE" ]] || printf ' route=%s' "$ROUTE"
  printf '\n'
  exit 0
fi

[[ "${FACTORY_FORBID_LIVE:-0}" != 1 ]] ||
  die "live lifecycle запрещён текущим окружением"
[[ "$TASK" =~ ^[1-9][0-9]{0,18}$ ]] || die "нужен положительный TASK"
if [[ "$MODE" == start ]]; then
  [[ -n "$ROUTE" ]] || die "start требует --route"
  [[ -n "$TICKET_JSON" ]] || die "start требует --ticket-json"
  TICKET_JSON=$(canonical_file "$TICKET_JSON" ticket-json) || exit 78
  [[ -z "$EXPECTED_ATTEMPT" && -z "$GATE_NODE" && -z "$GATE_DECISION" ]] ||
    die "start не принимает attempt или gate decision"
  if [[ "$ROUTE" == debug ]]; then
    (( ${#INSTRUMENTATION_SPECS[@]} > 0 )) ||
      die "debug start требует --instrumentation-file repo:path"
  elif (( ${#INSTRUMENTATION_SPECS[@]} > 0 )); then
    die "--instrumentation-file нужен только debug; feature TRACE берёт scope из diff"
  fi
  if [[ -n "$DIAGNOSIS_KIND" ]]; then
    [[ "$DIAGNOSIS_KIND" =~ ^(functional|performance|data|integration)$ ]] ||
      die "diagnosis-kind: functional|performance|data|integration"
  fi
  [[ ${#DIAGNOSIS_SIGNAL} -le 200 && "$DIAGNOSIS_SIGNAL" != *$'\n'* &&
     "$DIAGNOSIS_SIGNAL" != *$'\t'* ]] ||
    die "diagnosis-signal: до 200 символов одной строкой"
else
  [[ "$EXPECTED_ATTEMPT" =~ ^a_[a-f0-9]{32}$ ]] ||
    die "$MODE требует точный --attempt a_<32hex>"
  [[ -z "$TICKET_JSON" && ${#INSTRUMENTATION_SPECS[@]} -eq 0 &&
     ${#DELIVERY_TARGETS[@]} -eq 0 && "$TASK_COMMENT" == 0 &&
     -z "$BE_BASE_REF" && -z "$FE_BASE_REF" &&
     -z "$DIAGNOSIS_KIND" && -z "$DIAGNOSIS_SIGNAL" ]] ||
    die "$MODE использует immutable ticket, scope, diagnosis, sandbox и delivery попытки"
fi
if [[ "$MODE" == abandon || "$MODE" == recover || "$MODE" == goto ]]; then
  [[ -n "$REASON" ]] || die "$MODE требует --reason"
else
  [[ -z "$REASON" ]] || die "--reason допустим только в abandon, recover и goto"
fi
if [[ "$MODE" == goto ]]; then
  [[ "$GATE_NODE" =~ ^[a-z0-9][a-z0-9_-]{0,40}$ ]] ||
    die "goto требует --node с узлом маршрута"
fi
if [[ "$MODE" == recover ]]; then
  [[ -n "$ROUTE" ]] || die "recover требует --route для новой попытки"
elif [[ "$MODE" == abandon ]]; then
  [[ -z "$ROUTE" ]] || die "--route не используется в abandon"
fi
if [[ "$MODE" == gate ]]; then
  [[ "$GATE_NODE" =~ ^[a-z0-9][a-z0-9_-]{0,40}$ ]] ||
    die "gate требует --node"
  [[ "$GATE_DECISION" == approved || "$GATE_DECISION" == rejected ]] ||
    die "gate требует --decision approved|rejected"
elif [[ -n "$GATE_DECISION" || -n "$GATE_COMMENT" || "$GATE_COMMIT_ONLY" == 1 ]] ||
     { [[ -n "$GATE_NODE" && "$MODE" != goto ]]; }; then
  die "gate arguments допустимы только в режиме gate"
fi

V2_STATE=$(canonical_created_dir "$V2_STATE" state-dir) || exit 78
CONTROL_ROOT=$(canonical_created_dir "$CONTROL_ROOT" control-dir) || exit 78
LEGACY_STATE=$(canonical_existing_dir "$LEGACY_STATE" legacy-state-dir) || exit 78
paths_disjoint "$V2_STATE" "$LEGACY_STATE" ||
  die "v2 state и legacy state должны быть непересекающимися"
paths_disjoint "$V2_STATE" "$CONTROL_ROOT" ||
  die "provider-writable state и trusted control должны быть непересекающимися"

export STATE_DIR="$V2_STATE"
export FACTORY_STATE="$V2_STATE"
export FACTORY_V2_STATE_DIR="$V2_STATE"
export FACTORY_CONTROL_ROOT="$CONTROL_ROOT"
export FACTORY_LEGACY_STATE_DIR="$LEGACY_STATE"
export PROFILE_NAME="$PROFILE"
unset BASH_ENV ENV

# shellcheck disable=SC1091
source "$FACTORY_HOME/lib/core.sh"
# shellcheck disable=SC1090
source "$PF_FILE"
# shellcheck disable=SC1091
source "$FACTORY_HOME/lib/attempt-state.sh"
# shellcheck disable=SC1091
source "$FACTORY_HOME/lib/route-runtime-v2.sh"
# shellcheck disable=SC1091
source "$FACTORY_HOME/lib/profile-preflight.sh"

# Все проектные величины приходят из v2-хуков профиля (PROFILE-CONTRACT);
# движок только fail-closed валидирует форму. Пути worktree могут ещё не
# существовать (их создаст up.sh профиля) — проверяется форма, а не наличие.
v2_hook_path_shape() {
  local value=${1:-} label=${2:-path}
  [[ -n "$value" && "$value" == /* && "$value" != / &&
     "$value" != *$'\n'* && "$value" != *$'\t'* ]] ||
    die "$label: хук профиля вернул не абсолютный путь"
  [[ "$(realpath -m -- "$value" 2>/dev/null)" == "$value" ]] ||
    die "$label: путь должен быть нормализован"
  printf '%s\n' "$value"
}

for v2_hook in profile_v2_backend_source profile_v2_frontend_source \
  profile_v2_backend_worktree profile_v2_frontend_worktree \
  profile_v2_source_branch profile_v2_container profile_v2_sandbox_alive; do
  declare -F "$v2_hook" >/dev/null ||
    die "профиль $PROFILE не реализует v2-хук $v2_hook (см. PROFILE-CONTRACT)"
done
unset v2_hook

V2_BE_SOURCE=$(profile_v2_backend_source) || die "profile_v2_backend_source отказал"
V2_BE_SOURCE=$(canonical_existing_dir "$V2_BE_SOURCE" backend-source) || exit 78
V2_FE_SOURCE=$(profile_v2_frontend_source) || die "profile_v2_frontend_source отказал"
V2_FE_SOURCE=$(canonical_existing_dir "$V2_FE_SOURCE" frontend-source) || exit 78
V2_BE_WORKTREE=$(profile_v2_backend_worktree "$TASK") ||
  die "profile_v2_backend_worktree отказал"
V2_BE_WORKTREE=$(v2_hook_path_shape "$V2_BE_WORKTREE" backend-worktree) || exit 78
V2_FE_WORKTREE=$(profile_v2_frontend_worktree "$TASK") ||
  die "profile_v2_frontend_worktree отказал"
V2_FE_WORKTREE=$(v2_hook_path_shape "$V2_FE_WORKTREE" frontend-worktree) || exit 78
paths_disjoint "$V2_BE_WORKTREE" "$V2_BE_SOURCE" ||
  die "backend worktree не должен пересекаться с основным репозиторием"
paths_disjoint "$V2_FE_WORKTREE" "$V2_FE_SOURCE" ||
  die "frontend worktree не должен пересекаться с основным репозиторием"
V2_SOURCE_BRANCH=$(profile_v2_source_branch "$TASK") ||
  die "profile_v2_source_branch отказал"
[[ "$V2_SOURCE_BRANCH" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,79}$ &&
   "$V2_SOURCE_BRANCH" != *..* ]] ||
  die "source-branch: недопустимое имя ветки"
V2_CONTAINER=$(profile_v2_container "$TASK") || die "profile_v2_container отказал"
[[ "$V2_CONTAINER" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$ ]] ||
  die "container: недопустимое имя"

V2_SANDBOX_ENV="$STATE_DIR/t${TASK}.env"
V2_SCOPE_FILE="$STATE_DIR/t${TASK}.instrumentation-scope.list"
V2_ATTEMPT=""
V2_TRUSTED_TICKET=""
V2_SCOPE_SPEC=""
V2_DELIVERY_SPEC=""
V2_SCOPE_EXPECTED_HASH=""
V2_FE_PORT=""
V2_API_PORT=""

# The legacy profile hook points at worktree-t<TASK>. V2 owns a different,
# generation-specific worktree and must never fall back to an older sandbox.
profile_agent_cwd() {
  [[ -d "$V2_BE_WORKTREE" ]] && printf '%s\n' "$V2_BE_WORKTREE"
}

v2_log() {
  flog "$TASK" "v2: $*"
}

v2_lock() {
  local lock_dir
  lock_dir="$(factory_control_root)/protocol-v2/orchestrators"
  mkdir -p -- "$lock_dir" || return 1
  [[ -d "$lock_dir" && ! -L "$lock_dir" ]] || return 78
  exec {V2_LOCK_FD}>"$lock_dir/t${TASK}.lock" || return 1
  flock -n "$V2_LOCK_FD" || return 73
}

v2_copy_once() {
  local source=$1 destination=$2 mode=$3 dir tmp source_hash existing_hash
  [[ -f "$source" && ! -L "$source" ]] || return 78
  dir=$(dirname "$destination")
  [[ -d "$dir" && ! -L "$dir" ]] || return 78
  source_hash=$(sha256sum -- "$source" | awk '{print $1}') || return 1
  if [[ -e "$destination" || -L "$destination" ]]; then
    [[ -f "$destination" && ! -L "$destination" ]] || return 75
    existing_hash=$(sha256sum -- "$destination" | awk '{print $1}') || return 1
    [[ "$existing_hash" == "$source_hash" ]] || return 75
    return 0
  fi
  tmp=$(mktemp "$dir/.v2-copy.XXXXXX") || return 1
  cp -- "$source" "$tmp" || {
    rm -f -- "$tmp"
    return 1
  }
  chmod "$mode" "$tmp" || {
    rm -f -- "$tmp"
    return 1
  }
  mv -- "$tmp" "$destination"
}

v2_attempt_artifacts() {
  local root
  root=$(attempt_state_v2_task_root "$TASK") || return
  printf '%s/attempts/%s/artifacts\n' "$root" "$V2_ATTEMPT"
}

# Проверенные записи журнала попытки (node:outcome:sequence) для evidence
# контекста: цепочка событий только что переверифицирована чтением курсора,
# сами файлы событий immutable (0400). init и паузы без исхода пропускаются.
v2_ledger_stage_results() {
  local task=$1 attempt=$2 root
  root=$(attempt_state_v2_task_root "$task") || return
  python3 - "$root/attempts/$attempt/stage-results" <<'PY'
import json
import os
import re
import stat
import sys

directory = sys.argv[1]
name_re = re.compile(r"^event\.[0-9]{20}\.[a-f0-9]{64}\.json$")
node_re = re.compile(r"^[a-z0-9][a-z0-9_-]{0,40}$")
outcome_re = re.compile(r"^[a-z][a-z-]{0,20}$")
rows = []
try:
    names = sorted(os.listdir(directory))
except FileNotFoundError:
    names = []
except OSError:
    raise SystemExit(78)
for name in names:
    if not name_re.fullmatch(name):
        continue
    path = os.path.join(directory, name)
    try:
        info = os.lstat(path)
        if not stat.S_ISREG(info.st_mode):
            raise SystemExit(78)
        with open(path, encoding="utf-8") as source:
            event = json.load(source)
    except (OSError, ValueError):
        raise SystemExit(78)
    if not isinstance(event, dict) or event.get("kind") == "init":
        continue
    outcome = event.get("outcome")
    if outcome in (None, ""):
        continue
    node = event.get("node")
    sequence = event.get("sequence")
    if (
        not isinstance(node, str) or not node_re.fullmatch(node)
        or not isinstance(outcome, str) or not outcome_re.fullmatch(outcome)
        or not isinstance(sequence, int) or isinstance(sequence, bool)
        or not 1 <= sequence <= 999_999
    ):
        raise SystemExit(78)
    rows.append((sequence, node, outcome))
rows.sort()
for sequence, node, outcome in rows:
    print(f"{node}:{outcome}:{sequence}")
PY
}

v2_install_ticket() {
  local destination
  destination="$(v2_attempt_artifacts)/ticket.json"
  if [[ "$MODE" == start ]]; then
    v2_copy_once "$TICKET_JSON" "$destination" 400 || return
  fi
  [[ -f "$destination" && ! -L "$destination" &&
     "$(stat -c '%a:%h' "$destination" 2>/dev/null)" == 400:1 ]] || return 78
  V2_TRUSTED_TICKET=$destination
}

# Диагноз попытки immutable, как ticket: заданный на start сохраняется в артефактах
# и переживает resume/gate. Без файла контекст держит честные дефолты
# (functional/unspecified) — молчаливой потери заданных значений быть не может.
v2_install_diagnosis() {
  local destination tmp
  destination="$(v2_attempt_artifacts)/diagnosis.env"
  if [[ "$MODE" == start && ( -n "$DIAGNOSIS_KIND" || -n "$DIAGNOSIS_SIGNAL" ) ]]; then
    tmp=$(mktemp "$STATE_DIR/.v2-diagnosis.XXXXXX") || return 1
    printf 'KIND=%s\nSIGNAL=%s\n' \
      "${DIAGNOSIS_KIND:-functional}" "${DIAGNOSIS_SIGNAL:-unspecified}" >"$tmp" || {
      rm -f -- "$tmp"
      return 1
    }
    v2_copy_once "$tmp" "$destination" 400 || {
      rm -f -- "$tmp"
      return 75
    }
    rm -f -- "$tmp"
  fi
  if [[ -e "$destination" || -L "$destination" ]]; then
    [[ -f "$destination" && ! -L "$destination" &&
       "$(stat -c '%a:%h' "$destination" 2>/dev/null)" == 400:1 ]] || return 78
    DIAGNOSIS_KIND=$(sed -n 's/^KIND=//p' "$destination" | head -1)
    DIAGNOSIS_SIGNAL=$(sed -n 's/^SIGNAL=//p' "$destination" | head -1)
    [[ "$DIAGNOSIS_KIND" =~ ^(functional|performance|data|integration)$ &&
       ${#DIAGNOSIS_SIGNAL} -le 200 ]] || return 78
  fi
}

v2_parse_scope_spec() {
  local value=$1 repo rel part
  [[ "$value" == *:* && "$value" != *$'\n'* && "$value" != *$'\t'* &&
     "$value" != *\\* ]] || return 2
  repo=${value%%:*}
  rel=${value#*:}
  [[ "$repo" == be || "$repo" == fe ]] || return 2
  [[ -n "$rel" && "$rel" != /* && "$rel" != */ &&
     "$rel" != . && "$rel" != .. ]] || return 2
  IFS=/ read -r -a parts <<<"$rel"
  for part in "${parts[@]}"; do
    [[ -n "$part" && "$part" != . && "$part" != .. ]] || return 2
  done
  case "$rel" in
    .git|.git/*|.env|.env.*|*/.env|*/.env.*|.slot|*/.slot) return 2 ;;
  esac
  printf '%s\t%s\n' "$repo" "$rel"
}

v2_install_scope_spec() {
  local destination tmp spec parsed
  destination="$(v2_attempt_artifacts)/instrumentation-scope.tsv"
  # Артефакт создаётся только когда scope задан (--instrumentation-file, т.е. debug):
  # у feature на старте scope пуст ЗАКОННО — TRACE возьмёт его из диффа. Найдено
  # живым прогоном t8165: безусловная ветка требовала непустой scope и валила start.
  if [[ "$MODE" == start && ${#INSTRUMENTATION_SPECS[@]} -gt 0 ]]; then
    tmp=$(mktemp "$(dirname "$destination")/.scope-spec.XXXXXX") || return 1
    for spec in "${INSTRUMENTATION_SPECS[@]}"; do
      parsed=$(v2_parse_scope_spec "$spec") || {
        rm -f -- "$tmp"
        return 2
      }
      printf '%s\n' "$parsed" >>"$tmp"
    done
    LC_ALL=C sort -u -o "$tmp" "$tmp" || {
      rm -f -- "$tmp"
      return 1
    }
    [[ -s "$tmp" ]] || {
      rm -f -- "$tmp"
      return 2
    }
    chmod 400 "$tmp" || return 1
    mv -- "$tmp" "$destination" || return 1
  fi
  if [[ "$ROUTE" == debug ]]; then
    [[ -f "$destination" && ! -L "$destination" &&
       "$(stat -c '%a:%h' "$destination" 2>/dev/null)" == 400:1 ]] || return 78
    V2_SCOPE_SPEC=$destination
  elif [[ -e "$destination" || -L "$destination" ]]; then
    return 78
  fi
}

v2_delivery_target_valid() {
  local value=$1 repo branch
  [[ "$value" == *=* && "$value" != *$'\n'* && "$value" != *$'\t'* ]] || return 2
  repo=${value%%=*}
  branch=${value#*=}
  [[ "$repo" =~ ^[a-z0-9][a-z0-9_-]{0,63}$ &&
     "$branch" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,254}$ &&
     "$branch" != *..* && "$branch" != *//* && "$branch" != *"@{"* &&
     "$branch" != */ && "$branch" != *. && "$branch" != *.lock ]] || return 2
  printf '%s\t%s\n' "$repo" "$branch"
}

v2_install_delivery_spec() {
  local destination tmp action target parsed
  destination="$(v2_attempt_artifacts)/delivery.tsv"
  if [[ "$MODE" == start ]]; then
    (( ${#DELIVERY_TARGETS[@]} > 0 )) ||
      DELIVERY_TARGETS=(be=master fe=main)
    tmp=$(mktemp "$(dirname "$destination")/.delivery.XXXXXX") || return 1
    for action in commit push pull-request; do
      printf 'action\t%s\n' "$action" >>"$tmp"
    done
    (( TASK_COMMENT == 0 )) || printf 'action\ttask-comment\n' >>"$tmp"
    for target in "${DELIVERY_TARGETS[@]}"; do
      parsed=$(v2_delivery_target_valid "$target") || {
        rm -f -- "$tmp"
        return 2
      }
      printf 'target\t%s\n' "${parsed//$'\t'/=}" >>"$tmp"
    done
    LC_ALL=C sort -u -o "$tmp" "$tmp" || {
      rm -f -- "$tmp"
      return 1
    }
    chmod 400 "$tmp" || return 1
    mv -- "$tmp" "$destination" || return 1
  fi
  [[ -f "$destination" && ! -L "$destination" &&
     "$(stat -c '%a:%h' "$destination" 2>/dev/null)" == 400:1 ]] || return 78
  V2_DELIVERY_SPEC=$destination
  DELIVERY_TARGETS=()
  TASK_COMMENT=0
  while IFS=$'\t' read -r action target; do
    case "$action:$target" in
      action:commit|action:push|action:pull-request) ;;
      action:task-comment) TASK_COMMENT=1 ;;
      target:*)
        parsed=$(v2_delivery_target_valid "$target") || return 78
        DELIVERY_TARGETS+=("${parsed//$'\t'/=}")
        ;;
      *)
        return 78
        ;;
    esac
  done <"$destination"
  (( ${#DELIVERY_TARGETS[@]} > 0 )) || return 78
  grep -Fxq $'action\tcommit' "$destination" &&
    grep -Fxq $'action\tpush' "$destination" &&
    grep -Fxq $'action\tpull-request' "$destination"
}

v2_sandbox_state() {
  local count=0
  [[ -e "$V2_SANDBOX_ENV" || -L "$V2_SANDBOX_ENV" ]] && count=$((count + 1))
  [[ -e "$V2_BE_WORKTREE" || -L "$V2_BE_WORKTREE" ]] && count=$((count + 1))
  [[ -e "$V2_FE_WORKTREE" || -L "$V2_FE_WORKTREE" ]] && count=$((count + 1))
  if (( count == 0 )); then
    printf 'absent\n'
  elif (( count == 3 )) &&
       [[ -f "$V2_SANDBOX_ENV" && ! -L "$V2_SANDBOX_ENV" &&
          -d "$V2_BE_WORKTREE" && ! -L "$V2_BE_WORKTREE" &&
          -d "$V2_FE_WORKTREE" && ! -L "$V2_FE_WORKTREE" ]]; then
    printf 'ready\n'
  else
    printf 'partial\n'
  fi
}

v2_env_get() {
  local key=$1
  awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); value=$0} END {print value}' \
    "$V2_SANDBOX_ENV"
}

v2_read_sandbox() {
  local task generation be fe be_branch fe_branch sb_k
  [[ -f "$V2_SANDBOX_ENV" && ! -L "$V2_SANDBOX_ENV" ]] || return 78
  task=$(v2_env_get TASK)
  generation=$(v2_env_get GENERATION)
  be=$(v2_env_get BE_WT)
  fe=$(v2_env_get FE_WT)
  be_branch=$(v2_env_get BE_BRANCH)
  fe_branch=$(v2_env_get FE_BRANCH)
  sb_k=$(v2_env_get SB_K)
  V2_API_PORT=$(v2_env_get API_PORT)
  V2_FE_PORT=$(v2_env_get FE_PORT)
  [[ "$task" == "$TASK" && "$generation" == v2 &&
     "$be" == "$V2_BE_WORKTREE" && "$fe" == "$V2_FE_WORKTREE" &&
     "$be_branch" == "$V2_SOURCE_BRANCH" && "$fe_branch" == "$V2_SOURCE_BRANCH" &&
     "$sb_k" =~ ^[0-9]+$ && "$V2_API_PORT" =~ ^[1-9][0-9]{3,4}$ &&
     "$V2_FE_PORT" =~ ^[1-9][0-9]{3,4}$ ]] || return 78
  git -C "$V2_BE_WORKTREE" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 78
  git -C "$V2_FE_WORKTREE" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 78
  # Живость стека песочницы проверяет профиль: движок не знает, docker это или нет.
  profile_v2_sandbox_alive "$TASK" || return 73
  set_st "$TASK" FE_PORT "$V2_FE_PORT" API_PORT "$V2_API_PORT" SB_K "$sb_k" \
    SANDBOX_GENERATION v2
}

v2_sandbox_up() {
  local state
  state=$(v2_sandbox_state) || return
  case "$state" in
    ready)
      ;;
    absent)
      [[ "$MODE" == start ]] || return 73
      STATE_DIR="$STATE_DIR" \
        FACTORY_SANDBOX_GENERATION=v2 \
        FACTORY_REQUIRE_NEW_SANDBOX=1 \
        FACTORY_BE_BASE_REF="$BE_BASE_REF" \
        FACTORY_FE_BASE_REF="$FE_BASE_REF" \
        bash "$FACTORY_PROFILES_DIR/$PROFILE/up.sh" "$TASK" \
        >>"$LOGDIR/t${TASK}.orch.log" 2>&1 || return
      ;;
    partial)
      v2_log "обнаружена частично созданная песочница; автоматическое удаление запрещено"
      return 75
      ;;
    *)
      return 78
      ;;
  esac
  v2_read_sandbox
}

route_v2_workspace_roots() {
  printf '%s\n' "$V2_BE_WORKTREE" "$V2_FE_WORKTREE"
}

route_v2_sensitive_files() {
  local candidate
  for candidate in \
    "$V2_BE_WORKTREE/.env" \
    "$V2_BE_WORKTREE/.env.testing" \
    "$V2_BE_WORKTREE/.slot" \
    "$V2_FE_WORKTREE/.env" \
    "$V2_FE_WORKTREE/.slot"; do
    [[ -e "$candidate" || -L "$candidate" ]] && printf '%s\n' "$candidate"
  done
}

v2_scope_candidate() {
  local root=$1 rel=$2 absolute parent canonical_parent
  [[ -n "$rel" && "$rel" != /* && "$rel" != *$'\n'* && "$rel" != *$'\t'* ]] ||
    return 2
  case "$rel" in
    .git|.git/*|.env|.env.*|*/.env|*/.env.*|.slot|*/.slot) return 3 ;;
  esac
  absolute="$root/$rel"
  parent=$(dirname "$absolute")
  [[ -d "$parent" && ! -L "$parent" ]] || return 2
  canonical_parent=$(realpath -e -- "$parent" 2>/dev/null) || return 2
  [[ "$canonical_parent/$(basename "$absolute")" == "$absolute" &&
     "$absolute" == "$root/"* && ! -L "$absolute" && ! -d "$absolute" ]] || return 2
  printf '%s\n' "$absolute"
}

v2_publish_scope_tmp() {
  local tmp=$1
  LC_ALL=C sort -u -o "$tmp" "$tmp" || return 1
  [[ -s "$tmp" ]] || return 73
  chmod 600 "$tmp" || return 1
  mv -f -- "$tmp" "$V2_SCOPE_FILE" || return 1
  V2_SCOPE_EXPECTED_HASH=$(sha256sum -- "$V2_SCOPE_FILE" | awk '{print $1}') ||
    return 1
}

v2_scope_from_spec() {
  local tmp repo rel root candidate
  tmp=$(mktemp "$STATE_DIR/.scope.XXXXXX") || return 1
  while IFS=$'\t' read -r repo rel; do
    case "$repo" in
      be) root=$V2_BE_WORKTREE ;;
      fe) root=$V2_FE_WORKTREE ;;
      *) rm -f -- "$tmp"; return 78 ;;
    esac
    candidate=$(v2_scope_candidate "$root" "$rel")
    case "$?" in
      0) printf '%s\n' "$candidate" >>"$tmp" ;;
      *) rm -f -- "$tmp"; return 78 ;;
    esac
  done <"$V2_SCOPE_SPEC"
  v2_publish_scope_tmp "$tmp"
}

v2_scope_from_diff() {
  local tmp root rel candidate rc
  tmp=$(mktemp "$STATE_DIR/.scope.XXXXXX") || return 1
  for root in "$V2_BE_WORKTREE" "$V2_FE_WORKTREE"; do
    while IFS= read -r -d '' rel; do
      candidate=$(v2_scope_candidate "$root" "$rel")
      rc=$?
      case "$rc" in
        0) printf '%s\n' "$candidate" >>"$tmp" ;;
        3) ;;
        *) rm -f -- "$tmp"; return 78 ;;
      esac
    done < <(
      {
        git -C "$root" diff --name-only -z HEAD --
        git -C "$root" ls-files --others --exclude-standard -z
      } | sort -zu
    )
  done
  v2_publish_scope_tmp "$tmp"
}

v2_prepare_scope() {
  case "$ROUTE" in
    debug) v2_scope_from_spec ;;
    feature) v2_scope_from_diff ;;
    *) return 78 ;;
  esac
}

route_v2_instrumentation_scope_invariant() {
  local invariant_task=$1 invariant_attempt=$2 scope=$3 hash
  [[ "$invariant_task" == "$TASK" && "$invariant_attempt" == "$V2_ATTEMPT" &&
     "$scope" == "$V2_SCOPE_FILE" && -f "$scope" && ! -L "$scope" &&
     "$(stat -c '%a:%h' "$scope" 2>/dev/null)" == 600:1 &&
     "$V2_SCOPE_EXPECTED_HASH" =~ ^[a-f0-9]{64}$ ]] || return 75
  hash=$(sha256sum -- "$scope" | awk '{print $1}') || return 75
  [[ "$hash" == "$V2_SCOPE_EXPECTED_HASH" ]]
}

v2_decision() {
  local key=$1 value
  value=$(get "$TASK" "$key")
  case "$value" in
    approved|rejected) printf '%s\n' "$value" ;;
    *) printf 'pending\n' ;;
  esac
}

v2_review_decision() {
  local value
  value=$(get "$TASK" REVIEW)
  case "$value" in
    done) printf 'approved\n' ;;
    failed) printf 'rejected\n' ;;
    *) printf 'pending\n' ;;
  esac
}

route_v2_context_for_node() {
  local context_task=$1 context_attempt=$2 context_node=$3
  local context_run_key=$4 context_output=$5 cursor event_count=0
  local transaction_id="" instrumentation_phase=not-started scope_arg=""
  local cause review acceptance allowed action target
  local ledger_results ledger_line
  local -a args=()

  cursor=$(attempt_stage_state_read_v2 "$context_task" "$context_attempt" 2>/dev/null || true)
  if [[ -n "$cursor" ]]; then
    event_count=$(json_value eventSequence <<<"$cursor" 2>/dev/null || printf '0')
  fi
  [[ "$event_count" =~ ^[0-9]+$ ]] || return 78
  ledger_results=$(v2_ledger_stage_results "$context_task" "$context_attempt") || return 78

  if [[ "$context_node" == instrument || "$context_node" == trace ]]; then
    v2_prepare_scope || return
    transaction_id="v2-${context_attempt#*_}-s${event_count}"
    instrumentation_phase=active
  elif [[ -f "$V2_SCOPE_FILE" && ! -L "$V2_SCOPE_FILE" ]]; then
    V2_SCOPE_EXPECTED_HASH=$(sha256sum -- "$V2_SCOPE_FILE" | awk '{print $1}') ||
      return 1
    transaction_id=$(_route_v2_transaction_active_id "$context_task" 2>/dev/null || true)
    case "$context_node" in
      diagnose|hyposkeptic|proof)
        [[ -n "$transaction_id" ]] && instrumentation_phase=active
        ;;
      *)
        instrumentation_phase=cleaned
        ;;
    esac
  fi
  [[ -n "$transaction_id" ]] || transaction_id=not-open

  cause=$(v2_decision CAUSE_DECISION)
  review=$(v2_review_decision)
  acceptance=$(v2_decision ACCEPTANCE_DECISION)
  args=(
    "$FACTORY_HOME/bin/factory-context-v2"
    --task "$context_task"
    --profile "$PROFILE"
    --attempt "$context_attempt"
    --catalog-hash "$ROUTE_V2_CATALOG"
    --route "$ROUTE_V2_ROUTE"
    --route-hash "$ROUTE_V2_ROUTE_HASH"
    --node "$context_node"
    --run-key "$context_run_key"
    --ticket-json "$V2_TRUSTED_TICKET"
    --repo "backend:$V2_BE_WORKTREE:$V2_BE_SOURCE"
    --repo "frontend:$V2_FE_WORKTREE:$V2_FE_SOURCE"
    --state-dir "$STATE_DIR"
    --sandbox-generation v2
    --container-name "$V2_CONTAINER"
    --frontend-port "$V2_FE_PORT"
    --api-port "$V2_API_PORT"
    --transaction-id "$transaction_id"
    --instrumentation-phase "$instrumentation_phase"
    --event-count "$event_count"
    --cause-decision "$cause"
    --cause-comment "$(get "$TASK" CAUSE_DECISION_COMMENT)"
    --review-decision "$review"
    --review-comment "$(get "$TASK" REVIEW_COMMENT)"
    --acceptance-decision "$acceptance"
    --acceptance-comment "$(get "$TASK" ACCEPTANCE_DECISION_COMMENT)"
    --delivery-mode publish
    --source-branch "$V2_SOURCE_BRANCH"
    --diagnosis-kind "${DIAGNOSIS_KIND:-functional}"
    --diagnosis-signal "${DIAGNOSIS_SIGNAL:-unspecified}"
  )
  # Инструментация обязательна, когда контракт scope попытки непустой
  # (debug start с --instrumentation-file); признак переживает resume вместе
  # с immutable-артефактом scope.
  [[ ! -s "$V2_SCOPE_SPEC" ]] || args+=(--instrumentation-required)
  while IFS= read -r ledger_line; do
    [[ -n "$ledger_line" ]] && args+=(--stage-result "$ledger_line")
  done <<<"$ledger_results"
  if [[ -f "$V2_SCOPE_FILE" && ! -L "$V2_SCOPE_FILE" ]]; then
    args+=(--scope-file "$V2_SCOPE_FILE")
    while IFS= read -r allowed || [[ -n "$allowed" ]]; do
      [[ -n "$allowed" ]] && args+=(--allowed-file "$allowed")
    done <"$V2_SCOPE_FILE"
  fi
  for action in commit push pull-request; do
    args+=(--delivery-action "$action")
  done
  (( TASK_COMMENT == 0 )) || args+=(--delivery-action task-comment)
  for target in "${DELIVERY_TARGETS[@]}"; do
    args+=(--delivery-target "$target")
  done
  "${args[@]}" >"$context_output"
}

# Скелет этапных ключей реестра — из runKeys закреплённого бандла (bootstrap
# SCOUT + main + tail + status-узлы), а не из v1-списка: в реестре не должно
# быть узлов, которых нет в маршруте.
v2_registry_stage_keys() {
  # Каталог приходит параметром: на start он только что выбран (CURRENT_CATALOG),
  # на recovery берётся ЗАКРЕПЛЁННЫЙ пин новой попытки. Реестр обязан описывать
  # маршрут, по которому пойдёт диспетчер, а не тот, что опубликован прямо сейчас.
  local catalog=${1:-$CURRENT_CATALOG}
  "$FACTORY_HOME/bin/factory-route-v2" \
    --routes-dir "$ROUTES_DIR" --profile "$PROFILE" describe-route \
    --catalog-hash "$catalog" --route "$ROUTE" | python3 -c '
import json
import sys

machine = json.load(sys.stdin)["machine"]
keys = ["SCOUT"]
by_id = {n["id"]: n for n in machine["nodes"] if isinstance(n, dict)}
for phase in ("main", "tail"):
    for node_id in machine["sequence"][phase]:
        node = by_id.get(node_id) or {}
        key = node.get("key") if node.get("executor") == "status" else node.get("runKey")
        if isinstance(key, str) and key and key not in keys:
            keys.append(key)
print(" ".join(keys))
'
}

v2_gate_state_key() {
  case "$1" in
    gate_plan) printf 'PLAN_DECISION\n' ;;
    gate_cause) printf 'CAUSE_DECISION\n' ;;
    gate_accept) printf 'ACCEPTANCE_DECISION\n' ;;
    *) return 2 ;;
  esac
}

v2_gate_pipeline_key() {
  case "$1" in
    gate_plan) printf 'GATE_PLAN\n' ;;
    gate_cause) printf 'GATE_CAUSE\n' ;;
    gate_accept) printf 'GATE_ACCEPT\n' ;;
    *) return 2 ;;
  esac
}

# Фиксация решения ворот: CAS в журнале попытки плюс проекция в реестр, по
# которой кокпит рисует ворота. Продолжение маршрута сюда не входит намеренно —
# см. --commit-only в справке.
v2_gate_commit() {
  local attempt=$1 gate_key pipeline_gate_key rc
  gate_key=$(v2_gate_state_key "$GATE_NODE") ||
    die "неизвестный gate node для профиля: $GATE_NODE"
  pipeline_gate_key=$(v2_gate_pipeline_key "$GATE_NODE") ||
    die "нет UI-проекции для gate node: $GATE_NODE"
  route_v2_gate_decide \
    "$TASK" "$attempt" "$GATE_NODE" "$GATE_DECISION" >/dev/null || {
    rc=$?
    v2_log "gate CAS не принят (код $rc)"
    return "$rc"
  }
  set_st "$TASK" "$gate_key" "$GATE_DECISION" \
    "${gate_key}_COMMENT" "${GATE_COMMENT//$'\n'/ }" \
    "$pipeline_gate_key" "$GATE_DECISION" \
    "${pipeline_gate_key}_COMMENT" "${GATE_COMMENT//$'\n'/ }"
  v2_log "gate $GATE_NODE=$GATE_DECISION зафиксирован"
}

v2_on_signal() {
  local signal=$1 rc=130 stop_rc cleanup_rc
  [[ "$signal" == TERM ]] && rc=143
  trap - TERM INT
  v2_log "получен $signal; останавливаю exact active runner"
  runtime_interrupt_trusted_active "$TASK" "" "" "" \
    "${FACTORY_TERM_GRACE_SECONDS:-5}"
  stop_rc=$?
  if (( stop_rc == 0 )) && [[ -n "$V2_ATTEMPT" ]]; then
    route_v2_cleanup_active_instrumentation "$TASK" "$V2_ATTEMPT"
    cleanup_rc=$?
    (( cleanup_rc == 0 || cleanup_rc == 3 )) || {
      set_st "$TASK" STALLED_HUMAN 1
      v2_log "instrumentation cleanup требует человека (код $cleanup_rc)"
    }
  else
    set_st "$TASK" STALLED_HUMAN 1
    v2_log "quiescence runner не доказана; baseline не изменён (код $stop_rc)"
  fi
  exit "$rc"
}

v2_on_exit() {
  local rc=$?
  trap - EXIT TERM INT
  if [[ "$(get "$TASK" ORCH_PID)" == "$$" ]]; then
    set_st "$TASK" ORCH_PID ""
  fi
  exit "$rc"
}

v2_main() {
  local attempt route_hash rc pinned_profile pinned_route pinned_routes
  local gate_key pipeline_gate_key gate_node cursor stop
  mkdir -p "$STATE_DIR/logs" "$STATE_DIR/archive"
  v2_lock || die "оркестратор t${TASK} уже работает или lock небезопасен"
  trap 'v2_on_signal TERM' TERM
  trap 'v2_on_signal INT' INT
  trap v2_on_exit EXIT

  if [[ "$MODE" == start ]]; then
    [[ ! -e "$LEGACY_STATE/t${TASK}.pipeline" &&
       ! -L "$LEGACY_STATE/t${TASK}.pipeline" &&
       ! -e "$LEGACY_STATE/t${TASK}.env" &&
       ! -L "$LEGACY_STATE/t${TASK}.env" ]] ||
      die "t${TASK} ещё занята legacy-конвейером или песочницей"
    [[ ! -e "$STATE_DIR/t${TASK}.pipeline" &&
       ! -L "$STATE_DIR/t${TASK}.pipeline" ]] ||
      die "v2 pipeline t${TASK} уже существует"
  fi

  profile_runner_host_preflight "$PROFILE" || {
    rc=$?
    v2_log "runner preflight не пройден (код $rc)"
    return "$rc"
  }

  if [[ "$MODE" == start ]]; then
    set_st "$TASK" --init --stages "$(v2_registry_stage_keys)" \
      PROFILE "$PROFILE" RUN_PROTOCOL 2 \
      ROUTE "$ROUTE" ROUTE_BY human DELIVERY_MODE publish \
      ORCH_PID "$$" STALLED_HUMAN 0 SANDBOX_GENERATION v2 \
      PLAN_DECISION pending CAUSE_DECISION pending ACCEPTANCE_DECISION pending
    attempt=$(attempt_state_begin_v2 "$TASK" "$PROFILE" "$ROUTES_DIR") || {
      rc=$?
      v2_log "attempt не создан (код $rc)"
      return "$rc"
    }
    V2_ATTEMPT=$attempt
    route_hash=$(attempt_state_select_route_v2 "$TASK" "$attempt" "$ROUTE") || {
      rc=$?
      v2_log "route pin не создан (код $rc)"
      return "$rc"
    }
  else
    attempt=$EXPECTED_ATTEMPT
    V2_ATTEMPT=$attempt
    _route_v2_load_attempt "$TASK" "$attempt" || {
      rc=$?
      v2_log "active attempt/pins не прошли exact resume (код $rc)"
      return "$rc"
    }
    pinned_profile=$ROUTE_V2_PROFILE
    pinned_route=$ROUTE_V2_ROUTE
    pinned_routes=$ROUTE_V2_ROUTES_DIR
    [[ "$pinned_profile" == "$PROFILE" && "$pinned_routes" == "$ROUTES_DIR" ]] ||
      die "resume-параметры расходятся с immutable pins"
    [[ -z "$ROUTE" || "$ROUTE" == "$pinned_route" ]] ||
      die "--route расходится с immutable pin"
    ROUTE=$pinned_route
    route_hash=$ROUTE_V2_ROUTE_HASH
    set_st "$TASK" ORCH_PID "$$" STALLED_HUMAN 0
  fi

  set_st "$TASK" ATTEMPT_ID "$attempt" CATALOG_PROTOCOL route-v2 \
    ROUTE "$ROUTE" ROUTE_HASH "$route_hash"

  # Решению ворот не нужны ни стенд, ни bootstrap, ни восстановление
  # инструментации: это запись в журнал попытки. --commit-only фиксирует её и
  # выходит, поэтому синхронный вызов остаётся коротким и предсказуемым; весь
  # прогон дальше по маршруту поднимает отдельный resume.
  if [[ "$MODE" == gate && "$GATE_COMMIT_ONLY" == 1 ]]; then
    v2_gate_commit "$attempt" || return
    return 0
  fi

  v2_install_ticket || {
    rc=$?
    v2_log "immutable ticket не установлен (код $rc)"
    return "$rc"
  }
  v2_install_diagnosis || {
    rc=$?
    v2_log "immutable diagnosis не установлен (код $rc)"
    return "$rc"
  }
  v2_install_scope_spec || {
    rc=$?
    v2_log "instrumentation scope contract не установлен (код $rc)"
    return "$rc"
  }
  v2_install_delivery_spec || {
    rc=$?
    v2_log "delivery contract не установлен (код $rc)"
    return "$rc"
  }

  v2_sandbox_up || {
    rc=$?
    set_st "$TASK" STALLED_HUMAN 1
    v2_log "свежая v2-песочница не готова (код $rc)"
    return "$rc"
  }
  export PROFILE_AGENT_CWD="$V2_BE_WORKTREE"
  export PROFILE_AGENT_DIRS="$V2_BE_WORKTREE $V2_FE_WORKTREE"
  export ROUTE_V2_INSTRUMENTATION_SCOPE_FILE="$V2_SCOPE_FILE"

  _route_v2_load_attempt "$TASK" "$attempt" || return
  route_v2_dispatch_bootstrap "$TASK" "$attempt" >/dev/null || {
    rc=$?
    set_st "$TASK" STALLED_HUMAN 1
    v2_log "bootstrap не подтверждён (код $rc)"
    return "$rc"
  }
  attempt_stage_state_init_v2 "$TASK" "$attempt" "$ROUTE" >/dev/null || {
    rc=$?
    v2_log "route cursor не инициализирован (код $rc)"
    return "$rc"
  }
  if [[ "$MODE" != start ]]; then
    route_v2_recover_instrumentation "$TASK" "$attempt" || {
      rc=$?
      v2_log "instrumentation recovery не завершён (код $rc)"
      return "$rc"
    }
  fi
  if [[ "$MODE" == gate ]]; then
    v2_gate_commit "$attempt" || return
  fi

  route_v2_dispatch_until_pause "$TASK" "$attempt" 64
  rc=$?
  case "$rc" in
    20)
      cursor=$(attempt_stage_state_read_v2 "$TASK" "$attempt") || return
      gate_node=$(json_value currentNode <<<"$cursor") || return 78
      pipeline_gate_key=$(v2_gate_pipeline_key "$gate_node") || {
        set_st "$TASK" STALLED_HUMAN 1
        v2_log "human gate $gate_node не имеет UI-проекции"
        return 78
      }
      set_st "$TASK" "$pipeline_gate_key" waiting STALLED_HUMAN 1
      v2_log "пауза на human gate $gate_node"
      return 0
      ;;
    21)
      cursor=$(attempt_stage_state_read_v2 "$TASK" "$attempt") || return
      stop=$(json_value stop <<<"$cursor") || return 78
      if [[ "$stop" == done ]]; then
        attempt_state_finish_v2 "$TASK" "$attempt" >/dev/null || return
        set_st "$TASK" STALLED_HUMAN 0 V2_RESULT completed
        v2_log "маршрут завершён; SHIP и RETRO подтверждены"
        return 0
      fi
      set_st "$TASK" STALLED_HUMAN 1 V2_RESULT "stopped-$stop"
      v2_log "маршрут остановлен: $stop"
      return 0
      ;;
    0)
      return 0
      ;;
    *)
      set_st "$TASK" STALLED_HUMAN 1
      v2_log "dispatcher остановлен fail-closed (код $rc)"
      return "$rc"
      ;;
  esac
}

# Выходы этапов предшественницы уносим с диска (см. attempt-state.sh): иначе новая
# попытка принимает их за свои. Список унесённого — в журнал, чтобы человек знал,
# где искать, если понадобится сравнить с прошлым заходом.
v2_quarantine_state_artifacts() {
  local from_attempt=$1 moved base rc
  # Именно подстановка, а не пайп: у process substitution код возврата не забрать,
  # а молча пройти мимо неубранного артефакта — ровно та ошибка, от которой чиним.
  moved=$(attempt_state_quarantine_artifacts_v2 "$TASK" "$from_attempt" "$STATE_DIR")
  rc=$?
  if (( rc != 0 )); then
    v2_log "recovery: артефакты предшественницы не убраны (код $rc)"
    return "$rc"
  fi
  while IFS= read -r base || [[ -n "$base" ]]; do
    [[ -n "$base" ]] || continue
    v2_log "recovery: артефакт $base убран в архив попытки $from_attempt"
  done <<<"$moved"
  return 0
}

# Административные операции над attempt state: без песочницы, каталога маршрутов
# и диспетчеризации. Lock оркестратора берём тот же, что у start/resume, — abandon
# под живым foreground-прогоном обязан получить отказ, а не резать попытку под ним.
v2_admin_main() {
  local rc out
  mkdir -p "$STATE_DIR/logs"
  v2_lock || die "оркестратор t${TASK} уже работает или lock небезопасен"
  if [[ "$MODE" == goto ]]; then
    # Возврат курсора работает по ЗАКРЕПЛЁННОМУ маршруту попытки, поэтому pins
    # загружаем так же, как перед диспетчеризацией.
    _route_v2_load_attempt "$TASK" "$EXPECTED_ATTEMPT" || return
  fi
  if [[ "$MODE" == abandon ]]; then
    attempt_state_abandon_v2 "$TASK" "$EXPECTED_ATTEMPT" "$REASON" || {
      rc=$?
      v2_log "abandon $EXPECTED_ATTEMPT не принят (код $rc)"
      return "$rc"
    }
    # Pipeline-проекция для кокпита — только если реестр v2 уже существует:
    # abandon законен и для попытки, упавшей до первой записи реестра.
    [[ ! -f "$STATE_DIR/t${TASK}.pipeline" ]] ||
      set_st "$TASK" STALLED_HUMAN 1 V2_RESULT abandoned
    v2_log "attempt $EXPECTED_ATTEMPT закрыт терминалом abandoned: $REASON"
    printf 'abandoned %s\n' "$EXPECTED_ATTEMPT"
    return 0
  fi
  local route_hash old_artifacts new_artifacts name new_catalog
  if [[ "$MODE" == goto ]]; then
    local reset
    # Сбрасываем целевой узел и всё, что идёт после него по последовательности
    # маршрута: возврат назад обязан снять результаты пройденного хвоста.
    reset=$("$FACTORY_HOME/bin/factory-route-v2" \
      --routes-dir "$ROUTES_DIR" --profile "$PROFILE" describe-route \
      --catalog-hash "$ROUTE_V2_CATALOG" --route "$ROUTE_V2_ROUTE" |
      python3 -c '
import json
import sys

machine = json.load(sys.stdin)["machine"]
target = sys.argv[1]
chain = list(machine["sequence"]["main"]) + list(machine["sequence"]["tail"])
if target not in chain:
    raise SystemExit(2)
print(",".join(chain[chain.index(target):]))
' "$GATE_NODE") || {
      v2_log "goto: узел $GATE_NODE отсутствует в маршруте"
      return 2
    }
    attempt_stage_state_human_rewind_v2 \
      "$TASK" "$EXPECTED_ATTEMPT" "$GATE_NODE" "$reset" "$REASON" || {
      rc=$?
      v2_log "goto $GATE_NODE не принят (код $rc)"
      return "$rc"
    }
    [[ ! -f "$STATE_DIR/t${TASK}.pipeline" ]] ||
      set_st "$TASK" STALLED_HUMAN 0 V2_RESULT human-rewind
    v2_log "курсор возвращён человеком на узел $GATE_NODE: $REASON"
    printf 'rewound %s\n' "$GATE_NODE"
    return 0
  fi
  out=$(attempt_state_recover_v2 "$TASK" "$EXPECTED_ATTEMPT" "$REASON") || {
    rc=$?
    v2_log "recover из $EXPECTED_ATTEMPT не принят (код $rc)"
    return "$rc"
  }
  route_hash=$(attempt_state_select_route_v2 "$TASK" "$out" "$ROUTE") || {
    rc=$?
    v2_log "route pin для recovery $out не создан (код $rc)"
    return "$rc"
  }
  # Recovery наследует ВХОДНЫЕ immutable-контракты предшественницы (ticket,
  # delivery, scope, diagnosis) — иначе попытка тупиковая: resume только
  # проверяет артефакты и создавать их не имеет права. Результаты работы
  # (bootstrap.json) намеренно не переносятся: recovery = чистый bootstrap.
  # Найдено живым прогоном t8165.
  old_artifacts="$(attempt_state_v2_task_root "$TASK")/attempts/$EXPECTED_ATTEMPT/artifacts"
  V2_ATTEMPT=$out
  new_artifacts=$(v2_attempt_artifacts) || return 78
  [[ -d "$new_artifacts" && ! -L "$new_artifacts" ]] || return 78
  for name in ticket.json delivery.tsv instrumentation-scope.tsv diagnosis.env; do
    [[ -f "$old_artifacts/$name" && ! -L "$old_artifacts/$name" ]] || continue
    v2_copy_once "$old_artifacts/$name" "$new_artifacts/$name" 400 || {
      rc=$?
      v2_log "recovery: артефакт $name не перенесён (код $rc)"
      return "$rc"
    }
  done
  v2_quarantine_state_artifacts "$EXPECTED_ATTEMPT" || return
  # Реестр — проекция для кокпита, но его читают и агенты: на живом прогоне t8165
  # PLAN увидел в нём TESTS=done/TCRITIC=done от отменённой попытки и полез искать
  # несуществующие тесты. Новая попытка обязана начинать с pending по всем узлам
  # своего маршрута, иначе «чистый bootstrap» врёт и человеку, и агентам.
  if [[ -f "$STATE_DIR/t${TASK}.pipeline" ]]; then
    new_catalog=$(_attempt_state_json get \
      "$(attempt_state_v2_task_root "$TASK")/attempts/$out/attempt.json" catalogHash) ||
      return 78
    set_st "$TASK" --init --stages "$(v2_registry_stage_keys "$new_catalog")" \
      STALLED_HUMAN 0 V2_RESULT recovered ATTEMPT_ID "$out" \
      ROUTE "$ROUTE" ROUTE_HASH "$route_hash" ORCH_PID "" \
      PLAN_DECISION pending CAUSE_DECISION pending ACCEPTANCE_DECISION pending
  fi
  v2_log "recovery attempt $out создан из $EXPECTED_ATTEMPT: $REASON"
  printf '%s\n' "$out"
}

if [[ "$MODE" == abandon || "$MODE" == recover || "$MODE" == goto ]]; then
  v2_admin_main
else
  v2_main
fi
