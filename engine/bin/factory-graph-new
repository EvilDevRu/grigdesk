#!/usr/bin/env python3
"""Заготовка схемы конвейера профиля: profiles/<имя>/graph.json из его же маршрутов.

Зачем отдельная команда, а не «нарисуй руками»: схема нужна КОКПИТУ (:8140) — он читает
profiles/*/graph.json без запасного варианта и строит по нему список профилей. Профиль без
схемы в кокпите просто не виден: запрос графа падает, карточка задачи молча отфильтровывается.
Старый дашборд (lib/dashboard.py) умел автосхему, и на это расхождение легко напороться.

Запуск:
    bin/factory-graph-new <профиль> [--force]

Узлы раскладываются змейкой (строка слева направо, следующая справа налево — так рёбра между
строками короткие), рёбра — последовательная цепочка этапов маршрута. Это ЗАГОТОВКА: петли
возврата («ревью → сборка»), подписи рёбер и координаты человек доводит руками, схема ради
того и лежит в профиле, что рисуется под проект.

Что важно заполнить осмысленно — `optional`: этапы, чей пропуск НЕ аномалия. Движок это поле
не читает (он принимает skipped от любого этапа), по нему кокпит решает, красить пропуск
серым «пропущен осознанно» или красным «аномалия». Пустой список = любой пропуск красный.
"""
import json
import os
import re
import subprocess
import sys

HOME = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PROFILES = os.environ.get(
    'FACTORY_PROFILES_DIR',
    os.path.join(os.path.dirname(HOME), 'profiles'),
)

# Раскладка: шаг между узлами, длина строки, отступы. Подобрано под ширину узлов дашборда.
STEP_X, STEP_Y, ROW_LEN = 340, 140, 5
START_X, START_Y = 150, 50


def routes_of(profile):
    """Этапы маршрутов профиля: {маршрут: [ЭТАП, ...]}. Источник истины — сам профиль."""
    out = subprocess.run(
        ['bash', '-c',
         f'source {PROFILES}/{profile}/profile.sh 2>/dev/null\n'
         'for v in $(compgen -A variable | grep "^PROFILE_ROUTE_STAGES_"); do\n'
         '  n="$v[@]"; echo "${v#PROFILE_ROUTE_STAGES_} ${!n}"\n'
         'done'],
        capture_output=True, text=True).stdout
    routes = {}
    for line in out.split('\n'):
        parts = line.split()
        if len(parts) > 1:
            routes[parts[0]] = parts[1:]
    return routes


def layout(stages):
    """Змейка: позиции узлов, рёбра-цепочка и описания узлов."""
    pos, edges, nodes = {}, [], {}
    ids = [s.lower() for s in stages]
    for i, nid in enumerate(ids):
        row, col = divmod(i, ROW_LEN)
        # Нечётная строка идёт в обратную сторону — переход между строками получается
        # коротким вертикальным ребром, а не диагональю через всё полотно.
        col = col if row % 2 == 0 else ROW_LEN - 1 - col
        pos[nid] = [START_X + col * STEP_X, START_Y + row * STEP_Y]
        # Ворота обязаны быть human: движок ждёт на них решения человека, и на схеме это
        # другой тип узла. Подпись даём машинную — человек переименует по-своему.
        kind = 'human' if nid.startswith('gate_') else 'agent'
        nodes[nid] = [kind, nid.replace('_', ' ').capitalize(), '']
    edges.append(['_start', ids[0], '', 'plain', 'h'])
    for a, b in zip(ids, ids[1:]):
        same_row = pos[a][1] == pos[b][1]
        edges.append([a, b, '', 'plain', 'h' if same_row else 'v'])
    return pos, edges, nodes


def main():
    args = [a for a in sys.argv[1:] if not a.startswith('--')]
    force = '--force' in sys.argv[1:]
    if len(args) != 1:
        print('использование: factory-graph-new <профиль> [--force]')
        return 1
    profile = args[0]
    profile_file = f'{PROFILES}/{profile}/profile.sh'
    if not os.path.exists(profile_file):
        print(f'✗ нет профиля {profile}: {profile_file}')
        return 1
    target = f'{PROFILES}/{profile}/graph.json'
    if os.path.exists(target) and not force:
        print(f'✗ схема уже есть: {target}\n  перезаписать — с флагом --force (правки руками пропадут)')
        return 1

    routes = routes_of(profile)
    if not routes:
        print(f'✗ у профиля {profile} не прочитались PROFILE_ROUTE_STAGES_* — заполни маршруты и повтори')
        return 1

    doc = {
        '_comment': (
            f'Схема конвейера проекта {profile}: nodes/keys/optional + по разделу на маршрут. '
            'ЗАГОТОВКА от factory-graph-new — цепочка этапов без петель возврата. '
            'ЗАПОЛНИ: подписи узлов по-человечески, координаты pos под свою схему, петли возврата '
            '(ребро с классом fail), optional. nodes: [вид, подпись, сноска], вид = agent|code|human. '
            'keys: узел → ключ реестра (по умолчанию UPPER(id)). '
            'optional: этапы, чей skipped НЕ аномалия — движок это поле не читает, по нему кокпит '
            'решает, красить пропуск серым «осознанно» или красным «аномалия»; пусто = любой пропуск '
            'красный, и это верное умолчание. Узлы обязаны совпадать с PROFILE_ROUTE_STAGES_* '
            'профиля (сверка — tests/engine/routes-sync.py).'
        ),
        'default_route': sorted(routes)[0],
        'nodes': {},
        'keys': {},
        'optional': {'*': []},
        'routes': {},
    }
    for route, stages in sorted(routes.items()):
        pos, edges, nodes = layout(stages)
        doc['nodes'].update(nodes)
        width = max(p[0] for p in pos.values()) + 260
        height = max(p[1] for p in pos.values()) + 120
        doc['routes'][route] = {'vb': f'0 -34 {width} {height}', 'pos': pos, 'edges': edges}

    # Схему дальше правит человек, поэтому короткие массивы схлопываем в строку: с отступами
    # json пишет пару координат [x, y] на три строки, и файл перестаёт читаться глазами.
    # Массивы, внутри которых есть вложенные (routes.edges), regex не трогает — они остаются
    # многострочными, по ребру на строку.
    txt = json.dumps(doc, ensure_ascii=False, indent=2)
    txt = re.sub(r'\[\s+((?:[^][{}]|"[^"]*")*?)\s+\]',
                 lambda m: '[' + ' '.join(m.group(1).split()) + ']', txt)
    with open(target, 'w', encoding='utf-8') as f:
        f.write(txt + '\n')
    print(f'✓ схема: {target}')
    for route, stages in sorted(routes.items()):
        print(f'  {route}: {len(stages)} узлов ({" → ".join(s.lower() for s in stages)})')
    print('  дальше: подписи и петли возврата — руками, «optional» — перечислить штатные пропуски')
    return 0


if __name__ == '__main__':
    sys.exit(main())
